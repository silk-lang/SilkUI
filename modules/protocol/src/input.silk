//! Input for the tree: plain-data pointer, wheel and key records a host feeds to
//! `UiTree.dispatch`, from a window, a test script or an inspector alike.
//!
//! Positions and wheel deltas are CSS pixels in the viewport. Keys use the names of UI Events:
//! `key` is what the key means on the layout (`"a"`, `"A"`, `"Enter"`, `"ArrowLeft"`, `"Tab"`),
//! `code` the physical key (`"KeyA"`, `"Enter"`). The ui-tree-window package turns
//! modules/platform/window events into these.
import silk.text.string { String }

/// Modifier bits in [`Input`] and event records, as modules/platform/window packs them.
pub const MOD_SHIFT: u32 = 1

pub const MOD_CONTROL: u32 = 2

pub const MOD_ALT: u32 = 4

/// Command on macOS, the Windows key elsewhere.
pub const MOD_META: u32 = 8

/// Pointer buttons, numbered as DOM `MouseEvent.button`.
pub const BUTTON_PRIMARY: u32 = 0

pub const BUTTON_AUXILIARY: u32 = 1

pub const BUTTON_SECONDARY: u32 = 2

pub const BUTTON_BACK: u32 = 3

pub const BUTTON_FORWARD: u32 = 4

/// Pointer types of event records, as DOM `PointerEvent.pointerType` names them.
pub const POINTER_MOUSE: u32 = 0

pub const POINTER_PEN: u32 = 1

pub const POINTER_TOUCH: u32 = 2

/// The `pointerId` of the mouse, as Chromium numbers it. Touches count up from 2.
pub const MOUSE_POINTER_ID: u32 = 1

/// One input record.
pub union Input {
  /// The pointer moved to (`x`, `y`).
  PointerMove { pub x: f32, pub y: f32, pub modifiers: u32 },
  /// A button went down. `clickCount` is 1 for a single click, 2 for a double click.
  PointerDown { pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32, pub clickCount: u32 },
  PointerUp { pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32 },
  /// The pointer left the window: nothing is hovered any more.
  PointerLeave,
  /// The press ended without a release the tree should act on (the window lost focus, a
  /// system gesture took over): active states and pointer capture end, and no click follows.
  PointerCancel,
  /// A finger touched the screen at (`x`, `y`). `id` is the host's number for the touch,
  /// unique while it is down; `time` is the host's clock in seconds, the one it passes to
  /// frames, for the speed of a flick. The tree turns touches into pointer records of type touch and,
  /// as `touch-action` allows, pans the scroll containers under them itself.
  TouchStart { pub id: u32, pub x: f32, pub y: f32, pub modifiers: u32, pub time: f64 },
  TouchMove { pub id: u32, pub x: f32, pub y: f32, pub modifiers: u32, pub time: f64 },
  TouchEnd { pub id: u32, pub x: f32, pub y: f32, pub modifiers: u32, pub time: f64 },
  /// The system took touch `id` (an edge swipe, the window lost focus): its pointer is
  /// cancelled and no click follows.
  TouchCancel { pub id: u32 },
  /// A trackpad pinch at (`x`, `y`): `delta` is the change of the magnification, 0.1 for 10%
  /// larger. Clients hear it as browsers report it, a `Wheel` record with control held.
  Pinch { pub x: f32, pub y: f32, pub delta: f32, pub modifiers: u32 },
  /// A wheel or trackpad scroll at (`x`, `y`). Positive `deltaY` scrolls down (shows what is
  /// below), as DOM `WheelEvent.deltaY`.
  Wheel { pub x: f32, pub y: f32, pub deltaX: f32, pub deltaY: f32, pub modifiers: u32 },
  KeyDown { pub key: String, pub code: String, pub modifiers: u32, pub repeat: bool },
  KeyUp { pub key: String, pub code: String, pub modifiers: u32 },
  /// Text typed or committed by the input method, for the focused input: it replaces the
  /// selection (or the composition). Hosts send it apart from the key that typed it, as
  /// modules/platform/window's `TextInput` does.
  TextInput { pub text: String },
  /// The input method's composition (preedit) text, drawn underlined at the caret of the
  /// focused input until it is committed with `TextInput`. `selectionStart` and
  /// `selectionEnd` are UTF-8 byte offsets into `text` (the caret when equal). Empty text ends
  /// the composition without committing it.
  ImePreedit { pub text: String, pub selectionStart: usize, pub selectionEnd: usize },
  /// The clipboard text a host read to answer a `HostRequest.ReadClipboard`: it is pasted
  /// into that input if it still has focus.
  Paste { pub target: u32, pub text: String },
}
