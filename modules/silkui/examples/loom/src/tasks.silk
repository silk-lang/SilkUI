//! The app and its tasks: `silk task dev` opens it in a window and restarts it when a file in
//! src/ changes (`--target web-canvas` or `web-dom` serves it as a page that reloads instead);
//! `silk task build` writes the release program to dist/window/ and the pages to
//! dist/web-canvas/ and dist/web-dom/.
import silkui.app { App, Framework, Target, Window, Page, Built, Running }
import silk.build.graph { Options, BuildError }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

effect fn app() -> App
  ! OutOfMemoryError
  ? &mut Allocator {
  return run App.make("loom-counter")
    |> App.framework(Framework.loom("app"))
    |> App.target(Target.window(Window { title: "Counter", width: 420.0, height: 200.0 }))
    |> App.target(Target.webCanvas(Page { title: "Counter" }))
    |> App.target(Target.webDom(Page { title: "Counter" }))
}

union Tasks {
  Dev { pub platform: String, pub options: Options },
  Build { pub platform: String, pub options: Options },
  Plan { pub platform: String, pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the app")
      |> Command.variant("Dev", "Open the app with the development tools, rebuilding on change")
      |> Command.variant("Build", "Write the release programs to dist/<target>/")
      |> Command.flatten("options")
      |> Command.variant("Plan", "Write the editor compilation requests")
      |> Command.option("platform", Opt.about("Only this target (window, web-canvas, web-dom)"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Dev { platform, options } => run app()
        |> App.only(String.view(&platform))
        |> App.build(&options)
        |> Built.launch()
        |> Running.watch()
      Tasks.Build { platform, options } => run app()
        |> App.only(String.view(&platform))
        |> App.build(&options)
        |> Built.tap(Built.sizes)
        |> Built.write("dist")
      Tasks.Plan { platform, options } => {
        let configured = run app() |> App.only(platform.view())
        let graph = run configured.compilations(&options)
        drop run graph.write()
      }
    }
  }
}

pub const COMMANDS: string = Task.commands<Tasks>()

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
