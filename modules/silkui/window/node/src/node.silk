//! A JavaScript app in a window on the full SilkJS runtime (`Runtime.node()`): Node's APIs and
//! the web APIs Node has, with `@silkui/core` beside them. What the hosts silkui generates for
//! such an app run. There is no hot reload on the runtime yet: the development host runs the
//! bundle at the path its command line gives, once.
import ui_js.lib { uiPackage, StylesheetCompiler, runtimeStylesheets }
import ui_js_node.lib { NodeWindow, NodeClient }
import ui_js_node.lib { UiApi }
import node_runtime.libs.core.capabilities { Capabilities, OsProcesses, OsNetwork, OsSystemInfo, ThreadWorkers }
import node_runtime.libs.core.module_sources { NodeResolution }
import node_runtime.libs.core.platforms { OsPlatform }
import node_runtime.libs.core.files { OsFiles }
import wasm.wamr { WamrWasm }
import compress.compress { NativeCompression }
import http2.nghttp2 { Nghttp2 }
import http.llhttp { Llhttp }
import database.sqlite_database { SqliteDatabase }
import openssl.openssl_capabilities { OpenSslCrypto, OpenSslTls }
import inspector.node_inspector { NodeInspector }
import amaro.amaro_stripping { Amaro }
import addons.dlopen_addons { DlopenAddons }
import ui_tree.legacy { TreeError }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.style_watch { SheetWatch }
import silk.system.filesystem { FileError }
import ui_tree_window.host { RunOptions, StartedGpu, startGpu }
import ui_tree_window.platform_thread { Launched, launch }
import ui_tree_window.console { StderrWriter }
pub import silkui_window.js { Settings, TitleBar, Natives, showMetalHud }
import silkui_window.js { failed, systemFonts }
import silkjs.js_atomics_native { SynchronizationError }
import silkjs.js_libc_platform as platform
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput }

effect fn program(settings: Settings, entry: &[u8], source: &[u8], launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: StylesheetCompiler) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError | SynchronizationError | platform.PlatformError
  ? &mut Allocator {
  let gpu = run startGpu(false)
  let fonts = run systemFonts()
  let options = RunOptions {
    title: settings.title,
    width: settings.width,
    height: settings.height,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: move launched,
    gpu: Option<StartedGpu>.some(move gpu),
  }
  let mut client = NodeClient.make()
  client.titleBar = settings.titleBar
  client.titleBarHeight = settings.titleBarHeight
  client.controlsLeft = settings.controlsLeft
  client.controlsTop = settings.controlsTop
  client.stylesheetCompiler = compiler
  client.natives = settings.natives
  client.stylesheets = move sheets
  client.stylesheetUpdates = move updates
  let mut window = NodeWindow.make(&fonts, move options, move client)
  run window.define(b"@silkui/core", uiPackage())
  if source.length != 0 {
    run window.entry(b"/app/app.js", source)
  } else {
    let read = run platform.readFile(entry)
    run window.entry(b"/app/app.js", read.asSlice())
  }
  // Every capability, as Node has: the app may read files, run processes and load Wasm.
  let api = run UiApi.make()
  return run window.start(b"app", api, Capabilities { platform: OsPlatform {}, modules: NodeResolution {}, files: OsFiles {}, compression: NativeCompression.make(), http2: Nghttp2.make(), crypto: OpenSslCrypto.make(), tls: OpenSslTls.make(), database: SqliteDatabase.make(), addons: DlopenAddons.make(), processes: OsProcesses {}, network: OsNetwork {}, http: Llhttp.make(), systemInfo: OsSystemInfo {}, typeStripping: Amaro {}, workers: ThreadWorkers {}, inspector: NodeInspector.make(), wasm: WamrWasm.make(), hostApi: api })
}

fn ran(settings: Settings, entry: Bytes, source: &'static [u8], launched: Option<Launched>, sheets: StyleAssets, updates: SheetWatch, compiler: StylesheetCompiler) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(settings, Bytes.asSlice(&entry), source, move launched, move sheets, move updates, compiler), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noArgument<E>(error: E) -> Option<Bytes> {
  drop error
  return Option<Bytes>.None
}

effect fn started(settings: Settings, entry: Bytes, source: &'static [u8], sheets: StyleAssets, updates: SheetWatch, compiler: StylesheetCompiler) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let path = move entry
  // The main thread keeps the OS event loop; the app and the runtime run on their own.
  return run Effect.catchAll(
    launch(|launched: Option<Launched>| -> i32 { return ran(settings, move path, source, move launched, move sheets, move updates, compiler) }),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn loaded(settings: Settings, entry: Bytes, source: &'static [u8], sources: &[&[u8]], updatePath: string, compiler: StylesheetCompiler) -> i32
  ! FileError | OutOfMemoryError ? &mut Allocator | &mut HostInput {
  let sheets = run StyleAssets.from(sources)
  let updates = run SheetWatch.from(updatePath)
  return run started(settings, move entry, source, move sheets, move updates, compiler)
}

/// The release host's `main`: the bundle `source` is part of the binary.
pub effect fn release(settings: Settings, source: &'static [u8]) -> i32 ? &mut HostInput {
  return run releaseWithSheets(settings, source, &[])
}

pub effect fn releaseWithSheets(settings: Settings, source: &'static [u8], sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(loaded(settings, Bytes.make(), source, sheets, "", StylesheetCompiler.off()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// The development host's `main`: `<host> <bundle>` runs the bundle at that path.
pub effect fn develop(settings: Settings) -> i32 ? &mut HostInput {
  return run developWithSheets(settings, &[])
}

pub effect fn developWithSheets(settings: Settings, sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  return run developWithSheetUpdates(settings, sheets, "")
}

pub effect fn developWithSheetUpdates(settings: Settings, sheets: &[&[u8]], updatePath: string) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = match move run Effect.catchAll(HostInput.argument(1), noArgument) |> Effect.provideMut<Allocator>(&mut allocator) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      StderrWriter.print("silkui: give the bundle's path\n", &())
      return 2
    }
  }
  return run Effect.catchAll(loaded(settings, move entry, b"", sheets, updatePath, runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub effect fn releaseWithRuntimeSheets(settings: Settings, source: &'static [u8], sheets: &[&[u8]]) -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(loaded(settings, Bytes.make(), source, sheets, "", runtimeStylesheets()), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
