//! The Silk host silkui writes for a target into `.silk/<target>/`: a manifest and a
//! `main.silk` of a few lines that call into `silkui-window` (or `silkui-web-canvas`,
//! `silkui-web-dom`), and for the web targets the page that loads it. It is generated, readable
//! and git-ignored; the project never edits it.
import stylesheets
import manifest { Project, loomSibling, sibling }
import silk.cli.task { TaskError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.f64
import silk.num.u64

/// What a generated host runs.
pub enum Kind {
  /// A JavaScript app on the SilkJS engine.
  Engine,
  /// A JavaScript app on the full SilkJS runtime.
  Node,
  /// A Loom app.
  Loom,
}

/// The window a host opens, and what it runs.
pub struct Plan {
  /// The target's id: the host package is `<project>-<target>`.
  pub target: string<'static>,
  pub kind: Kind,
  pub dev: bool,
  pub title: string<'static>,
  pub width: f64,
  pub height: f64,
  /// For a Loom app: the project module with its `Model` and `Message`, and its command
  /// type, or empty for none.
  pub module: string<'static>,
  pub command: string<'static>,
  pub stylesheets: usize,
}

/// `text` as the body of a Silk or TOML string literal.
effect fn quoted(out: &mut String, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut at: usize = 0
  let mut start: usize = 0
  while at < bytes.length {
    if bytes[at] == 34 || bytes[at] == 92 {
      run String.append(&mut out, String.slice(text, start, at - start))
      run String.append(&mut out, if bytes[at] == 34 { "\\\"" } else { "\\\\" })
      start = at + 1
    }
    at = at + 1
  }
  run String.append(&mut out, String.slice(text, start, bytes.length - start))
}

/// A number of pixels as a Silk `f64` literal.
effect fn pixels(out: &mut String, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut whole: u64 = 0
  if value > 0.0 { whole = f64.toU64(value) }
  let mut digits = String.make()
  if whole == 0 { run String.append(&mut digits, "0") }
  while whole > 0 {
    let digit = whole % 10
    let mut one = String.make()
    run String.append(&mut one, String.slice("0123456789", u64.toUsize(digit), 1))
    run String.append(&mut one, String.view(&digits))
    digits = move one
    whole = whole / 10
  }
  run String.append(&mut out, String.view(&digits))
  run String.append(&mut out, ".0")
}

/// The host's `silk.toml`.
pub effect fn manifest(project: &Project, plan: &Plan) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut out = run String.copy("# Generated by silkui: do not edit. `silk task` writes it again on every build.\n[package]\nname = \"")
  run quoted(&mut out, String.view(&project.name))
  run String.append(&mut out, "-")
  run String.append(&mut out, plan.target)
  run String.append(&mut out, "\"\nversion = \"0.1.0\"\n")
  if String.view(&project.silkVersion) != "" {
    run String.append(&mut out, "silk-version = \"")
    run String.append(&mut out, String.view(&project.silkVersion))
    run String.append(&mut out, "\"\n")
  }
  run String.append(&mut out, "\n[dependencies]\n")
  // What the host runs: `<alias> = { …, path = "<silkui>/<dir>", package = "<package>" }`.
  // Loom's targets are in the Loom repository, from wherever the app's `loom` comes from.
  let mut alias = "silkui_window"
  let mut dir = "window"
  let mut package = "silkui-window"
  if plan.target == "web-canvas" {
    alias = "silkui_web_canvas"
    dir = "modules/silkui/web/canvas"
    package = "silkui-web-canvas"
  } else if plan.target == "web-dom" {
    alias = "silkui_web_dom"
    dir = "modules/silkui/web/dom"
    package = "silkui-web-dom"
  } else if plan.kind == Kind.Node {
    alias = "silkui_window_node"
    dir = "window/node"
    package = "silkui-window-node"
  } else if plan.kind == Kind.Loom {
    alias = "silkui_window_loom"
    dir = "modules/silkui/window"
    package = "silkui-window-loom"
  }
  run String.append(&mut out, alias)
  run String.append(&mut out, " = ")
  if plan.kind == Kind.Loom {
    run String.appendOwned(&mut out, run loomSibling(project, dir, package))
  } else {
    run String.appendOwned(&mut out, run sibling(project, dir, package))
  }
  run String.append(&mut out, "\n")
  if plan.kind == Kind.Loom {
    run String.append(&mut out, "project = { path = \"../..\", package = \"")
    run quoted(&mut out, String.view(&project.name))
    run String.append(&mut out, "\" }\n")
  }
  // The engine in a debug build is far slower: animations stutter in it. The web targets
  // pass their whole profile to `silk build`.
  if plan.target == "window" {
    run String.append(&mut out, "\n[profiles.dev]\noptimization = \"speed\"\n")
  }
  return move out
}

effect fn settings(out: &mut String, plan: &Plan) -> () ! OutOfMemoryError ? &mut Allocator {
  run String.append(&mut out, "Settings { title: \"")
  run quoted(&mut out, plan.title)
  run String.append(&mut out, "\", width: ")
  run pixels(&mut out, plan.width)
  run String.append(&mut out, ", height: ")
  run pixels(&mut out, plan.height)
  if plan.kind == Kind.Loom {
    run String.append(&mut out, if plan.dev { ", inspect: true" } else { ", inspect: false" })
  }
  run String.append(&mut out, " }")
}

effect fn sheetArguments(out: &mut String, plan: &Plan) -> () ! OutOfMemoryError ? &mut Allocator {
  if plan.stylesheets == 0 { return () }
  run String.append(&mut out.*, ", &[")
  let mut i: usize = 0
  while i < plan.stylesheets {
    if i != 0 { run String.append(&mut out.*, ", ") }
    run String.append(&mut out.*, "Source.read(\"")
    run String.append(&mut out.*, String.view(&run stylesheets.name(i, false)))
    run String.append(&mut out.*, "\")")
    i = i + 1
  }
  run String.append(&mut out.*, "]")
  if plan.dev && plan.target != "web-dom" {
    run String.append(&mut out.*, ", Source.text(\"styles.path\")")
  }
}

/// The host's `src/main.silk`. A release JavaScript host embeds the bundle, `app.js` next to
/// the manifest.
pub effect fn main(plan: &Plan) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = run String.copy("//! Generated by silkui: do not edit. `silk task` writes it again on every build.\n")
  if (plan.stylesheets != 0 && plan.target != "web-dom") || (!plan.dev && plan.kind != Kind.Loom) {
    run String.append(&mut out, "import silk.build.source { Source }\n")
  }
  if plan.target == "web-canvas" || plan.target == "web-dom" {
    run String.append(&mut out, "import project.")
    run String.append(&mut out, plan.module)
    run String.append(&mut out, " { Model, Message")
    if plan.command != "" {
      run String.append(&mut out, ", ")
      run String.append(&mut out, plan.command)
    }
    run String.append(&mut out, " }\n")
  }
  if plan.target == "web-canvas" {
    run String.append(&mut out, "import silkui_web_canvas.app { Settings, ")
    let entry = if plan.command == "" {
      if plan.stylesheets == 0 { "main" } else if plan.dev { "mainWithSheetUpdates" } else { "mainWithSheets" }
    } else {
      if plan.stylesheets == 0 { "withCommands" } else if plan.dev { "withCommandsAndSheetUpdates" } else { "withCommandsAndSheets" }
    }
    run String.append(&mut out, entry)
    run String.append(&mut out, " as loom }\n")
    // The page's WebGPU host and the C math functions call into these: they must be in the
    // program's own package, since a dependency exports no wasm symbols.
    run String.append(&mut out, "\nstatic if Intrinsic.targetArchitecture() == \"wasm32\" {\n  import webgpu_exports as _webgpu_exports\n  import libm as _libm\n}\n\npub fn main() -> i32 {\n  return ")
    if plan.command == "" {
      run String.append(&mut out, "loom<Model, Message>(")
    } else {
      run String.append(&mut out, "loom<Model, Message, ")
      run String.append(&mut out, plan.command)
      run String.append(&mut out, ">(")
    }
    run String.append(&mut out, "Settings { title: \"")
    run quoted(&mut out, plan.title)
    run String.append(&mut out, "\" }")
    run sheetArguments(&mut out, plan)
    run String.append(&mut out, ")\n}\n")
    return move out
  }
  if plan.target == "web-dom" {
    run String.append(&mut out, "import silkui_web_dom.app { open, call }\n\n// The page calls these two (modules/loom/dom/js/silk-ui-dom.js).\nstatic if Intrinsic.targetArchitecture() == \"wasm32\" {\n  export \"C\" fn opened() -> ?*mut u8 as \"silk_ui_open\" {\n    return open<Model, Message>()\n  }\n\n  export \"C\" fn called(token: ?*mut u8, op: u32, a: f64, b: f64, c: f64) -> f64 as \"silk_ui_call\" {\n    return call<Model, Message>(token, op, a, b, c)\n  }\n}\n\npub fn main() -> i32 {\n  return 0\n}\n")
    return move out
  }
  match plan.kind {
    Kind.Loom => {
      run String.append(&mut out, "import project.")
      run String.append(&mut out, plan.module)
      run String.append(&mut out, " { Model, Message")
      if plan.command != "" {
        run String.append(&mut out, ", ")
        run String.append(&mut out, plan.command)
      }
      run String.append(&mut out, " }\nimport silkui_window_loom.app { Settings, ")
      let entry = if plan.command == "" {
        if plan.stylesheets == 0 { "main" } else if plan.dev { "mainWithSheetUpdates" } else { "mainWithSheets" }
      } else {
        if plan.stylesheets == 0 { "withCommands" } else if plan.dev { "withCommandsAndSheetUpdates" } else { "withCommandsAndSheets" }
      }
      run String.append(&mut out, entry)
      if plan.command == "" {
        run String.append(&mut out, " as loom }\n\npub fn main() -> i32 {\n  return loom<Model, Message>(")
      } else {
        run String.append(&mut out, " }\n\npub fn main() -> i32 {\n  return ")
        run String.append(&mut out, entry)
        run String.append(&mut out, "<Model, Message, ")
      }
      if plan.command != "" {
        run String.append(&mut out, plan.command)
        run String.append(&mut out, ">(")
      }
      run settings(&mut out, plan)
      run sheetArguments(&mut out, plan)
      run String.append(&mut out, ")\n}\n")
    }
    Kind.Engine => {
      if plan.dev {
        run String.append(&mut out, "import silkui_window.js { Settings }\nimport silkui_window.js_dev { ")
        run String.append(&mut out, if plan.stylesheets == 0 { "main as develop" } else { "mainWithSheetUpdates as develop" })
        run String.append(&mut out, " }\nimport silk.system.host_input { HostInput }\n\npub effect fn main() -> i32 ? &mut HostInput {\n  return run develop(")
      } else {
        run String.append(&mut out, "import silkui_window.js { Settings, ")
        run String.append(&mut out, if plan.stylesheets == 0 { "release" } else { "releaseWithSheets as release" })
        run String.append(&mut out, " }\nimport silk.system.host_input { HostInput }\n\npub effect fn main() -> i32 ? &mut HostInput {\n  return run release(")
      }
      run settings(&mut out, plan)
      if !plan.dev { run String.append(&mut out, ", Source.read(\"app.js\")") }
      run sheetArguments(&mut out, plan)
      run String.append(&mut out, ")\n}\n")
    }
    Kind.Node => {
      run String.append(&mut out, "import silkui_window_node.node { ")
      run String.append(&mut out, if plan.dev { if plan.stylesheets == 0 { "Settings, develop }\n" } else { "Settings, developWithSheetUpdates as develop }\n" } } else { if plan.stylesheets == 0 { "Settings, release }\n" } else { "Settings, releaseWithSheets as release }\n" } })
      run String.append(&mut out, "import silk.system.host_input { HostInput }\n\npub effect fn main() -> i32 ? &mut HostInput {\n  return run ")
      run String.append(&mut out, if plan.dev { "develop(" } else { "release(" })
      run settings(&mut out, plan)
      if !plan.dev { run String.append(&mut out, ", Source.read(\"app.js\")") }
      run sheetArguments(&mut out, plan)
      run String.append(&mut out, ")\n}\n")
    }
  }
  return move out
}

/// A web-canvas host's `src/webgpu_exports.silk`: the exports the page's WebGPU host calls back.
/// It is lib-native's `modules/gpu/webgpu/browser/generated_webgpu_exports.silk` reaching the GPU
/// packages through `silkui_web_canvas.gpu`; keep the two in step when the pin moves.
pub effect fn webgpuExports() -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = String.make()
  run String.append(&mut out, "// Generated by silkui: do not edit. `silk task` writes it again on every build.\n")
  run String.append(&mut out, "// Imports must live in the root application package: dependencies do not export wasm symbols.\n")
  run String.append(&mut out, "// Host contract: callback userdata addresses remain pinned until completion or cancellation.\n")
  run String.append(&mut out, "// Invoke callbacks only inside explicit pumps, with no outstanding loans to their slots.\n")
  run String.append(&mut out, "// Allocator exports run synchronously; promise settlement must only enqueue JS-owned data.\n")
  run String.append(&mut out, "static if Intrinsic.targetArchitecture() == \"wasm32\" {\n")
  run String.append(&mut out, "  import silkui_web_canvas.gpu\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  export \"C\" fn wasmMap(status: gpu.WGPUMapAsyncStatus, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_bufferMap\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmMap(status, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmCompilation(status: gpu.WGPUCompilationInfoRequestStatus, compilationInfo: ?*const gpu.WGPUCompilationInfo, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_compilation\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmCompilation(status, compilationInfo, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmComputePipeline(status: gpu.WGPUCreatePipelineAsyncStatus, pipeline: gpu.WGPUComputePipeline, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_computePipeline\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmComputePipeline(status, pipeline, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmRenderPipeline(status: gpu.WGPUCreatePipelineAsyncStatus, pipeline: gpu.WGPURenderPipeline, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_renderPipeline\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmRenderPipeline(status, pipeline, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmLost(device: ?*const gpu.WGPUDevice, reason: gpu.WGPUDeviceLostReason, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_deviceLost\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmLost(device, reason, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmScope(status: gpu.WGPUPopErrorScopeStatus, type_: gpu.WGPUErrorType, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_popErrorScope\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmScope(status, type_, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmQueue(status: gpu.WGPUQueueWorkDoneStatus, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_queueDone\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmQueue(status, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmAdapter(status: gpu.WGPURequestAdapterStatus, adapter: gpu.WGPUAdapter, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_adapter\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmAdapter(status, adapter, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmDevice(status: gpu.WGPURequestDeviceStatus, device: gpu.WGPUDevice, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_device\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmDevice(status, device, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn wasmError(device: ?*const gpu.WGPUDevice, type_: gpu.WGPUErrorType, messageData: ?[*]const u8, messageLength: usize, userdata1: ?*mut u8, userdata2: ?*mut u8) -> () as \"webgpu_callback_uncapturedError\" {\n")
  run String.append(&mut out, "    unsafe gpu.wasmError(device, type_, messageData, messageLength, userdata1, userdata2)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn allocate(size: usize) -> ?*mut u8 as \"webgpu_alloc\" {\n")
  run String.append(&mut out, "    return gpu.hostAllocate(size)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "  export \"C\" fn free(pointer: ?*mut u8, size: usize) -> () as \"webgpu_free\" {\n")
  run String.append(&mut out, "    unsafe gpu.release(pointer, size)\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "}\n")
  return move out
}

/// A web-canvas host's `src/libm.silk`: the C math functions wasm32 has no library for.
pub effect fn libm() -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = String.make()
  run String.append(&mut out, "// Generated by silkui: do not edit. `silk task` writes it again on every build.\n")
  run String.append(&mut out, "//! The C math functions the renderer's dependencies call on wasm32 that std does not export:\n")
  run String.append(&mut out, "//! `sinf`, `cosf`, `tanf` and `hypotf` (read_fonts colour transforms). The standalone wasm32\n")
  run String.append(&mut out, "//! runtime links no C library, so these forward to the host's `Math` (see `js/`). Since Silk\n")
  run String.append(&mut out, "//! dev.47, std's wasm support exports `fmod` and `fmaf` itself. Other targets link the system\n")
  run String.append(&mut out, "//! libm.\n")
  run String.append(&mut out, "static if Intrinsic.targetArchitecture() == \"wasm32\" {\n")
  run String.append(&mut out, "  import silk.num.f32\n")
  run String.append(&mut out, "  import silk.num.f64\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  unsafe extern \"C\" fn hostSin(value: f64) -> f64 as \"math#sin\"\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  unsafe extern \"C\" fn hostCos(value: f64) -> f64 as \"math#cos\"\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  unsafe extern \"C\" fn hostTan(value: f64) -> f64 as \"math#tan\"\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  unsafe extern \"C\" fn hostHypot(x: f64, y: f64) -> f64 as \"math#hypot\"\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  export \"C\" fn sinf(value: f32) -> f32 as \"sinf\" {\n")
  run String.append(&mut out, "    unsafe {\n")
  run String.append(&mut out, "      return f64.toF32(hostSin(f32.toF64(value)))\n")
  run String.append(&mut out, "    }\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  export \"C\" fn cosf(value: f32) -> f32 as \"cosf\" {\n")
  run String.append(&mut out, "    unsafe {\n")
  run String.append(&mut out, "      return f64.toF32(hostCos(f32.toF64(value)))\n")
  run String.append(&mut out, "    }\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  export \"C\" fn tanf(value: f32) -> f32 as \"tanf\" {\n")
  run String.append(&mut out, "    unsafe {\n")
  run String.append(&mut out, "      return f64.toF32(hostTan(f32.toF64(value)))\n")
  run String.append(&mut out, "    }\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "\n")
  run String.append(&mut out, "  export \"C\" fn hypotf(x: f32, y: f32) -> f32 as \"hypotf\" {\n")
  run String.append(&mut out, "    unsafe {\n")
  run String.append(&mut out, "      return f64.toF32(hostHypot(f32.toF64(x), f32.toF64(y)))\n")
  run String.append(&mut out, "    }\n")
  run String.append(&mut out, "  }\n")
  run String.append(&mut out, "}\n")
  return move out
}

/// A web host's `index.html`. A `Mode.Dev` page reloads itself after each rebuild.
pub effect fn page(plan: &Plan) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = run String.copy("<!doctype html>\n<!-- Generated by silkui: do not edit. -->\n<html lang=\"en\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>")
  run escaped(&mut out, plan.title)
  run String.append(&mut out, "</title>\n")
  if plan.target == "web-canvas" {
    run String.append(&mut out, "<style>\n  html, body { margin: 0; height: 100%; background: #fff; overflow: hidden; }\n  #app { position: fixed; inset: 0; }\n  #message { position: fixed; left: 16px; right: 16px; bottom: 16px; font: 14px system-ui, sans-serif; color: #b00020; white-space: pre-wrap; }\n</style>\n<div id=\"app\"></div>\n<div id=\"message\"></div>\n<script type=\"module\">\n  import { runApp, unsupported } from '/ui/tree/window/browser/app-host.js';\n  const message = document.getElementById('message');\n  const problem = unsupported();\n  if (problem) {\n    message.textContent = `${problem} Open this page in Chrome or Edge 137 or later.`;\n  } else {\n    runApp({ wasm: '/app.wasm', container: document.getElementById('app')")
    if plan.dev && plan.stylesheets != 0 { run String.append(&mut out, ", stylesheetUpdates: '/styles.update'") }
    run String.append(&mut out, " }).catch(error => {\n      message.textContent = String(error?.message ?? error);\n      console.error(error);\n    });\n  }\n</script>\n")
  } else {
    run String.append(&mut out, "<style>\n  body { margin: 0; font-family: system-ui, sans-serif; }\n</style>\n")
    let mut i: usize = 0
    while i < plan.stylesheets {
      run String.append(&mut out, "<link data-silkui-sheet rel=\"stylesheet\" href=\"")
      run String.append(&mut out, String.view(&run stylesheets.name(i, true)))
      run String.append(&mut out, "\">\n")
      i = i + 1
    }
    run String.append(&mut out, "<div id=\"app\"></div>\n<script type=\"module\">\n  import { mount } from './silk-ui-dom.js';\n  await mount({ wasm: './app.wasm', root: document.getElementById('app') });\n</script>\n")
  }
  if plan.dev && plan.target == "web-dom" && plan.stylesheets != 0 {
    run String.append(&mut out, "<script>\n  // Replace linked CSS without restarting the program or losing its state.\n  let styled = '__SILKUI_STYLES__';\n  let replacing = false;\n  setInterval(async () => {\n    if (replacing) return;\n    replacing = true;\n    try {\n      const response = await fetch('/__silkui/styles', { cache: 'no-store' });\n      if (!response.ok) return;\n      const now = await response.text();\n      if (now === styled) return;\n      const previous = Array.from(document.querySelectorAll('link[data-silkui-sheet]'));\n      const replacements = [];\n      try {\n        await Promise.all(previous.map(link => new Promise((resolve, reject) => {\n          const next = link.cloneNode();\n          const url = new URL(next.href);\n          url.searchParams.set('silkui-style', now);\n          next.href = url.href;\n          // Keep the current sheet active until every replacement has loaded.\n          next.media = 'not all';\n          next.onload = resolve;\n          next.onerror = reject;\n          replacements.push(next);\n          link.after(next);\n        })));\n        replacements.forEach(link => { link.media = ''; });\n        previous.forEach(link => link.remove());\n        styled = now;\n      } catch {\n        replacements.forEach(link => link.remove());\n      }\n    } catch {} finally { replacing = false; }\n  }, 300);\n</script>\n")
  }
  if plan.dev {
    run String.append(&mut out, "<script>\n  // silkui dev: reload when the program is rebuilt. The server fills in the build number.\n  const built = '__SILKUI_BUILD__';\n  setInterval(async () => {\n    try {\n      const now = await (await fetch('/__silkui/build', { cache: 'no-store' })).text();\n      if (now !== built) location.reload();\n    } catch {}\n  }, 500);\n</script>\n")
  }
  run String.append(&mut out, "</html>\n")
  return move out
}

/// `text` as HTML text.
effect fn escaped(out: &mut String, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut at: usize = 0
  let mut start: usize = 0
  while at < bytes.length {
    if bytes[at] == 38 || bytes[at] == 60 || bytes[at] == 62 {
      run String.append(&mut out, String.slice(text, start, at - start))
      run String.append(&mut out, if bytes[at] == 38 { "&amp;" } else if bytes[at] == 60 { "&lt;" } else { "&gt;" })
      start = at + 1
    }
    at = at + 1
  }
  run String.append(&mut out, String.slice(text, start, bytes.length - start))
}
