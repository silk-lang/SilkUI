import host { Kind, Plan }
import host
import stylesheets
import css_style.sheet { Sheet }
import css_style.sheet_fonts { FaceSource }
import css_style.tokens { equal }
import silk.core.result { Result }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.filesystem_native { OsFileSystem }
import css_style.sheet_binary { DecodeError }
import css_style.tokens { Limits }
import silk.cli.task { TaskError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn plan(target: string<'static>, kind: Kind, dev: bool, count: usize) -> Plan {
  return Plan { target: target, kind: kind, dev: dev, title: "Styles", width: 400.0,
    height: 300.0, module: "app", command: "", stylesheets: count, runtimeCss: false }
}

effect fn generatedHosts() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let kinds = [Kind.Engine, Kind.Node, Kind.Loom]
  let modes = [false, true]
  let mut i: usize = 0
  while i < kinds.length {
    let mut j: usize = 0
    while j < modes.length {
      let p = plan("window", kinds[i], modes[j], 2)
      let source = run host.main(&p)
      run Testing.expect(String.contains(String.view(&source), ", &[Source.read(\"style-0.sheet\"), Source.read(\"style-1.sheet\")]"), "native hosts embed all sheets in adoption order")
      run Testing.expect(String.contains(String.view(&source), if modes[j] { if kinds[i] == Kind.Loom { "WithRuntimeSheets" } else { "WithSheetUpdates" } } else { "WithSheets" }), "native entry uses compiled sheet API")
      run Testing.expect(String.contains(String.view(&source), "Source.text(\"styles.path\")") == modes[j], "only dev hosts watch published sheet updates")
      let empty = run host.main(&plan("window", kinds[i], modes[j], 0))
      run Testing.expect(!String.contains(String.view(&empty), "WithSheets") && !String.contains(String.view(&empty), "style-0.sheet"), "existing apps retain their entry point")
      j = j + 1
    }
    i = i + 1
  }
  let mut runtime = plan("window", Kind.Engine, false, 0)
  runtime.runtimeCss = true
  let runtimeHost = run host.main(&runtime)
  run Testing.expect(String.contains(String.view(&runtimeHost), "releaseWithRuntimeSheets as release") && String.contains(String.view(&runtimeHost), "Source.read(\"app.js\"), &[]"), "runtime text compilation is an explicit release option even without embedded sheets")
  runtime.kind = Kind.Node
  let runtimeNode = run host.main(&runtime)
  run Testing.expect(String.contains(String.view(&runtimeNode), "releaseWithRuntimeSheets as release"), "Node release hosts share the runtime compiler option")
  let loomDev = run host.main(&plan("window", Kind.Loom, true, 0))
  run Testing.expect(String.contains(String.view(&loomDev), "mainWithRuntimeSheets as loom") && String.contains(String.view(&loomDev), ", &[], \"\")"), "Loom dev includes runtime compilation even without build sheets")
  let mut runtimeCanvas = plan("web-canvas", Kind.Loom, false, 0)
  runtimeCanvas.runtimeCss = true
  let canvasRuntime = run host.main(&runtimeCanvas)
  run Testing.expect(String.contains(String.view(&canvasRuntime), "mainWithRuntimeSheets as loom") && String.contains(String.view(&canvasRuntime), ", &[], \"\")"), "canvas release runtime compilation is explicit")
  let canvas = run host.main(&plan("web-canvas", Kind.Loom, false, 2))
  run Testing.expect(String.contains(String.view(&canvas), "mainWithSheets as loom") && String.contains(String.view(&canvas), "style-1.sheet"), "canvas embeds compiled sheets")
  let mut commands = plan("window", Kind.Loom, false, 2)
  commands.command = "Commands"
  let nativeCommands = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&nativeCommands), "withCommandsAndSheets<Model, Message, Commands>"), "command hosts retain their command type")
  commands.target = "web-canvas"
  let canvasCommands = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&canvasCommands), "withCommandsAndSheets as loom") && String.contains(String.view(&canvasCommands), "loom<Model, Message, Commands>"), "canvas command hosts accept sheets")
  commands.dev = true
  let canvasDev = run host.main(&commands)
  run Testing.expect(String.contains(String.view(&canvasDev), "withCommandsAndRuntimeSheets as loom") && String.contains(String.view(&canvasDev), "Source.text(\"styles.path\")"), "canvas development hosts consume compiled updates")
  let canvasDevPage = run host.page(&commands)
  let canvasReleasePage = run host.page(&plan("web-canvas", Kind.Loom, false, 2))
  run Testing.expect(String.contains(String.view(&canvasDevPage), "stylesheetUpdates: '/styles.update'") && !String.contains(String.view(&canvasReleasePage), "stylesheetUpdates:"), "canvas update fetching is development-only")
  let domPlan = plan("web-dom", Kind.Loom, false, 2)
  let dom = run host.main(&domPlan)
  let page = run host.page(&domPlan)
  run Testing.expect(!String.contains(String.view(&dom), "Source.read") && !String.contains(String.view(&dom), "WithSheets"), "DOM leaves CSS to the browser")
  let devPage = run host.page(&plan("web-dom", Kind.Loom, true, 2))
  run Testing.expect(String.contains(String.view(&devPage), "/__silkui/styles") && !String.contains(String.view(&page), "/__silkui/styles"), "CSS replacement polling is development-only")
  run Testing.expect(String.contains(String.view(&page), "<link data-silkui-sheet rel=\"stylesheet\" href=\"style-0.css\">\n<link data-silkui-sheet rel=\"stylesheet\" href=\"style-1.css\">\n<div"), "DOM links sheets in order before mounting")
}

test effect fn orderedAssetsAcrossGeneratedHosts() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run generatedHosts() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn compileAsset() -> () ! TaskError | DecodeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = run stylesheets.compiled(b"@layer base { .card { width: 123px; --accent: red } }", "app.css")
  let sheet = run Sheet.decode(bytes.asSlice(), &Limits.make())
  run Testing.expect(sheet.declarations.length() == 2 && sheet.diagnostics.length() == 0, "pipeline emits decodable rules and custom properties")
  let number = run stylesheets.name(120, false)
  run Testing.expect(String.view(&number) == "style-120.sheet", "asset names remain unique beyond single digits")
}

test effect fn compiledAssetRoundTrip() -> () ! TaskError | DecodeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compileAsset() |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn bundledFonts() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut FileSystem {
  let temporary = run FileSystem.temporaryDirectory(&run Path.root(),"silk-font-assets-")
  let root = temporary.path.view().unwrapOr("")
  let font = run Path.resolve(&temporary.path,"fonts/font one.ttf")
  let other = run Path.resolve(&temporary.path,"fonts/root.woff2")
  let source = run Path.resolve(&temporary.path,"styles/main.css")
  let host = run Path.resolve(&temporary.path,"host")
  run FileSystem.writeFileWithParents(&font,b"first font")
  run FileSystem.writeFileWithParents(&other,b"second font")
  run FileSystem.writeFileWithParents(&source,b"@layer fonts{@media(min-width:1px){@font-face{font-family:Brand;src:local('Full Name'),url('../fonts/font%20one.ttf?v=1#face') format('truetype'),url(/fonts/root.woff2),url(https://example.invalid/a.woff2);font-display:swap}}}.untouched{background:url(../images/keep.png)}")
  let paths: [string<'static>; 1] = ["styles/main.css"]
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),false)
  let compiledPath = run Path.resolve(&host,"style-0.sheet")
  let compiled = run FileSystem.readFile(&compiledPath)
  let sheet = run Sheet.decode(compiled.asSlice(),&Limits.make())
  run Testing.expect(sheet.fontFaces.length() == 1 && sheet.fontFaces.asSlice()[0].rule.sources.length() == 4,"bundling preserves conditions, local sources and URL alternatives")
  let sources = sheet.fontFaces.asSlice()[0].rule.sources.asSlice()
  run Testing.expect(match &sources[1] { FaceSource.Url { url, format, .. } => String.view(&url) == "data:application/octet-stream;base64,Zmlyc3QgZm9udA==" && equal(format.asSlice(),b"truetype") _ => false },"relative escaped font path is bundled with its format hint")
  run Testing.expect(match &sources[2] { FaceSource.Url { url, .. } => String.view(&url) == "data:application/octet-stream;base64,c2Vjb25kIGZvbnQ=" _ => false },"root-relative font path uses the app root")
  run Testing.expect(match &sources[3] { FaceSource.Url { url, .. } => String.view(&url) == "https://example.invalid/a.woff2" _ => false },"remote URLs remain lazy host loads")
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),true)
  let dom = run FileSystem.readFile(&run Path.resolve(&host,"style-0.css"))
  let domText = match String.fromUtf8(dom.asSlice()) { Result.Success { value } => value _ => "" }
  run Testing.expect(String.contains(domText,"data:application/octet-stream;base64,Zmlyc3QgZm9udA==") && String.contains(domText,".untouched{background:url(../images/keep.png)}"),"DOM output embeds the font and preserves unrelated CSS source")
  let before = run stylesheets.fingerprint(root,&paths)
  run FileSystem.writeFile(&font,b"updated font")
  let after = run stylesheets.fingerprint(root,&paths)
  run Testing.expect(before != after,"editing only a font changes the stylesheet update fingerprint")
  run stylesheets.emit(root,&paths,host.view().unwrapOr(""),false)
  let updated = run FileSystem.readFile(&compiledPath)
  run Testing.expect(!equal(compiled.asSlice(),updated.asSlice()),"font edits change the embedded sheet without application source edits")
  let updatePath = run Path.resolve(&host,"styles.update")
  let previous = run FileSystem.readFile(&updatePath)
  run FileSystem.writeFile(&source,b"@font-face{font-family:Missing;src:url(missing.ttf)}")
  let failed = run Effect.result(stylesheets.emit(root,&paths,host.view().unwrapOr(""),false))
  run Testing.expect(match &failed { Result.Failure { .. } => true _ => false },"missing local assets fail the build")
  let retained = run FileSystem.readFile(&updatePath)
  run Testing.expect(equal(previous.asSlice(),retained.asSlice()),"failed font updates retain the last published bundle")
  run FileSystem.release(move temporary)
}

effect fn withFontFiles() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make("/tmp")
  run bundledFonts() |> Effect.provideMut<FileSystem>(&mut files)
}

test effect fn stylesheetBuildBundlesLocalFontsForNativeAndDomAndTracksChanges() ! TaskError | FileError | DecodeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withFontFiles() |> Effect.provideMut<Allocator>(&mut allocator)
}
