//! An app and the pipeline that builds and runs it, in three stages: an [`App`] (the
//! definition), a [`Built`] (the artifacts per target) and a [`Running`] (live processes).
//! Each step is scoped under the stage it takes, so `App.build` takes an App and gives a
//! Built, and `Built.launch` takes a Built and gives a Running. Steps are effects, so a chain
//! starts with `run`:
//!
//! ```silk,ignore
//! effect fn app() -> App {
//!   return run App.make("my-app")
//!     |> App.framework(Framework.react("."))
//!     |> App.target(Target.window(Window { title: "My app", width: 900.0, height: 600.0 }))
//! }
//!
//! // The app draws under the window's title bar on macOS, and a press in its top 56 pixels
//! // moves the window.
//! Target.window(Window { title: "My app", width: 900.0, height: 600.0 })
//!   .titleBar(TitleBar.transparent(56.0))
//!
//! // The same, with the window buttons 20 pixels from the left and 18 from the top.
//!   .titleBar(TitleBar.transparent(56.0).buttons(20.0, 18.0))
//!
//! run app() |> App.only(target) |> App.build(Mode.Dev) |> Built.launch() |> Running.watch()
//! run app() |> App.only(target) |> App.build(Mode.Release) |> Built.write("dist")
//! ```
//!
//! A project's own step is a function of the same shape, `effect fn sign<'env, E, ?R>(built:
//! once Effect<'env; Built ! E ? R>) -> Built ! … ? …`, placed in the chain. `tap` and `map`
//! take a closure for something small between two steps.
//!
//! The steps run inside a task (`silk task`): they use the task's root as the project
//! directory and its compiler for `silk build`.
import stylesheets
import host { Kind, Plan, packageName as hostPackageName, manifest, main as hostMain, page as hostPage, webgpuExports, libm }
import manifest { Project, read as readProject }
import web { Server, site }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { WriterError }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileInfo, DirectoryInfo, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.i32
import silk.num.u8
import process { Child, Variable, start, pause }
import output { now, say as tell, done, artifact as listArtifact, built as finished }

/// A desktop window's options.
pub struct Window {
  pub title: string<'static>,
  pub width: f64,
  pub height: f64,
}

impl Copy for Window {}

/// How a desktop window's title bar is drawn.
pub union TitleBar {
  /// The system's bar, above the app.
  Standard,
  /// On macOS, the app fills the window and the window controls float over its top `height`
  /// pixels: the app draws the bar there, a press in it moves the window (a double click zooms
  /// or minimizes it, as the user's settings say), and the app gets no presses there. Other
  /// systems keep their bar. The window buttons (close, minimize, zoom) are centred in it,
  /// as far from the left edge as from the top, unless `buttons` placed them.
  Transparent { pub height: f64, pub left: f64, pub top: f64 },
}

impl Copy for TitleBar {}

impl TitleBar {
  pub fn standard() -> TitleBar { return TitleBar.Standard }
  pub fn transparent(height: f64) -> TitleBar { return TitleBar.Transparent { height: height, left: 0.0, top: 0.0 } }

  /// A transparent bar with the window buttons' top-left corner `left` and `top` pixels from
  /// the window's edges; 0 keeps that one centred. The standard bar stays as it is.
  pub fn buttons(self: TitleBar, left: f64, top: f64) -> TitleBar {
    return match self {
      TitleBar.Transparent { height, .. } => TitleBar.Transparent { height: height, left: left, top: top }
      _ => self
    }
  }
}

/// A browser page's options. The app fills the page.
pub struct Page {
  pub title: string<'static>,
}

impl Copy for Page {}

/// Where an app runs. Its id names it in `--target`, in `.silk/<id>/` and in `dist/<id>/`.
pub union Target {
  /// A desktop window (`window`).
  Window { pub window: Window, pub bar: TitleBar },
  /// A browser page drawn with WebGPU (`web-canvas`): the tree, compiled to wasm.
  WebCanvas { pub page: Page },
  /// A browser page of real elements (`web-dom`): the browser's DOM in the tree's place.
  WebDom { pub page: Page },
}

impl Copy for Target {}

impl Target {
  pub fn window(window: Window) -> Target { return Target.Window { window: window, bar: TitleBar.Standard } }
  pub fn webCanvas(page: Page) -> Target { return Target.WebCanvas { page: page } }
  pub fn webDom(page: Page) -> Target { return Target.WebDom { page: page } }

  /// The window target with its title bar drawn as `bar`. A browser page has no title bar:
  /// the web targets stay as they are.
  pub fn titleBar(self: Target, bar: TitleBar) -> Target {
    return match self {
      Target.Window { window, .. } => Target.Window { window: window, bar: bar }
      _ => self
    }
  }

  /// `window`, `web-canvas` or `web-dom`.
  pub fn id(self: &Target) -> string<'static> {
    return match self.* {
      Target.Window { .. } => "window"
      Target.WebCanvas { .. } => "web-canvas"
      Target.WebDom { .. } => "web-dom"
    }
  }

  /// Whether it is a browser page.
  pub fn web(self: &Target) -> bool {
    return match self.* {
      Target.Window { .. } => false
      _ => true
    }
  }
}

/// What the app is written in. The JavaScript ones name the directory of a Vite project with
/// `@silkui/vite` in its config, `.` when `package.json` sits beside `silk.toml`. silkui has
/// Vite bundle it into `.silk/bundle/`.
pub union Framework {
  /// Loom: `module` in the project's sources has a `Model` (a `Program<Message, C>`) and its
  /// `Message`; `command` names its command type, or is empty for none.
  Loom { pub module: string<'static>, pub command: string<'static> },
  React { pub dir: string<'static> },
  Foldkit { pub dir: string<'static> },
  Js { pub dir: string<'static> },
}

impl Copy for Framework {}

impl Framework {
  /// A Loom app whose `Model` and `Message` are in the project module `module`, such as `app`
  /// for `silk/app.silk` when the manifest sets `source = "silk"`. The project's manifest exports it.
  pub fn loom(module: string<'static>) -> Framework { return Framework.Loom { module: module, command: "" } }
  /// A Loom app with commands: `command` is the name of its command type in `module`.
  pub fn loomWithCommands(module: string<'static>, command: string<'static>) -> Framework {
    return Framework.Loom { module: module, command: command }
  }
  pub fn react(dir: string<'static>) -> Framework { return Framework.React { dir: dir } }
  pub fn foldkit(dir: string<'static>) -> Framework { return Framework.Foldkit { dir: dir } }
  pub fn js(dir: string<'static>) -> Framework { return Framework.Js { dir: dir } }

  /// `loom`, `react`, `foldkit` or `js`.
  pub fn id(self: &Framework) -> string<'static> {
    return match self.* {
      Framework.Loom { .. } => "loom"
      Framework.React { .. } => "react"
      Framework.Foldkit { .. } => "foldkit"
      Framework.Js { .. } => "js"
    }
  }

  /// The Vite project's directory, or empty for Loom.
  pub fn dir(self: &Framework) -> string<'static> {
    return match self.* {
      Framework.Loom { .. } => ""
      Framework.React { dir } => dir
      Framework.Foldkit { dir } => dir
      Framework.Js { dir } => dir
    }
  }
}

/// What runs a JavaScript app in a window. Browser targets run it on the browser's own engine.
pub enum Runtime {
  /// The SilkJS Engine: lean, no Node or web platform APIs. The default.
  Engine,
  /// The full SilkJS runtime: Node's APIs and the web APIs Node has. No hot reload yet.
  Node,
}

impl Runtime {
  pub fn engine() -> Runtime { return Runtime.Engine }
  pub fn node() -> Runtime { return Runtime.Node }
}

/// How a build is made. `Dev` adds the development tools (hot reload, the inspector) and
/// keeps debug information; `Debug` is the release program unoptimized, with debug
/// information and no development tools, as `silk build` makes; `Release` is optimized.
pub enum Mode {
  Dev,
  Debug,
  Release,
}

/// The host of one target: the package `silk build` builds.
pub struct Host {
  pub target: Target,
  /// The package directory, absolute.
  pub dir: String,
  /// Whether silkui wrote it.
  pub generated: bool,
}

/// An app: the definition, and once [`App.bundle`] and [`App.host`] ran, where its bundle
/// and hosts are.
pub struct App {
  named: string<'static>,
  writtenIn: Framework,
  runsOn: Runtime,
  runtimeCss: bool,
  places: List<Target>,
  custom: string<'static>,
  stylePaths: List<string<'static>>,
  bundled: String,
  compiledSheet: String,
  hosts: List<Host>,
  /// When it was made, on `output.now`'s clock: the start of a build.
  begun: u64,
}

/// One built target.
pub struct Artifact {
  pub target: Target,
  /// The program, absolute. For a web target, the folder with the page and its program.
  pub path: String,
  /// Its size in bytes: for a web target, the wasm program's.
  pub bytes: usize,
}

/// A built app: an artifact per target.
pub struct Built {
  source: App,
  /// The project directory, absolute.
  root: String,
  madeIn: Mode,
  outputs: List<Artifact>,
}

/// A launched app: what [`Built.launch`] started.
pub struct Running {
  launched: Built,
  target: Target,
  vite: bool,
  /// The program, for a window.
  child: Option<Child>,
  /// What serves the page, for a web target.
  server: Option<Server>,
}

// --- helpers ---

fn same(left: string, right: string) -> bool { return left == right }

effect fn joined(base: string, child: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut out = run String.copy(base)
  if !String.endsWith(base, "/") { run String.append(&mut out, "/") }
  run String.append(&mut out, child)
  return move out
}

/// `path`, absolute: relative ones are from the project root.
effect fn fromRoot(project: &Project, path: string) -> String ! OutOfMemoryError ? &mut Allocator {
  if String.startsWith(path, "/") { return run String.copy(path) }
  // `.` is the root itself: paths with a `.` segment are not valid.
  if path == "." { return run String.copy(String.view(&project.root)) }
  return run joined(String.view(&project.root), path)
}

effect fn say(text: string) -> () ! OutOfMemoryError ? &mut Allocator { tell(text) }

/// `path` from the project root when it is inside it, as the lines silkui writes show it.
fn relative<'a>(root: string, path: string<'a>) -> string<'a> {
  let rootLength = String.byteLength(root)
  let length = String.byteLength(path)
  if length > rootLength + 1 && String.startsWith(path, root) && String.utf8Bytes(path)[rootLength] == 47 {
    return String.slice(path, rootLength + 1, length - rootLength - 1)
  }
  return path
}

effect fn writeText(path: string, text: string) -> ()
  ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let file = run Path.make(path)
  run FileSystem.writeFileWithParents(&file, String.utf8Bytes(text))
}

effect fn exists(path: string) -> bool ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let file = run Path.make(path)
  return run FileSystem.exists(&file)
}

/// Writes `path` only when its content changes, so `silk build` sees no change otherwise.
effect fn refresh(path: string, text: string) -> ()
  ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let file = run Path.make(path)
  if run FileSystem.exists(&file) {
    let old = run FileSystem.readFile(&file)
    if Bytes.asSlice(&old) == String.utf8Bytes(text) { return () }
  }
  run FileSystem.writeFileWithParents(&file, String.utf8Bytes(text))
}

effect fn unsupported(framework: &Framework, target: &Target, runtime: Runtime) -> never
  ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut message = run String.copy("silkui cannot build ")
  run String.append(&mut message, framework.id())
  if runtime == Runtime.Node && framework.id() != "loom" { run String.append(&mut message, " (on the SilkJS runtime)") }
  run String.append(&mut message, " apps for the ")
  run String.append(&mut message, target.id())
  run String.append(&mut message, " target yet")
  fail TaskError { message: move message, status: 1 }
}

effect fn npm(dir: string, arguments: &[string]) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
    let mut child = run start("npm", arguments, dir, &[])
    let code = child.wait()
    if code != 0 {
      let mut message = run String.copy("npm ")
      run String.append(&mut message, arguments[0])
      run String.append(&mut message, " failed in ")
      run String.append(&mut message, dir)
      fail TaskError { message: move message, status: code }
    }
  } else {
    run Task.abort("silkui: running Vite needs Windows subprocess support in Silk")
  }
}

/// Installs the Vite project's packages when it has none yet.
effect fn installed(dir: string) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let modules = run joined(dir, "node_modules")
  if !run exists(String.view(&modules)) {
    run say("installing the Vite project's packages")
    run npm(dir, &["install"])
  }
}

/// The program `silk build` made for the package at `dir`.
effect fn binary(dir: string, name: string, mode: Mode) -> String
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let profile = if mode == Mode.Release { "release" } else { "debug" }
  let llvm = run joined(dir, "build/llvm")
  let root = run Path.make(String.view(&llvm))
  if run FileSystem.exists(&root) {
    let entries = run FileSystem.listDirectory(&root)
    let items = List<DirectoryEntry>.asSlice(&entries)
    let mut at: usize = 0
    while at < items.length {
      let triple = Path.view(&items[at].path) |> Option<string>.unwrapOr("")
      let mut candidate = run joined(triple, profile)
      candidate = run joined(String.view(&candidate), name)
      if run exists(String.view(&candidate)) { return move candidate }
      at = at + 1
    }
  }
  run Task.abort("silkui: silk build made no program where silkui looked for it")
}

effect fn sizeOf(path: string) -> usize ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let file = run Path.make(path)
  return match run FileSystem.stat(&file) {
    FileInfo info => info.byteLength
    DirectoryInfo _info => 0
  }
}

effect fn compileHost(dir: string, mode: Mode, web: bool) -> ()
  ! TaskError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let manifest = run joined(dir, "silk.toml")
  if web {
    // The page's WebGPU host waits on the GPU through JSPI, which needs a deep stack.
    let profile = if mode == Mode.Release {
      "{\"target\":\"wasm32-unknown-unknown\",\"optimization\":\"speed\",\"debug\":false,\"stackSize\":\"8MiB\"}"
    } else {
      "{\"target\":\"wasm32-unknown-unknown\",\"optimization\":\"none\",\"debug\":true,\"stackSize\":\"8MiB\"}"
    }
    run Task.silk(&["build", "--progress", "never", "--manifest-path", String.view(&manifest), "--profile-input", profile])
  } else if mode == Mode.Release {
    run Task.silk(&["build", "--progress", "never", "--manifest-path", String.view(&manifest), "--release"])
  } else {
    run Task.silk(&["build", "--progress", "never", "--manifest-path", String.view(&manifest)])
  }
}

// --- App: the definition ---

impl App {
  /// A new app named `name`, the program a custom host ([`App.customHost`]) builds. A generated
  /// host and `dist/` take the project's name. No framework, no target yet.
  pub effect fn make(name: string<'static>) -> App {
    return App {
      named: name,
      writtenIn: Framework.Js { dir: "." },
      runsOn: Runtime.Engine,
      runtimeCss: false,
      places: List<Target>.make(),
      custom: "",
      stylePaths: List<string<'static>>.make(),
      bundled: String.make(),
      compiledSheet: String.make(),
      hosts: List<Host>.make(),
      begun: now(),
    }
  }

  /// What the app is written in. Plain JS, its Vite project at the root, until this says
  /// otherwise.
  pub effect fn framework<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, framework: Framework) -> App ! E ? R {
    let mut app = run move self
    app.writtenIn = framework
    return move app
  }

  /// What runs a JavaScript app in a window. The Engine until this says otherwise.
  pub effect fn runtime<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, runtime: Runtime) -> App ! E ? R {
    let mut app = run move self
    app.runsOn = runtime
    return move app
  }

  /// Adds a target. The first one is what `dev` launches.
  pub effect fn target<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, target: Target) -> App
    ! E | OutOfMemoryError ? R | &mut Allocator {
    let mut app = run move self
    run app.places.append(target)
    return move app
  }

  /// Includes the CSS text compiler in a release native or canvas host. Development hosts always include it.
  pub effect fn runtimeStylesheets<'env, E, ?R>(self: once Effect<'env; App ! E ? R>) -> App ! E ? R {
    let mut app = run move self
    app.runtimeCss = true
    return move app
  }

  /// Adds a CSS file, relative to the project root. Repeat to define adoption
  /// order. Any Tailwind, Sass or PostCSS processing happens before this step.
  pub effect fn stylesheet<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, path: string<'static>) -> App
    ! E | OutOfMemoryError ? R | &mut Allocator {
    let mut app = run move self
    run app.stylePaths.append(path)
    return move app
  }

  /// The escape hatch: the project's own host package at `dir` (relative to the project) is
  /// built instead of a generated one, for every target. It gets no bundle copied in.
  pub effect fn customHost<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, dir: string<'static>) -> App ! E ? R {
    let mut app = run move self
    app.custom = dir
    return move app
  }

  pub fn name(self: &App) -> string<'static> { return self.named }
  pub fn frameworkOf(self: &App) -> Framework { return self.writtenIn }
  pub fn targets(self: &App) -> &[Target] { return self.places.asSlice() }

  fn sheetCount(self: &App) -> usize {
    let bundled: usize = if String.view(&self.compiledSheet) == "" { 0 } else { 1 }
    return self.stylePaths.length() + bundled
  }

  // --- App: the steps ---

  /// Keeps only the target `id` when it is not empty (a `--target` flag), and fails naming
  /// the targets there are when the app has no such target.
  pub effect fn only<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, id: string) -> App
    ! E | TaskError | OutOfMemoryError ? R | &mut Allocator {
    let mut app = run move self
    if id == "" { return move app }
    let mut kept = List<Target>.make()
    let all = app.places.asSlice()
    let mut names = String.make()
    let mut at: usize = 0
    while at < all.length {
      if all[at].id() == id { run kept.append(all[at]) }
      if at > 0 { run String.append(&mut names, ", ") }
      run String.append(&mut names, all[at].id())
      at = at + 1
    }
    if kept.length() == 0 {
      let mut message = run String.copy("silkui: the app has no target ")
      run String.append(&mut message, id)
      run String.append(&mut message, "; it has ")
      if all.length == 0 { run String.append(&mut message, "none") } else { run String.append(&mut message, String.view(&names)) }
      fail TaskError { message: move message, status: 2 }
    }
    app.places = move kept
    return move app
  }

  /// Runs Vite for a JavaScript app: `vite build` into `.silk/bundle/app.js`, out of the way of
  /// `dist/` when the Vite project is the project root. In
  /// `Mode.Dev` on the Engine it only installs the packages, because the development server
  /// serves the modules to the window. Does nothing for a Loom app.
  pub effect fn bundle<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, mode: Mode) -> App
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut app = run move self
    let dir = app.writtenIn.dir()
    if dir == "" { return move app }
    let project = run readProject()
    let web = run fromRoot(&project, dir)
    run installed(String.view(&web))
    let out = run fromRoot(&project, ".silk/bundle")
    app.bundled = run joined(String.view(&out), "app.js")
    app.compiledSheet = String.make()
    if mode == Mode.Dev && app.runsOn == Runtime.Engine { return move app }
    if dir == "." { run say("bundling with Vite") } else {
      let mut line = run String.copy("bundling ")
      run String.append(&mut line, dir)
      run String.append(&mut line, "/ with Vite")
      run say(String.view(&line))
    }
    let viteMode = if mode == Mode.Release { "production" } else { "development" }
    run npm(String.view(&web), &["exec", "--", "vite", "build", "--mode", viteMode, "--outDir", String.view(&out), "--emptyOutDir"])
    let sheet = run joined(String.view(&out), "app.sheet")
    if run exists(String.view(&sheet)) { app.compiledSheet = move sheet }
    return move app
  }

  /// Writes the Silk host of each target into `.silk/<target>/`: a manifest, a `main.silk`
  /// of a few lines and, for a release JavaScript host, the bundle it embeds. `Mode.Dev`
  /// hosts have the development tools. Fails for a framework and target silkui cannot
  /// build yet.
  pub effect fn host<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, mode: Mode) -> App
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut app = run move self
    let project = run readProject()
    app.hosts = List<Host>.make()
    let targets = app.places.asSlice()
    if targets.length == 0 { run Task.abort("silkui: the app has no target: add one with App.target") }
    let mut at: usize = 0
    while at < targets.length {
      let target = targets[at]
      if app.custom != "" {
        if app.sheetCount() != 0 { run Task.abort("silkui: stylesheets need a generated host; a custom host adopts its compiled sheets directly") }
        if target.web() { run Task.abort("silkui: a custom host builds the window target only") }
        run app.hosts.append(Host { target: target, dir: run fromRoot(&project, app.custom), generated: false })
        at = at + 1
        continue
      }
      let mut window = Window { title: "", width: 0.0, height: 0.0 }
      let mut bar = TitleBar.Standard
      match target {
        Target.Window { window: options, bar: chosen } => {
          window = options
          bar = chosen
        }
        Target.WebCanvas { page } => { window.title = page.title }
        Target.WebDom { page } => { window.title = page.title }
      }
      // The browser runs JavaScript apps against a wasm tree, which silkui does not set up yet.
      if target.web() && app.writtenIn.id() != "loom" { run unsupported(&app.writtenIn, &target, app.runsOn) }
      let kind = match app.writtenIn {
        Framework.Loom { .. } => Kind.Loom
        _ => if app.runsOn == Runtime.Node { Kind.Node } else { Kind.Engine }
      }
      let mut module = ""
      let mut command = ""
      if let Framework.Loom { module: named, command: commands } = app.writtenIn {
        module = named
        command = commands
      }
      if let Framework.Loom { command: commands, .. } = app.writtenIn {
        if target.id() == "web-dom" && commands != "" {
          run Task.abort("silkui cannot build Loom apps with commands for the web-dom target yet: the page has no shell for them")
        }
      }
      let plan = Plan {
        target: target.id(),
        kind: kind,
        dev: mode == Mode.Dev,
        title: window.title,
        width: window.width,
        height: window.height,
        transparentTitleBar: match bar {
          TitleBar.Standard => false
          TitleBar.Transparent { .. } => true
        },
        titleBarHeight: match bar {
          TitleBar.Standard => 0.0
          TitleBar.Transparent { height, .. } => height
        },
        controlsLeft: match bar {
          TitleBar.Standard => 0.0
          TitleBar.Transparent { left, .. } => left
        },
        controlsTop: match bar {
          TitleBar.Standard => 0.0
          TitleBar.Transparent { top, .. } => top
        },
        module: module,
        command: command,
        stylesheets: app.sheetCount(),
        runtimeCss: app.runtimeCss,
      }
      let mut dir = run fromRoot(&project, ".silk")
      dir = run joined(String.view(&dir), target.id())
      run stylesheets.emitWithCompiled(String.view(&project.root), app.stylePaths.asSlice(), String.view(&dir), target.id() == "web-dom", String.view(&app.compiledSheet))
      if mode == Mode.Dev && target.id() != "web-dom" && app.sheetCount() != 0 {
        let update = if target.web() { run String.copy("/styles.update") } else { run joined(String.view(&dir), "styles.update") }
        run refresh(String.view(&run joined(String.view(&dir), "styles.path")), String.view(&update))
      }
      let toml = run joined(String.view(&dir), "silk.toml")
      run refresh(String.view(&toml), String.view(&run manifest(&project, &plan)))
      let main = run joined(String.view(&dir), "src/main.silk")
      run refresh(String.view(&main), String.view(&run hostMain(&plan)))
      if target.id() == "web-canvas" {
        run refresh(String.view(&run joined(String.view(&dir), "src/webgpu_exports.silk")), String.view(&run webgpuExports()))
        run refresh(String.view(&run joined(String.view(&dir), "src/libm.silk")), String.view(&run libm()))
      }
      if target.web() {
        run refresh(String.view(&run joined(String.view(&dir), "index.html")), String.view(&run hostPage(&plan)))
      }
      if kind != Kind.Loom && mode != Mode.Dev {
        let copy = run joined(String.view(&dir), "app.js")
        let source = run Path.make(String.view(&app.bundled))
        if !run FileSystem.exists(&source) { run Task.abort("silkui: there is no bundle to embed: run App.bundle before App.host") }
        let bytes = run FileSystem.readFile(&source)
        let destination = run Path.make(String.view(&copy))
        run FileSystem.writeFileWithParents(&destination, Bytes.asSlice(&bytes))
      }
      // The folder is the tasks' own output: keep it out of version control.
      let ignore = run fromRoot(&project, ".silk/.gitignore")
      run refresh(String.view(&ignore), "*\n")
      run app.hosts.append(Host { target: target, dir: move dir, generated: true })
      at = at + 1
    }
    return move app
  }

  /// Runs `silk build` on each host: a native program per window target.
  pub effect fn compile<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, mode: Mode) -> Built
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let app = run move self
    if app.hosts.length() == 0 { run Task.abort("silkui: there is no host to compile: run App.host before App.compile") }
    let project = run readProject()
    let mut artifacts = List<Artifact>.make()
    let hosts = app.hosts.asSlice()
    let mut at: usize = 0
    while at < hosts.length {
      let dir = String.view(&hosts[at].dir)
      let mut what = run String.copy(hosts[at].target.id())
      run String.append(&mut what, " host")
      let mut line = run String.copy("compiling the ")
      run String.append(&mut line, String.view(&what))
      if mode == Mode.Release { run String.append(&mut line, " (release)") }
      if mode == Mode.Debug { run String.append(&mut line, " (debug)") }
      run String.append(&mut line, "...")
      run say(String.view(&line))
      let started = now()
      run compileHost(dir, mode, hosts[at].target.web())
      let mut compiled = run String.copy("compiled the ")
      run String.append(&mut compiled, String.view(&what))
      done(String.view(&compiled), started)
      // A generated host is named after the project and the target; a custom one after the app.
      let mut name = run String.copy(app.named)
      if hosts[at].generated {
        name = run hostPackageName(String.view(&project.name), hosts[at].target.id())
      }
      let path = run binary(dir, String.view(&name), mode)
      let bytes = run sizeOf(String.view(&path))
      if hosts[at].target.web() {
        let folder = run joined(dir, "site")
        run site(&project, hosts[at].target.id(), dir, String.view(&path), String.view(&folder), app.sheetCount(), mode == Mode.Dev)
        run artifacts.append(Artifact { target: hosts[at].target, path: move folder, bytes: bytes })
      } else {
        run artifacts.append(Artifact { target: hosts[at].target, path: move path, bytes: bytes })
      }
      at = at + 1
    }
    return Built { source: move app, root: run String.copy(String.view(&project.root)), madeIn: mode, outputs: move artifacts }
  }

  /// [`App.bundle`], [`App.host`] and [`App.compile`], in order. Most projects only use this.
  pub effect fn build<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, mode: Mode) -> Built
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    return run move self |> App.bundle(mode) |> App.host(mode) |> App.compile(mode)
  }

  /// Runs `f` on the app and passes it on unchanged.
  pub effect fn tap<'env, E, ?R>(self: once Effect<'env; App ! E ? R>, f: once fn<'env>(&App) -> ()) -> App ! E ? R {
    let app = run move self
    f(&app)
    return move app
  }

  /// The app `f` makes of it.
  pub effect fn map<'env, E, F, ?R, ?S>(self: once Effect<'env; App ! E ? R>, f: once effect fn<'env>(App) -> App ! F ? S) -> App ! E | F ? R | S {
    let app = run move self
    return run f(move app)
  }
}

// --- Built ---

impl Built {
  pub fn app(self: &Built) -> &App { return &self.source }
  pub fn mode(self: &Built) -> Mode { return self.madeIn }
  pub fn artifacts(self: &Built) -> &[Artifact] { return self.outputs.asSlice() }

  /// Writes each artifact's path and size to standard error. [`Built.write`] lists what it
  /// wrote the same way.
  pub fn sizes(self: &Built) -> () {
    let all = self.outputs.asSlice()
    let mut at: usize = 0
    while at < all.length {
      listArtifact(relative(String.view(&self.root), String.view(&all[at].path)), all[at].bytes)
      at = at + 1
    }
  }

  /// The artifacts but the one for target `id`.
  pub effect fn without(self: Built, id: string) -> Built ! OutOfMemoryError ? &mut Allocator {
    let mut built = move self
    let mut kept = List<Artifact>.make()
    while built.outputs.length() > 0 {
      let artifact = built.outputs.remove(0)
      if artifact.target.id() != id { run kept.append(move artifact) }
    }
    built.outputs = move kept
    return move built
  }

  /// Copies each artifact to `<dir>/<target>/<project name>` (relative to the project), and
  /// the page of a web target to `<dir>/<target>/`, and lists them with the build's time. It
  /// ends a build pipeline.
  pub effect fn write<'env, E, ?R>(self: once Effect<'env; Built ! E ? R>, dir: string) -> ()
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let built = run move self
    let project = run readProject()
    let all = built.outputs.asSlice()
    let mut at: usize = 0
    while at < all.length {
      let mut out = run fromRoot(&project, dir)
      out = run joined(String.view(&out), all[at].target.id())
      let folder = run Path.make(String.view(&out))
      run FileSystem.createDirectoriesRecursively(&folder)
      if all[at].target.web() {
        // The page's folder, as it is: a static site.
        let from = run joined(String.view(&all[at].path), ".")
        run Task.exec("cp", &["-R", String.view(&from), String.view(&out)])
      } else {
        // cp keeps the program's mode, so it stays executable. It takes the project's name,
        // which `silk init` gives the package.
        out = run joined(String.view(&out), String.view(&project.name))
        run Task.exec("cp", &["-p", String.view(&all[at].path), String.view(&out)])
      }
      if at == 0 { StderrWriter.print("\n", &.()) }
      listArtifact(relative(String.view(&project.root), String.view(&out)), all[at].bytes)
      at = at + 1
    }
    finished(String.view(&project.name), built.source.begun)
    drop built
  }

  /// Starts the app on its first target: for a JavaScript app in `Mode.Dev` on the Engine,
  /// Vite's development server, which opens the window and replaces edited modules in it;
  /// for a web target, a server for its page on the loopback address; otherwise the program
  /// itself.
  pub effect fn launch<'env, E, ?R>(self: once Effect<'env; Built ! E ? R>) -> Running
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let built = run move self
    static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
      if built.outputs.length() == 0 { run Task.abort("silkui: nothing was built to launch") }
      let project = run readProject()
      let artifact = &built.outputs.asSlice()[0]
      let target = artifact.target
      let dir = built.source.writtenIn.dir()
      if target.web() {
        let server = run Server.open(String.view(&artifact.path), 8090)
        return Running { launched: move built, target: target, vite: false, child: Option<Child>.None, server: Option<Server>.Some { value: move server } }
      }
      let vite = dir != "" && built.madeIn == Mode.Dev && built.source.runsOn == Runtime.Engine
      let child = if vite {
        let web = run fromRoot(&project, dir)
        run say("starting Vite's development server")
        run start("npm", &["exec", "--", "vite"], String.view(&web), &[Variable { name: "SILKUI_HOST", value: String.view(&artifact.path) }])
      } else if dir != "" && built.madeIn == Mode.Dev {
        run start(String.view(&artifact.path), &[String.view(&built.source.bundled)], String.view(&project.root), &[])
      } else if built.madeIn == Mode.Dev {
        // A new session starts from `init`; the restarts after edits keep the model.
        let kept = run keptModel(&built.source.hosts.asSlice()[0])
        let file = run Path.make(String.view(&kept))
        if run FileSystem.exists(&file) { run FileSystem.removeFile(&file) }
        run start(String.view(&artifact.path), &[], String.view(&project.root), &[Variable { name: KEEP_VARIABLE, value: String.view(&kept) }])
      } else {
        run start(String.view(&artifact.path), &[], String.view(&project.root), &[])
      }
      return Running { launched: move built, target: target, vite: vite, child: Option<Child>.Some { value: move child }, server: Option<Server>.None }
    } else {
      run Task.abort("silkui: launching needs Windows subprocess support in Silk")
    }
  }

  /// Runs `f` on the built app and passes it on unchanged.
  pub effect fn tap<'env, E, ?R>(self: once Effect<'env; Built ! E ? R>, f: once fn<'env>(&Built) -> ()) -> Built ! E ? R {
    let built = run move self
    f(&built)
    return move built
  }

  /// The built app `f` makes of it, such as `built.without("web-dom")`.
  pub effect fn map<'env, E, F, ?R, ?S>(self: once Effect<'env; Built ! E ? R>, f: once effect fn<'env>(Built) -> Built ! F ? S) -> Built ! E | F ? R | S {
    let built = run move self
    return run f(move built)
  }
}

// --- Running ---

static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
  /// A fingerprint of the files under `dir`: their paths, sizes and contents, folded.
  effect fn fingerprint(dir: &Path, hash: &mut u64, excluded: &[Path]) -> ()
    ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
    let entries = run FileSystem.listDirectory(dir)
    let items = List<DirectoryEntry>.asSlice(&entries)
    let mut at: usize = 0
    while at < items.length {
      let name = Path.name(&items[at].path) |> Option<string>.unwrapOr("")
      if items[at].kind.code == 1 && name != "build" && !String.startsWith(name, ".") {
        run fingerprint(&items[at].path, &mut hash, excluded)
      } else if items[at].kind.code == 0 {
        let mut skip = false
        let mut index: usize = 0
        while index < excluded.length {
          if Path.view(&items[at].path).unwrapOr("") == Path.view(&excluded[index]).unwrapOr("") { skip = true }
          index = index + 1
        }
        if skip {
          at = at + 1
          continue
        }
        let bytes = run FileSystem.readFile(&items[at].path)
        fold(&mut hash, Path.rawBytes(&items[at].path))
        fold(&mut hash, Bytes.asSlice(&bytes))
      }
      at = at + 1
    }
  }

  fn fold(hash: &mut u64, bytes: &[u8]) -> () {
    let mut at: usize = 0
    let mut value = hash.*
    while at < bytes.length {
      value = ((value ^ u8.toU64(bytes[at])) * 16777619) & 4294967295
      at = at + 1
    }
    hash.* = value
  }

  effect fn sources(project: &Project, css: &[string<'static>]) -> u64
    ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
    let mut hash: u64 = 2166136261
    let mut excluded = List<Path>.make()
    let mut at: usize = 0
    while at < css.length {
      run excluded.append(run stylesheets.sourcePath(String.view(&project.root), css[at]))
      at = at + 1
    }
    let src = run Path.make(String.view(&run joined(String.view(&project.root), String.view(&project.source))))
    if run FileSystem.exists(&src) { run fingerprint(&src, &mut hash, excluded.asSlice()) }
    return hash
  }
}

/// `before`, the Silk source directory, then `after`.
effect fn sourceNote(project: &Project, before: string, after: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut note = run String.copy(before)
  run String.append(&mut note, String.view(&project.source))
  run String.append(&mut note, after)
  return move note
}

effect fn ended(code: i32) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  if code == 0 { return () }
  let mut message = run String.copy("the app ended with status ")
  let mut digits = String.make()
  let mut value = code
  if value < 0 { value = 0 - value }
  if value == 0 { run String.append(&mut digits, "0") }
  while value > 0 {
    let mut one = run String.copy(String.slice("0123456789", i32.toUsize(value % 10), 1))
    run String.append(&mut one, String.view(&digits))
    digits = move one
    value = value / 10
  }
  run String.append(&mut message, String.view(&digits))
  fail TaskError { message: move message, status: code }
}

/// The variable that names the file a Loom development host keeps its model in across the
/// restarts after edits (loom-window's `keeper`).
const KEEP_VARIABLE: string<'static> = "SILKUI_KEEP"

/// Where a Loom development host keeps its model: beside the host it runs.
effect fn keptModel(host: &Host) -> String ! OutOfMemoryError ? &mut Allocator {
  return run joined(String.view(&host.dir), "model.json")
}

/// Refreshes generated assets before rebuilding, including edits made during development.
effect fn rebuildHost(project: &Project, host: &Host, sheets: &[string<'static>]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run stylesheets.emit(String.view(&project.root), sheets, String.view(&host.dir), host.target.id() == "web-dom")
  run compileHost(String.view(&host.dir), Mode.Dev, host.target.web())
}

/// Builds a web host again and puts the new program in its page's folder.
effect fn rebuildPage(project: &Project, host: &Host, artifact: &Artifact, sheets: &[string<'static>]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let dir = String.view(&host.dir)
  run rebuildHost(project, host, sheets)
  let name = run hostPackageName(String.view(&project.name), host.target.id())
  let wasm = run binary(dir, String.view(&name), Mode.Dev)
  run site(project, host.target.id(), dir, String.view(&wasm), String.view(&artifact.path), sheets.length, true)
}

impl Running {
  pub fn built(self: &Running) -> &Built { return &self.launched }

  /// Keeps the app running until its window closes, or for a web target serves its page
  /// until the task is stopped. Fails when the program ends with a nonzero status.
  /// For a JavaScript app in `Mode.Dev`, Vite replaces edited modules in place. For a Loom
  /// app in `Mode.Dev`, a change in the Silk sources (`src/`, or the
  /// manifest's `source`) rebuilds the host and restarts the app (a page
  /// reloads itself); after a build that fails, the previous build runs.
  pub effect fn watch<'env, E, ?R>(self: once Effect<'env; Running ! E ? R>) -> ()
    ! E | TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? R | &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut running = run move self
    static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
      let loom = running.launched.source.writtenIn.id() == "loom"
      let rebuilds = loom && running.launched.madeIn == Mode.Dev
      let project = run readProject()
      let mut seen = run sources(&project, running.launched.source.stylePaths.asSlice())
      if running.target.web() {
        let mut server = match move Intrinsic.replace(running.server, Option<Server>.None) {
          Option<Server>.Some { value } => move value
          Option<Server>.None => run Task.abort("silkui: the page has no server")
        }
        let watchesStyles = rebuilds && running.launched.source.stylePaths.length() != 0
        let mut styled = Option<u64>.None
        if rebuilds { run say(String.view(&run sourceNote(&project, "watching ", "/ for changes"))) }
        if watchesStyles { run say("watching stylesheets: CSS edits preserve application state") }
        while true {
          run server.serveFor(300)
          if watchesStyles {
            let current = run Effect.result(stylesheets.fingerprint(String.view(&project.root), running.launched.source.stylePaths.asSlice()))
            match move current {
              Result.Success { value: fingerprint } => {
                if styled.isNone() || fingerprint != styled.unwrapOr(0) {
                  styled = Option<u64>.Some { value: fingerprint }
                  let artifact = &running.launched.outputs.asSlice()[0]
                  let updated = run Effect.result(stylesheets.emit(String.view(&project.root), running.launched.source.stylePaths.asSlice(), String.view(&artifact.path), running.target.id() == "web-dom"))
                  match move updated {
                    Result.Success { .. } => { server.styles = server.styles + 1 }
                    Result.Failure { error } => {
                      drop error
                      run say("stylesheet update failed: the page keeps its previous styles")
                    }
                  }
                }
              }
              Result.Failure { error } => { drop error }
            }
          }
          if !rebuilds { continue }
          let now = run sources(&project, running.launched.source.stylePaths.asSlice())
          if now == seen { continue }
          seen = now
          run say(String.view(&run sourceNote(&project, "", "/ changed: rebuilding")))
          let artifact = &running.launched.outputs.asSlice()[0]
          let host = &running.launched.source.hosts.asSlice()[0]
          let rebuilt = run Effect.result(rebuildPage(&project, host, artifact, running.launched.source.stylePaths.asSlice()))
          match move rebuilt {
            Result.Success { .. } => { server.build = server.build + 1 }
            Result.Failure { error } => {
              drop error
              run say("the build failed: the page keeps the previous build until the next change")
            }
          }
        }
        return ()
      }
      let mut child = match move Intrinsic.replace(running.child, Option<Child>.None) {
        Option<Child>.Some { value } => move value
        Option<Child>.None => run Task.abort("silkui: the app has no program running")
      }
      let watchesStyles = running.launched.madeIn == Mode.Dev && running.launched.source.stylePaths.length() != 0
      if !rebuilds && !watchesStyles { return run ended(child.wait()) }
      if rebuilds { run say(String.view(&run sourceNote(&project, "watching ", "/ for changes"))) }
      if watchesStyles { run say("watching stylesheets: CSS edits preserve application state") }
      let mut styled = Option<u64>.None
      while !child.ended() {
        pause(300)
        if watchesStyles {
          let current = run Effect.result(stylesheets.fingerprint(String.view(&project.root), running.launched.source.stylePaths.asSlice()))
          match move current {
            Result.Success { value: fingerprint } => {
              if styled.isNone() || fingerprint != styled.unwrapOr(0) {
                styled = Option<u64>.Some { value: fingerprint }
                let host = &running.launched.source.hosts.asSlice()[0]
                let updated = run Effect.result(stylesheets.emitWithCompiled(String.view(&project.root), running.launched.source.stylePaths.asSlice(), String.view(&host.dir), false, String.view(&running.launched.source.compiledSheet)))
                if let Result<(), TaskError | FileError | OutOfMemoryError>.Failure { error } = move updated {
                  drop error
                  run say("stylesheet update failed: the application keeps its previous styles")
                }
              }
            }
            Result.Failure { error } => { drop error }
          }
        }
        if !rebuilds { continue }
        let now = run sources(&project, running.launched.source.stylePaths.asSlice())
        if now == seen { continue }
        seen = now
        run say(String.view(&run sourceNote(&project, "", "/ changed: rebuilding")))
        let artifact = &running.launched.outputs.asSlice()[0]
        let host = &running.launched.source.hosts.asSlice()[0]
        // The program is linked in place, so it stops before the build. A failed build
        // leaves the previous program, which starts again.
        child.stop()
        let rebuilt = run Effect.result(rebuildHost(&project, host, running.launched.source.stylePaths.asSlice()))
        if let Result<(), TaskError | FileError | HostInputError | OutOfMemoryError>.Failure { error } = move rebuilt {
          drop error
          run say("the build failed: the previous build runs until the next change")
        }
        let kept = run keptModel(host)
        child = run start(String.view(&artifact.path), &[], String.view(&project.root), &[Variable { name: KEEP_VARIABLE, value: String.view(&kept) }])
      }
      return run ended(child.wait())
    } else {
      drop running
      run Task.abort("silkui: watching needs Windows subprocess support in Silk")
    }
  }

  /// Runs `f` on the running app and passes it on unchanged.
  pub effect fn tap<'env, E, ?R>(self: once Effect<'env; Running ! E ? R>, f: once fn<'env>(&Running) -> ()) -> Running ! E ? R {
    let running = run move self
    f(&running)
    return move running
  }
}
