//! Selector identity lives off the node record; class atoms are stable across all UI roots.
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import svg_css.tokens { equal, TokenBuffer }
import mutation { StyleState }
import selection { Selection }
import silk.mem.box { Box }
import svg_css.element { PseudoTarget }
import silk.num.u32

pub struct CustomValue { pub state: StyleState, pub name: String, pub tokens: TokenBuffer, pub important: bool }

pub struct NamedAttribute { pub name: String, pub value: String }

pub struct NodeIdentity {
  pub selection: Option<Box<Selection>>,
  pub containerNames: List<Bytes>,
  pub generatedOrigin: u32,
  pub generatedTarget: PseudoTarget,
  pub before: u32,
  pub after: u32,
  pub custom: List<CustomValue>,
  pub tag: String,
  pub id: String,
  pub classes: String,
  pub hasId: bool,
  pub hasClasses: bool,
  /// Sorted unique atom ids, so class order and repeated tokens do not change sharing keys.
  pub classAtoms: List<usize>,
  pub attributes: List<NamedAttribute>,
}

impl NodeIdentity {
  pub fn clearCustom(self: &mut Self, state: StyleState) -> () {
    let mut i = self.custom.length()
    while i > 0 {
      i = i - 1
      if self.custom.asSlice()[i].state == state { drop self.custom.remove(i) }
    }
  }
  pub effect fn setCustom(self: &mut Self, state: StyleState, name: String, tokens: Option<TokenBuffer>, important: bool) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.custom.length() {
      let item = &self.custom.asSlice()[i]
      if item.state == state && String.view(&item.name) == String.view(&name) { break }
      i = i + 1
    }
    match move tokens {
      Option<TokenBuffer>.Some { value } => {
        let item = CustomValue { state: state, name: move name, tokens: move value, important: important }
        if i == self.custom.length() { run self.custom.append(move item) }
        else { let items = self.custom.asMutSlice()
          items[i] = move item }
      }
      _ => { if i < self.custom.length() { drop self.custom.remove(i) } }
    }
  }

  pub effect fn set(self: &mut Self, name: String, value: Option<String>) -> ()
    ! OutOfMemoryError ? &mut Allocator {
    let mut index: usize = 0
    while index < self.attributes.length() {
      if String.view(&self.attributes.asSlice()[index].name) == String.view(&name) { break }
      index = index + 1
    }
    match move value {
      Option<String>.Some { value: text } => {
        if index < self.attributes.length() { let items = self.attributes.asMutSlice()
          items[index].value = move text
        }
        else { run self.attributes.append(NamedAttribute { name: move name, value: move text }) }
      }
      Option<String>.None => {
        if index < self.attributes.length() { drop self.attributes.remove(index) }
      }
    }
  }

  pub fn make() -> Self {
    return NodeIdentity { selection: Option<Box<Selection>>.None, containerNames: List<Bytes>.make(), generatedOrigin: u32.MAX, generatedTarget: PseudoTarget.None, before: u32.MAX, after: u32.MAX,
      custom: List<CustomValue>.make(), tag: String.make(), id: String.make(), classes: String.make(),
      hasId: false, hasClasses: false, classAtoms: List<usize>.make(), attributes: List<NamedAttribute>.make() }
  }
}

pub struct Atoms { names: List<Bytes> }
fn space(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13 }

impl Atoms {
  pub fn make() -> Self { return Atoms { names: List<Bytes>.make() } }

  pub effect fn intern(self: &mut Self, text: &[u8]) -> usize ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.names.length() {
      if equal(self.names.asSlice()[i].asSlice(), text) { return i }
      i = i + 1
    }
    let index = self.names.length()
    run self.names.append(run Bytes.copy(text))
    return index
  }

  pub fn text(self: &Self, atom: usize) -> &[u8] { return self.names.asSlice()[atom].asSlice() }

  pub effect fn classes(self: &mut Self, text: &[u8]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<usize>.make()
    let mut at: usize = 0
    while at < text.length {
      while at < text.length && space(text[at]) { at = at + 1 }
      let start = at
      while at < text.length && !space(text[at]) { at = at + 1 }
      if at > start {
        let atom = run self.intern(Slice.view<u8>(text, start, at - start))
        let mut i: usize = 0
        while i < result.length() && result.asSlice()[i] < atom { i = i + 1 }
        if i == result.length() || result.asSlice()[i] != atom {
          run result.append(atom)
          let mut end = result.length() - 1
          let items = result.asMutSlice()
          while end > i { items[end] = items[end - 1]
            end = end - 1
          }
          items[i] = atom
        }
      }
    }
    return move result
  }
}
