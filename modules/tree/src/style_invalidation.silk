import svg_css.adopted { StyleSheets }
import svg_css.sheet { ConditionKind, NONE }
import svg_css.selectors { Dependency, DependencyKind, Sharing, SubjectKind }
import svg_css.ancestor_filter
import svg_css.ancestor_filter { NameKind }
import svg_css.element { PseudoTarget }
import svg_css.tokens { equal, insensitive }
import style_identity { Atoms }
import node { Node }
import mutation { StyleState }
import silk.collections.hash { Hash }
import silk.collections.hash_set { HashSet }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.core.ownership { Copy }

pub struct StartingSubjects { all: bool, classes: HashSet<usize> }

impl StartingSubjects {
  pub fn make() -> Self { return StartingSubjects { all: true, classes: HashSet<usize>.make(Hash.seed(5413)) } }

  pub effect fn collect(sheets: &StyleSheets, atoms: &mut Atoms) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut result = StartingSubjects.make()
    let mut index: usize = 0
    while index < sheets.sheets().length {
      let sheet = &sheets.sheets()[index].sheet
      let mut rule: usize = 0
      while rule < sheet.ruleConditions.length() {
        let mut condition = sheet.ruleConditions.asSlice()[rule]
        while condition != NONE && sheet.conditions.asSlice()[condition].kind != ConditionKind.Starting {
          condition = sheet.conditions.asSlice()[condition].parent
        }
        if condition != NONE {
          let entry = &sheet.resolver.rules()[rule]
          let mut keys = entry.selectors.subjectKeys()
          while let Option.Some { value } = keys.next() {
            if value.target != PseudoTarget.None || value.kind == SubjectKind.Never { continue }
            if value.kind != SubjectKind.Class { return move result }
            let atom = run atoms.intern(sheet.buffers.asSlice()[entry.buffer].text(value.text))
            drop run result.classes.insert(atom)
          }
        }
        rule = rule + 1
      }
      index = index + 1
    }
    result.all = false
    return move result
  }

  pub fn mayMatch(self: &Self, node: &Node) -> bool {
    if self.all { return true }
    if let Option.Some { value } = node.identity() {
      let classes = value.classAtoms()
      let mut index: usize = 0
      while index < classes.length {
        if self.classes.contains(classes[index]) { return true }
        index = index + 1
      }
      index = 0
      while index < value.custom().length {
        if value.custom()[index].state == StyleState.Starting { return true }
        index = index + 1
      }
    }
    return false
  }
}

/// State bits by how far a change of that state reaches beyond the element itself, and what
/// else the adopted rules depend on. `has` states are read by a rule with `:has()`: they reach
/// the anchors above the element (`UiTree.restyleAnchors`).
pub struct States {
  pub descendants: u32, pub siblings: u32, pub has: u32, pub any: u32,
  /// A rule with `:has()` also has `+` or `~`: a changed anchor reaches its siblings.
  pub wide: bool,
  /// Some rule reads an attribute other than `class`, or an id.
  pub attributes: bool,
  /// Some rule reads what the host derives from attributes without naming them: `:lang()`
  /// from `lang`, `:link` from `href`.
  pub derived: bool,
}
impl Copy for States {}
impl States {
  pub fn make() -> States { return States { descendants: 0, siblings: 0, has: 0, any: 0, wide: false, attributes: false, derived: false } }
}

/// How far a change reaches beyond the element itself: nothing, the descendants that carry one
/// of `Extent.keys`, the element's subtree, its parent's subtree or the root.
pub enum Reach { None, Descendants, Subtree, Siblings, Root }

const KEYS: u32 = 8

/// What a changed selector input restyles: the element itself when `own`, `reach` from it, and,
/// when `anchors`, the `:has()` anchors that can see the element. Keys are
/// `ancestor_filter.key` values of the subjects a `Descendants` reach restyles.
pub struct Extent { pub reach: Reach, pub anchors: bool, pub own: bool, pub count: u32, pub keys: [u32; 8] }
impl Copy for Extent {}
impl Extent {
  pub fn none() -> Extent { return Extent { reach: Reach.None, anchors: false, own: false, count: 0, keys: [0; 8] } }
  pub fn of(reach: Reach) -> Extent {
    let mut result = Extent.none()
    result.reach = reach
    return result
  }
  pub fn itself() -> Extent {
    let mut result = Extent.none()
    result.own = true
    return result
  }

  fn key(self: &mut Self, value: u32) -> () {
    if rank(self.reach) > rank(Reach.Descendants) { return () }
    let mut i: u32 = 0
    while i < self.count {
      if self.keys[u32.toUsize(i)] == value { return () }
      i = i + 1
    }
    if self.count == KEYS {
      self.reach = Reach.Subtree
      return ()
    }
    self.keys[u32.toUsize(self.count)] = value
    self.count = self.count + 1
    self.reach = Reach.Descendants
  }

  pub fn with(self: &Self, other: Extent) -> Extent {
    let mut result = self.*
    result.reach = wider(self.reach, other.reach)
    result.anchors = self.anchors || other.anchors
    result.own = self.own || other.own
    if other.reach == Reach.Descendants {
      let mut i: u32 = 0
      while i < other.count {
        result.key(other.keys[u32.toUsize(i)])
        i = i + 1
      }
    }
    return result
  }
}

fn rank(reach: Reach) -> u32 {
  return match reach { Reach.None => 0 Reach.Descendants => 1 Reach.Subtree => 2 Reach.Siblings => 3 Reach.Root => 4 }
}

pub fn wider(a: Reach, b: Reach) -> Reach { return if rank(a) >= rank(b) { a } else { b } }

pub fn states(sheets: &StyleSheets) -> States {
  let mut result = States.make()
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let sheet = &sheets.sheets()[i].sheet
    let rules = sheet.resolver.rules()
    let mut rule: usize = 0
    while rule < rules.length {
      let dependencies = sheet.resolver.invalidation(rule)
      let buffer = &sheet.buffers.asSlice()[rules[rule].buffer]
      let mut at: usize = 0
      while at < dependencies.length {
        let dependency = dependencies[at]
        result.any = u32.bitOr(result.any, dependency.states)
        if dependency.ancestors {
          result.has = u32.bitOr(result.has, dependency.states)
          if dependency.siblings { result.wide = true }
        }
        // A state the subject reads restyles that element alone; variables it declares reach
        // the subtree through the element's new scope.
        if dependency.siblings && !dependency.subject { result.siblings = u32.bitOr(result.siblings, dependency.states) }
        if dependency.descendants && !dependency.subject { result.descendants = u32.bitOr(result.descendants, dependency.states) }
        if dependency.kind == DependencyKind.Id || (dependency.kind == DependencyKind.Attribute && !insensitive(buffer.text(dependency.name), b"class")) {
          result.attributes = true
        }
        if dependency.kind == DependencyKind.Host { result.derived = true }
        at = at + 1
      }
      rule = rule + 1
    }
    i = i + 1
  }
  return result
}

/// The `READS_*` relations of every adopted rule: what a match can depend on besides the
/// element's own identity and state and those of its ancestors.
pub fn reads(sheets: &StyleSheets) -> u32 {
  let mut result: u32 = 0
  let mut i: usize = 0
  while i < sheets.sheets().length {
    result = u32.bitOr(result, sheets.sheets()[i].sheet.resolver.reads())
    i = i + 1
  }
  return result
}

/// The `Sharing` bounds of every adopted rule.
pub fn sharing(sheets: &StyleSheets) -> Sharing {
  let mut result = Sharing.none()
  let mut i: usize = 0
  while i < sheets.sheets().length {
    result = result.with(sheets.sheets()[i].sheet.resolver.sharing())
    i = i + 1
  }
  return result
}

fn contains(atoms: &Atoms, values: &[usize], name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < values.length {
    if equal(atoms.text(values[i]), name) { return true }
    i = i + 1
  }
  return false
}

/// One changed selector input: the class lists before and after, or attribute names (an id
/// change also gives the two ids).
struct Probe<'a> { classes: bool, atoms: &'a Atoms, before: &'a [usize], after: &'a [usize], names: &'a [&'a [u8]], ids: &'a [&'a [u8]] }

fn named(names: &[&[u8]], name: &[u8]) -> bool {
  let mut i: usize = 0
  while i < names.length {
    if names[i].length != 0 && insensitive(names[i], name) { return true }
    i = i + 1
  }
  return false
}

fn touches(probe: &Probe<'_>, kind: DependencyKind, name: &[u8]) -> bool {
  if kind == DependencyKind.Attribute {
    if probe.classes { return insensitive(name, b"class") }
    return named(probe.names, name)
  }
  if kind == DependencyKind.Class {
    return probe.classes && contains(probe.atoms, probe.before, name) != contains(probe.atoms, probe.after, name)
  }
  if kind == DependencyKind.Id {
    let mut i: usize = 0
    while i < probe.ids.length {
      if equal(probe.ids[i], name) { return true }
      i = i + 1
    }
  }
  return false
}

fn reach(sheets: &StyleSheets, probe: &Probe<'_>, least: Extent) -> Extent {
  let mut change = least
  let mut i: usize = 0
  while i < sheets.sheets().length {
    let sheet = &sheets.sheets()[i].sheet
    let rules = sheet.resolver.rules()
    let mut rule: usize = 0
    while rule < rules.length {
      let dependencies = sheet.resolver.invalidation(rule)
      let buffer = &sheet.buffers.asSlice()[rules[rule].buffer]
      let mut at: usize = 0
      while at < dependencies.length {
        let dependency = dependencies[at]
        if touches(probe, dependency.kind, buffer.text(dependency.name)) {
          change = change.with(dependencyReach(&dependency, buffer.text(dependency.subjectName)))
        }
        at = at + 1
      }
      rule = rule + 1
    }
    i = i + 1
  }
  return change
}

/// What a change of one selector input restyles. A test on the subject restyles the element
/// alone; a test on an ancestor compound restyles the descendants that can be the subject
/// (Blink's descendant invalidation sets, Stylo's invalidation map); `:has()` and sibling
/// relations keep the coarse reach.
fn dependencyReach(dependency: &Dependency, subject: &[u8]) -> Extent {
  let mut extent = Extent.none()
  if dependency.ancestors {
    extent.anchors = true
    if dependency.subject { extent.own = true }
    else { extent.reach = if dependency.siblings { Reach.Siblings } else { Reach.Subtree } }
    return extent
  }
  if dependency.subject {
    extent.own = true
    return extent
  }
  if dependency.siblings {
    extent.reach = Reach.Siblings
    return extent
  }
  extent.own = true
  let kind = match dependency.subjectKind {
    SubjectKind.Class => NameKind.Class
    SubjectKind.Id => NameKind.Id
    SubjectKind.LocalName => NameKind.Element
    _ => {
      extent.reach = Reach.Subtree
      return extent
    }
  }
  extent.key(ancestor_filter.key(kind, subject))
  return extent
}

/// What a class change restyles besides `least`: the rules that name a class added or removed.
pub fn classReach(sheets: &StyleSheets, atoms: &Atoms, before: &[usize], after: &[usize], least: Extent) -> Extent {
  return reach(sheets, &Probe { classes: true, atoms: atoms, before: before, after: after, names: &[], ids: &[] }, least)
}

/// What rules that read one of the attributes `names` reach; an empty name is skipped. `ids`
/// are the element's id before and after, when `id` is among the names.
pub fn attributeReach(sheets: &StyleSheets, atoms: &Atoms, names: &[&[u8]], ids: &[&[u8]]) -> Extent {
  return reach(sheets, &Probe { classes: false, atoms: atoms, before: &[], after: &[], names: names, ids: ids }, Extent.none())
}
