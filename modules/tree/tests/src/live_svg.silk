//! Live svg: an icon node whose svg elements the client writes one attribute at a time draws
//! them as paths, and a frame rasterizes only the shapes whose geometry changed.
import ui_tree.legacy { UiTree, TreeError, Batch, NodeKind, FrameInput, CpuSnapshot, Input, Event, BUTTON_PRIMARY, Attribute, Mutation, StyleState }
import svg_css.compile { Options, CompileError }
import svg_css.compile
import silk.text.string { String }
import ui_tree.live_svg as live
import silk.collections.list { List }
import silk.num.f32
import ui_fixtures.fixtures as fixtures
import svg_css.written
import svg_css.tokens { CssError }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

const SVG: u32 = 2

fn viewport() -> FrameInput { return FrameInput { width: 200.0, height: 200.0, scale: 1.0, time: 0.0 } }

effect fn set(batch: &mut Batch, element: u32, name: string, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run batch.svgAttribute(SVG, element, name, Option<string>.some(value))
}

/// A 100 by 100 live svg at the origin on white: a red rect in a translated group (element 2
/// in group 1), a blue square path (3) at half opacity, and a green path (5) clipped by
/// clipPath 4 to its left half.
effect fn scene(batch: &mut Batch) -> () ! CssError | OutOfMemoryError ? &mut Allocator {
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:200px;height:200px;background-color:white")
  run batch.style(1, root.asSlice())
  run batch.create(SVG, NodeKind.Icon)
  run batch.append(1, SVG)
  let own = run written.declarations(b"display:block;width:100px;height:100px")
  run batch.style(SVG, own.asSlice())
  run set(&mut batch.*, 0, "viewBox", "0 0 100 100")
  run batch.svgInsert(SVG, 1, "g", 0, Option<u32>.None)
  run set(&mut batch.*, 1, "transform", "translate(10,10)")
  run batch.svgInsert(SVG, 2, "rect", 1, Option<u32>.None)
  run set(&mut batch.*, 2, "width", "30")
  run set(&mut batch.*, 2, "height", "30")
  run set(&mut batch.*, 2, "fill", "rgb(255,0,0)")
  run batch.svgInsert(SVG, 3, "path", 0, Option<u32>.None)
  run set(&mut batch.*, 3, "d", "M60 60h30v30h-30z")
  run set(&mut batch.*, 3, "fill", "#0000ff")
  run set(&mut batch.*, 3, "opacity", "0.5")
  run batch.svgInsert(SVG, 4, "clipPath", 0, Option<u32>.None)
  run set(&mut batch.*, 4, "id", "left")
  run batch.svgInsert(SVG, 6, "rect", 4, Option<u32>.None)
  run set(&mut batch.*, 6, "x", "60")
  run set(&mut batch.*, 6, "width", "15")
  run set(&mut batch.*, 6, "height", "40")
  run batch.svgInsert(SVG, 5, "path", 0, Option<u32>.None)
  run set(&mut batch.*, 5, "d", "M60 10h30v30h-30z")
  run set(&mut batch.*, 5, "style", "fill: #00ff00; display: block")
  run set(&mut batch.*, 5, "clip-path", "url(#left)")
}

effect fn rendered(tree: &mut UiTree<'_>) -> Pixmap ! GeometryError | OutOfMemoryError ? &mut Allocator {
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree.*)
  return run snapshot.render(&tree.*)
}

fn near(value: u8, expected: u8) -> bool {
  return (value >= expected && value - expected <= 8) || (value < expected && expected - value <= 8)
}

fn color(image: &Pixmap, x: u32, y: u32, r: u8, g: u8, b: u8) -> bool {
  let p = image.pixel(x, y)
  return near(p.r, r) && near(p.g, g) && near(p.b, b)
}

effect fn draws() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run scene(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let image = run rendered(&mut tree)
  run Testing.expect(color(&image, 25, 25, 255, 0, 0), "the rect paints red inside its translated group")
  run Testing.expect(color(&image, 5, 5, 255, 255, 255), "nothing paints outside the shapes")
  run Testing.expect(color(&image, 75, 75, 128, 128, 255), "opacity 0.5 on the path blends its blue with white")
  run Testing.expect(color(&image, 65, 25, 0, 255, 0), "the style attribute fills the clipped path green")
  run Testing.expect(color(&image, 85, 25, 255, 255, 255), "the rect clip path keeps only the left half")

  // display none hides an element; removing it shows it again.
  run set(&mut batch, 1, "display", "none")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let hidden = run rendered(&mut tree)
  run Testing.expect(color(&hidden, 25, 25, 255, 255, 255), "display none hides the group")
  run batch.svgAttribute(SVG, 1, "display", Option<string<'static>>.None)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let shown = run rendered(&mut tree)
  run Testing.expect(color(&shown, 25, 25, 255, 0, 0), "removing display shows it again")

  // Removing element 0 ends the live svg.
  run batch.svgRemove(SVG, 0)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let ended = run rendered(&mut tree)
  run Testing.expect(color(&ended, 25, 25, 255, 255, 255), "without its live svg the icon node draws its (absent) icon")
}

test effect fn liveSvgDrawsShapesGroupsOpacityAndClips() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run draws() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn onlyChangedShapesRasterize() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run scene(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let before = tree.paths.misses()

  // A new `d` on one path rasterizes that path alone.
  run set(&mut batch, 3, "d", "M55 60h35v30h-35z")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let reshaped = tree.paths.misses() - before
  run Testing.expect(reshaped == 1, "a new d rasterizes only its path")

  // A colour or a whole-pixel move rasterizes nothing.
  let moved = tree.paths.misses()
  run set(&mut batch, 2, "fill", "rgb(0,0,0)")
  run set(&mut batch, 1, "transform", "translate(12,10)")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  run Testing.expect(tree.paths.misses() == moved, "colour changes and whole-pixel moves reuse coverage")
  let image = run rendered(&mut tree)
  run Testing.expect(color(&image, 11, 25, 255, 255, 255) && color(&image, 41, 25, 0, 0, 0), "the moved rect paints black at its new place")
}

test effect fn liveSvgRasterizesOnlyChangedShapes() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run onlyChangedShapesRasterize() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn gradients() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:200px;height:200px;background-color:white")
  run batch.style(1, root.asSlice())
  run batch.create(SVG, NodeKind.Icon)
  run batch.append(1, SVG)
  let own = run written.declarations(b"display:block;width:100px;height:100px")
  run batch.style(SVG, own.asSlice())
  run set(&mut batch, 0, "viewBox", "0 0 100 100")
  run batch.svgInsert(SVG, 1, "defs", 0, Option<u32>.None)
  // A user-space gradient from red at x = 20 to blue at x = 80, over a square from 0 to 100.
  run batch.svgInsert(SVG, 2, "linearGradient", 1, Option<u32>.None)
  run set(&mut batch, 2, "id", "g")
  run set(&mut batch, 2, "gradientUnits", "userSpaceOnUse")
  run set(&mut batch, 2, "x1", "20")
  run set(&mut batch, 2, "x2", "80")
  run batch.svgInsert(SVG, 3, "stop", 2, Option<u32>.None)
  run set(&mut batch, 3, "stop-color", "#ff0000")
  run batch.svgInsert(SVG, 4, "stop", 2, Option<u32>.None)
  run set(&mut batch, 4, "offset", "1")
  run set(&mut batch, 4, "stop-color", "#0000ff")
  run batch.svgInsert(SVG, 5, "rect", 0, Option<u32>.None)
  run set(&mut batch, 5, "width", "100")
  run set(&mut batch, 5, "height", "100")
  run set(&mut batch, 5, "fill", "url(#g)")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let image = run rendered(&mut tree)
  run Testing.expect(color(&image, 10, 50, 255, 0, 0), "before x1 the gradient pads with its first stop")
  run Testing.expect(color(&image, 90, 50, 0, 0, 255), "after x2 it pads with its last stop")
  let middle = image.pixel(50, 50)
  run Testing.expect(near(middle.r, 128) && near(middle.b, 128), "halfway it mixes both")

  // SVG mixes stops with straight alpha: halfway from opaque red to transparent blue is half
  // purple over white, where a premultiplied mix would give half red.
  run set(&mut batch, 4, "stop-opacity", "0")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let faded = run rendered(&mut tree)
  let half = faded.pixel(50, 50)
  run Testing.expect(near(half.r, 191) && near(half.g, 128) && near(half.b, 191), "straight alpha mixes the transparent stop's colour too")
}

test effect fn liveSvgPaintsGradients() ! TreeError | CssError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run gradients() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn elementAt(tree: &mut UiTree<'_>, x: f32, y: f32) -> u32 ! OutOfMemoryError ? &mut Allocator {
  run tree.dispatch(Input.PointerDown { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 })
  run tree.dispatch(Input.PointerUp { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0 })
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  let mut i: usize = 0
  while i < events.length() {
    if events.asSlice()[i].target == SVG {
      return events.asSlice()[i].element
    }
    i = i + 1
  }
  return 999
}

effect fn hits() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run scene(&mut batch)
  run batch.listen(SVG, 1)
  run batch.svgInsert(SVG, 7, "line", 0, Option<u32>.None)
  run set(&mut batch, 7, "x1", "10")
  run set(&mut batch, 7, "y1", "95")
  run set(&mut batch, 7, "x2", "50")
  run set(&mut batch, 7, "y2", "95")
  run set(&mut batch, 7, "stroke", "black")
  run set(&mut batch, 7, "stroke-width", "4")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let at25_25 = run elementAt(&mut tree, 25.0, 25.0)
  run Testing.expect(at25_25 == 2, "the rect in the translated group")
  let at75_75 = run elementAt(&mut tree, 75.0, 75.0)
  run Testing.expect(at75_75 == 3, "a half transparent path still hits")
  let at65_25 = run elementAt(&mut tree, 65.0, 25.0)
  run Testing.expect(at65_25 == 5, "inside the clip")
  let at85_25 = run elementAt(&mut tree, 85.0, 25.0)
  run Testing.expect(at85_25 == 0, "the clip path cuts hits too")
  let at5_5 = run elementAt(&mut tree, 5.0, 5.0)
  run Testing.expect(at5_5 == 0, "empty svg area is the svg itself")
  let at30_96 = run elementAt(&mut tree, 30.0, 96.0)
  run Testing.expect(at30_96 == 7, "a line hits within its stroke width")
  let at30_98 = run elementAt(&mut tree, 30.0, 98.5)
  run Testing.expect(at30_98 == 0, "and not outside it")
  run set(&mut batch, 3, "pointer-events", "none")
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let through = run elementAt(&mut tree, 75.0, 75.0)
  run Testing.expect(through == 0, "pointer-events none lets the pointer through")
}

test effect fn liveSvgTellsTheShapeUnderThePointer() ! TreeError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hits() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn measured(packed: &[u8], op: u32, distance: f64) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  run live.measure(packed, op, distance, &mut out)
  return move out
}

effect fn measures() ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let square = b"0\x1fpath\x1fd\x1fM60 60h30v30h-30z"
  let box = run measured(square, live.MEASURE_BOX, 0.0)
  run Testing.expect(box.asSlice() == b"60 60 30 30", "a path's box")
  let length = run measured(square, live.MEASURE_LENGTH, 0.0)
  run Testing.expect(length.asSlice() == b"120", "its outline length, closing side included")
  let point = run measured(square, live.MEASURE_POINT, 45.0)
  run Testing.expect(point.asSlice() == b"90 75", "the point 45 along it")
  let group = b"0\x1fg\x1ftransform\x1fscale(5)\x1e1\x1frect\x1fx\x1f2\x1fy\x1f2\x1fwidth\x1f6\x1fheight\x1f6\x1e1\x1fcircle\x1fcx\x1f10\x1fcy\x1f10\x1fr\x1f2"
  let grouped = run measured(group, live.MEASURE_BOX, 0.0)
  run Testing.expect(grouped.asSlice() == b"2 2 10 10", "a group's box joins its children in its own space")
}

test effect fn liveSvgMeasuresBoxesAndLengths() ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run measures() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pagePaint() ! TreeError | CssError | CompileError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:200px;height:200px;background-color:white")
  run batch.style(1, root.asSlice())
  // As t3code's provider icons: fill="none" on the root, the fill from a class through a variable.
  run batch.icon(1, b"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><rect width='10' height='10'/></svg>")
  let own = run written.declarations(b"display:block;width:50px;height:50px")
  run batch.create(2, NodeKind.Icon)
  run batch.append(1, 2)
  run batch.style(2, own.asSlice())
  run batch.attribute(2, Attribute.ClassName { value: run String.copy("fill-icon") })
  run batch.source(2, 1)
  // A live svg takes the root paint the same way.
  run batch.create(3, NodeKind.Icon)
  run batch.append(1, 3)
  run batch.style(3, own.asSlice())
  run batch.attribute(3, Attribute.ClassName { value: run String.copy("fill-icon") })
  run batch.svgAttribute(3, 0, "viewBox", Option<string>.some("0 0 10 10"))
  run batch.svgAttribute(3, 0, "fill", Option<string>.some("none"))
  run batch.svgInsert(3, 1, "rect", 0, Option<u32>.None)
  run batch.svgAttribute(3, 1, "width", Option<string>.some("10"))
  run batch.svgAttribute(3, 1, "height", Option<string>.some("10"))
  let sheet = run compile.compile(b".fill-icon{fill:var(--icon)}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 7, bytes.asSlice())
  run batch.push(Mutation.SetCustomProperty { id: 2, state: StyleState.Base, name: run String.copy("--icon"), value: Option<String>.some(run String.copy("#0000ff")), important: false })
  run batch.push(Mutation.SetCustomProperty { id: 3, state: StyleState.Base, name: run String.copy("--icon"), value: Option<String>.some(run String.copy("#0000ff")), important: false })
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let image = run rendered(&mut tree)
  run Testing.expect(color(&image, 25, 25, 0, 0, 255), "page CSS fills an svg icon over its root's fill attribute")
  run Testing.expect(color(&image, 25, 75, 0, 0, 255), "and a live svg")
}

test effect fn pageCssPaintsInlineSvg() ! TreeError | CssError | CompileError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pagePaint() |> Effect.provideMut<Allocator>(&mut allocator)
}

// As t3code's sidebar backdrop: gradient stops take their color from page custom properties.
effect fn markupVariables() ! TreeError | CssError | CompileError | GeometryError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  let root = run written.declarations(b"display:block;width:200px;height:200px;background-color:white")
  run batch.style(1, root.asSlice())
  run batch.attribute(1, Attribute.ClassName { value: run String.copy("stage") })
  run batch.icon(1, b"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><defs><linearGradient id='g'><stop offset='0' style='stop-color: var(--tone)'/><stop offset='1' style='stop-color:var( --tone )'/></linearGradient></defs><rect width='10' height='10' fill='url(#g)'/></svg>")
  let own = run written.declarations(b"display:block;width:50px;height:50px")
  run batch.create(2, NodeKind.Icon)
  run batch.append(1, 2)
  run batch.style(2, own.asSlice())
  run batch.source(2, 1)
  let sheet = run compile.compile(b".stage{--tone:#0000ff}", &Options.make())
  let bytes = run sheet.encode()
  run batch.adoptStyleSheet(0, 7, bytes.asSlice())
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let image = run rendered(&mut tree)
  run Testing.expect(color(&image, 25, 25, 0, 0, 255), "an inherited custom property colors the stops of an svg's markup")
  run batch.push(Mutation.SetCustomProperty { id: 1, state: StyleState.Base, name: run String.copy("--tone"), value: Option<String>.some(run String.copy("#ff0000")), important: false })
  run tree.apply(run batch.take())
  run tree.frame(viewport())
  let again = run rendered(&mut tree)
  run Testing.expect(color(&again, 25, 25, 255, 0, 0), "and repaints when the property changes")
}

test effect fn customPropertiesReachSvgMarkup() ! TreeError | CssError | CompileError | GeometryError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run markupVariables() |> Effect.provideMut<Allocator>(&mut allocator)
}
