//! The size of the records every node holds, so a field added to them is a choice and not an
//! accident: a long document has tens of thousands of nodes.
import ui_tree.node { Node }
import ui_tree.style_identity { NodeIdentity }
import silk.mem.layout { Layout }
import silk.testing.testing { Testing, AssertionError }

test effect fn nodeRecordsStaySmall() -> () ! AssertionError<'static> {
  run Testing.expect(Layout.of<Node>().bytes <= 296, "a node record is at most 296 bytes")
  run Testing.expect(Layout.of<NodeIdentity>().bytes <= 192, "an element's selector identity is at most 192 bytes")
}
