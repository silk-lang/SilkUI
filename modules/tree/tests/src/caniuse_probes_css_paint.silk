//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The probes of docs/caniuse/support/css-paint.json.
import caniuse_probe { Probe }
import silk.core.option { Option }

/// Probe `at`, none past the last.
pub fn probe(at: usize) -> Option<Probe> {
  let table = [
    Probe { feature: "border-radius", works: true, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{border-radius:8px}" },
    Probe { feature: "border-radius", works: true, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{border-top-left-radius:12px}" },
    Probe { feature: "border-radius", works: false, root: b"", lead: b"", setup: b"background-color:red", base: "", sheet: ".sample{border-top-left-radius:50%}" },
    Probe { feature: "css-backdrop-filter", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{backdrop-filter:blur(4px)}" },
    Probe { feature: "css-boxshadow", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{box-shadow:0 2px 4px black}" },
    Probe { feature: "css-boxshadow", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{box-shadow:inset 0 0 0 2px red}" },
    Probe { feature: "css-clip-path", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{clip-path:circle(40%)}" },
    Probe { feature: "css-filters", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{filter:blur(2px)}" },
    Probe { feature: "css-gradients", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-image:linear-gradient(90deg, red, blue)}" },
    Probe { feature: "css-gradients", works: false, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-image:radial-gradient(red, blue)}" },
    Probe { feature: "css-opacity", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{opacity:0.5}" },
    Probe { feature: "outline", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{outline:2px solid red}" },
    Probe { feature: "transforms2d", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{transform:rotate(10deg)}" },
    Probe { feature: "transforms2d", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{transform:translate(10px, 5px) scale(1.5)}" },
  ]
  if at < table.length {
    return Option<Probe>.some(table[at])
  }
  return Option<Probe>.None
}
