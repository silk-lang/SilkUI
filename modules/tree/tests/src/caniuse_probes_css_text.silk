//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The probes of docs/caniuse/support/css-text.json.
import caniuse_probe { Probe }
import silk.core.option { Option }

/// Probe `at`, none past the last.
pub fn probe(at: usize) -> Option<Probe> {
  let table = [
    Probe { feature: "ch-unit", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10ch}" },
    Probe { feature: "css-letter-spacing", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{letter-spacing:4px}" },
    Probe { feature: "css-text-indent", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-indent:30px}" },
    Probe { feature: "css-textshadow", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-shadow:1px 1px 2px red}" },
    Probe { feature: "css3-tabsize", works: true, root: b"", lead: b"", setup: b"white-space:pre", base: "", sheet: ".sample{tab-size:2}" },
    Probe { feature: "rem", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-left:2rem}" },
    Probe { feature: "text-decoration", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{text-decoration-line:underline;text-decoration-style:wavy;text-decoration-color:red}" },
    Probe { feature: "text-overflow", works: true, root: b"", lead: b"", setup: b"width:60px;white-space:nowrap;overflow:hidden", base: "", sheet: ".sample{text-overflow:ellipsis}" },
    Probe { feature: "word-break", works: true, root: b"", lead: b"", setup: b"width:30px", base: "", sheet: ".sample{word-break:break-all}" },
    Probe { feature: "wordwrap", works: true, root: b"", lead: b"", setup: b"width:30px", base: "", sheet: ".sample{overflow-wrap:anywhere}" },
  ]
  if at < table.length {
    return Option<Probe>.some(table[at])
  }
  return Option<Probe>.None
}
