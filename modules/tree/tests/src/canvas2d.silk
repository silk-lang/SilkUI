//! Canvas 2D bitmaps: commands draw into a bitmap that keeps what was drawn, text comes from
//! the tree's fonts, and a clear makes pixels transparent again.
import ui_tree.legacy { UiTree, TreeError }
import ui_tree.canvas2d { SIZE, FILL_RECT, CLEAR_RECT, FILL_TEXT, FILL_PATH }
import ui_fixtures.fixtures as fixtures
import vector.pixmap { Rgba8 }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }

/// Commands as `canvas2d.js` writes them.
struct Commands {
  bytes: List<u8>,
  start: usize,
}

impl Commands {
  fn make() -> Commands {
    return Commands { bytes: List<u8>.make(), start: 0 }
  }

  effect fn word(self: &mut Self, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.bytes.append(u32.toU8(value & 255))
    run self.bytes.append(u32.toU8((value / 256) & 255))
    run self.bytes.append(u32.toU8((value / 65536) & 255))
    run self.bytes.append(u32.toU8(value / 16777216))
  }

  effect fn number(self: &mut Self, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    let bits = f64.toBits(value)
    run self.word(u64.toU32(bits & 0xffffffff))
    run self.word(u64.toU32(bits / 4294967296))
  }

  effect fn text(self: &mut Self, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.word(usize.toU32(value.length))
    run self.bytes.appendSlice(value)
  }

  effect fn begin(self: &mut Self, op: u32, node: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    self.end()
    self.start = self.bytes.length()
    run self.word(0)
    run self.word(op)
    run self.word(node)
  }

  fn end(self: &mut Self) -> () {
    let length = self.bytes.length()
    if length == 0 || self.start + 4 > length { return () }
    let size = usize.toU32(length - self.start - 4)
    let bytes = self.bytes.asMutSlice()
    bytes[self.start] = u32.toU8(size & 255)
    bytes[self.start + 1] = u32.toU8((size / 256) & 255)
    bytes[self.start + 2] = u32.toU8((size / 65536) & 255)
    bytes[self.start + 3] = u32.toU8(size / 16777216)
  }

  effect fn rect(self: &mut Self, x0: f64, y0: f64, x1: f64, y1: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.number(x0)
    run self.number(y0)
    run self.number(x1)
    run self.number(y1)
  }

  effect fn color(self: &mut Self, r: f64, g: f64, b: f64, a: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.rect(r, g, b, a)
  }
}

fn pixel(tree: &mut UiTree<'_>, x: u32, y: u32) -> Rgba8 {
  let bitmaps = tree.canvas2d.drawn()
  return bitmaps[0].pixels.pixel(x, y)
}

/// Pixels of the box that are not `background`.
fn inked(tree: &mut UiTree<'_>, x0: u32, y0: u32, x1: u32, y1: u32, background: Rgba8) -> u32 {
  let mut count: u32 = 0
  let mut y = y0
  while y < y1 {
    let mut x = x0
    while x < x1 {
      let p = pixel(&mut tree, x, y)
      if p.r != background.r || p.g != background.g || p.b != background.b { count = count + 1 }
      x = x + 1
    }
    y = y + 1
  }
  return count
}

effect fn body() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut c = Commands.make()
  run c.begin(SIZE, 7)
  run c.word(200)
  run c.word(100)
  run c.word(0)
  run c.begin(FILL_RECT, 7)
  run c.rect(0.0, 0.0, 200.0, 100.0)
  run c.color(0.0, 0.0, 1.0, 1.0)
  run c.rect(0.0, 0.0, 200.0, 100.0)
  run c.begin(FILL_TEXT, 7)
  run c.rect(0.0, 0.0, 200.0, 100.0)
  run c.color(1.0, 1.0, 1.0, 1.0)
  run c.text(b"normal 400 20 sans-serif")
  run c.text(b"Hello")
  run c.number(10.0)
  run c.number(40.0)
  run c.number(1.0)
  run c.word(0)
  run c.word(0)
  run c.number(-1.0)
  c.end()
  run tree.drawCanvas2d(c.bytes.asSlice())

  let blue = Rgba8.make(0, 0, 255, 255)
  let corner = pixel(&mut tree, 190, 90)
  run Testing.expect(corner.b == 255 && corner.r == 0 && corner.a == 255, "a filled rectangle paints its color")
  run Testing.expect(inked(&mut tree, 10, 20, 80, 45, blue) > 20, "text draws ink above its baseline")
  run Testing.expect(inked(&mut tree, 120, 0, 200, 100, blue) == 0, "and none past its advance")
  let measured = run tree.measureCanvasText(b"normal 400 20 sans-serif", b"Hello")
  run Testing.expect(measured.width > 20.0 && measured.width < 80.0, "measureText gives the advance")
  run Testing.expect(measured.inkAscent > 8.0 && measured.ascent >= measured.inkAscent, "and the ink and font ascents")

  // A later draw keeps what is there; a clear makes pixels transparent.
  c = Commands.make()
  run c.begin(CLEAR_RECT, 7)
  run c.rect(0.0, 0.0, 200.0, 100.0)
  run c.rect(150.0, 0.0, 200.0, 100.0)
  run c.begin(FILL_PATH, 7)
  run c.rect(0.0, 60.0, 200.0, 100.0)
  run c.color(1.0, 0.0, 0.0, 1.0)
  run c.word(0)
  run c.word(4)
  run c.word(0)
  run c.number(0.0)
  run c.number(0.0)
  run c.word(1)
  run c.number(100.0)
  run c.number(0.0)
  run c.word(1)
  run c.number(100.0)
  run c.number(100.0)
  run c.word(4)
  c.end()
  run tree.drawCanvas2d(c.bytes.asSlice())
  run Testing.expect(pixel(&mut tree, 175, 50).a == 0, "a clear leaves transparent pixels")
  run Testing.expect(inked(&mut tree, 10, 20, 80, 45, blue) > 20, "the text drawn before stays")
  let red = pixel(&mut tree, 90, 80)
  run Testing.expect(red.r == 255 && red.b == 0, "a filled path paints inside its clip")
  let above = pixel(&mut tree, 90, 50)
  run Testing.expect(above.r != 255, "and nothing outside it")
}

test effect fn canvas2dDrawsIntoAKeptBitmap() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
