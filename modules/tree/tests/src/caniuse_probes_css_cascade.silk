//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The probes of docs/caniuse/support/css-cascade.json.
import caniuse_probe { Probe }
import silk.core.option { Option }

/// Probe `at`, none past the last.
pub fn probe(at: usize) -> Option<Probe> {
  let table = [
    Probe { feature: "calc", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:calc(100% - 40px)}" },
    Probe { feature: "calc", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-left:calc(2 * 3px + 1em)}" },
    Probe { feature: "css-all", works: true, root: b"", lead: b"", setup: b"", base: ".sample{margin-left:30px;background-color:red}", sheet: ".root .sample{all:unset}" },
    Probe { feature: "css-cascade-layers", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: "@layer base, top; @layer top{.sample{margin-left:30px}} @layer base{.sample{margin-left:10px}}" },
    Probe { feature: "css-color-function", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:color(display-p3 1 0 0)}" },
    Probe { feature: "css-has", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root:has(.inner) .sample{margin-left:30px}" },
    Probe { feature: "css-has", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample:has(> .inner){margin-left:30px}" },
    Probe { feature: "css-lch-lab", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:lab(50% 40 59)}" },
    Probe { feature: "css-lch-lab", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:oklch(60% 0.2 30)}" },
    Probe { feature: "css-matches-pseudo", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ":is(.sample, .nothing){margin-left:30px}" },
    Probe { feature: "css-matches-pseudo", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ":where(.sample){margin-left:30px}" },
    Probe { feature: "css-math-functions", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-left:max(1em, 30px)}" },
    Probe { feature: "css-math-functions", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:min(200px, 120px)}" },
    Probe { feature: "css-math-functions", works: false, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:min(50%, 120px)}" },
    Probe { feature: "css-math-functions", works: false, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:clamp(50px, 20px, 90px)}" },
    Probe { feature: "css-media-range-syntax", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: "@media (width >= 100px){.sample{margin-left:30px}}" },
    Probe { feature: "css-mediaqueries", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: "@media (min-width: 100px){.sample{margin-left:30px}}" },
    Probe { feature: "css-nesting", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root{ .sample{margin-left:30px} }" },
    Probe { feature: "css-nesting", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root{ & > .sample{margin-left:30px} }" },
    Probe { feature: "css-not-sel-list", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root > :not(.lead, .after){margin-left:30px}" },
    Probe { feature: "css-nth-child-of", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root > :nth-child(1 of .sample){margin-left:30px}" },
    Probe { feature: "css-rebeccapurple", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:rebeccapurple}" },
    Probe { feature: "css-rrggbbaa", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:#ff000080}" },
    Probe { feature: "css-sel2", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root > .sample{margin-left:30px}" },
    Probe { feature: "css-sel2", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".lead + .sample{margin-left:30px}" },
    Probe { feature: "css-sel2", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: "*{margin-left:3px}" },
    Probe { feature: "css-sel3", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".lead ~ .sample{margin-left:30px}" },
    Probe { feature: "css-sel3", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root > :nth-child(2){margin-left:30px}" },
    Probe { feature: "css-sel3", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root > :last-child{margin-left:30px}" },
    Probe { feature: "css-sel3", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample:not(.lead){margin-left:30px}" },
    Probe { feature: "css-sel3", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: "[class^=sam]{margin-left:30px}" },
    Probe { feature: "css-unset-value", works: true, root: b"", lead: b"", setup: b"", base: ".sample{margin-left:30px}", sheet: ".root .sample{margin-left:unset}" },
    Probe { feature: "css-variables", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".root{--gap:30px}.sample{margin-left:var(--gap)}" },
    Probe { feature: "css-variables", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-left:var(--missing, 12px)}" },
    Probe { feature: "css3-colors", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:hsl(120 100% 50%)}" },
    Probe { feature: "css3-colors", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{background-color:rgba(255,0,0,0.5)}" },
    Probe { feature: "currentcolor", works: true, root: b"", lead: b"", setup: b"color:red", base: "", sheet: ".sample{background-color:currentColor}" },
  ]
  if at < table.length {
    return Option<Probe>.some(table[at])
  }
  return Option<Probe>.None
}
