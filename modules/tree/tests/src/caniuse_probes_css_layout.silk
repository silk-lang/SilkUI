//! The probes of docs/caniuse/support/css-layout.json.
import caniuse_probe { Probe }
import silk.core.option { Option }

/// Probe `at`, none past the last.
pub fn probe(at: usize) -> Option<Probe> {
  let table = [
    Probe { feature: "css-container-queries", works: true, root: b"container-type:inline-size", lead: b"", setup: b"", base: "", sheet: "@container (min-width: 100px){.sample{margin-left:30px}}" },
    Probe { feature: "css-container-query-units", works: true, root: b"container-type:inline-size", lead: b"", setup: b"", base: "", sheet: ".sample{width:10cqw}" },
    Probe { feature: "css-display-contents", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{display:contents}" },
    Probe { feature: "css-fixed", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{position:fixed;top:5px;left:5px}" },
    Probe { feature: "css-grid", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{display:grid;grid-template-columns:1fr 2fr}" },
    Probe { feature: "css-grid", works: true, root: b"", lead: b"", setup: b"display:grid;grid-template-columns:100px 100px", base: "", sheet: ".inner{grid-column:1}" },
    Probe { feature: "css-grid", works: true, root: b"", lead: b"", setup: b"display:grid;grid-template-columns:100px 100px", base: "", sheet: ".sample{grid-template-areas:'b a'}.inner{grid-area:b}" },
    Probe { feature: "css-logical-props", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{margin-inline-start:30px}" },
    Probe { feature: "css-logical-props", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{padding-block:10px}" },
    Probe { feature: "css-logical-props", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{inline-size:100px}" },
    Probe { feature: "css3-boxsizing", works: true, root: b"", lead: b"", setup: b"width:100px;padding:10px", base: "", sheet: ".sample{box-sizing:border-box}" },
    Probe { feature: "flexbox", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{display:flex;align-items:center;height:100px}" },
    Probe { feature: "flexbox", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{display:flex;flex-direction:row-reverse}" },
    Probe { feature: "flexbox", works: true, root: b"", lead: b"", setup: b"display:flex", base: "", sheet: ".inner{flex-grow:1}" },
    Probe { feature: "flexbox", works: true, root: b"", lead: b"", setup: b"display:flex;height:200px", base: "", sheet: ".sample{flex-wrap:wrap;align-content:center}" },
    Probe { feature: "flexbox-gap", works: true, root: b"", lead: b"", setup: b"display:flex", base: "", sheet: ".sample{column-gap:30px}" },
    Probe { feature: "inline-block", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".inner{display:inline-block}" },
    Probe { feature: "intrinsic-width", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:min-content}" },
    Probe { feature: "intrinsic-width", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:fit-content}" },
    Probe { feature: "intrinsic-width", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:max-content}" },
    Probe { feature: "justify-content-space-evenly", works: true, root: b"", lead: b"", setup: b"display:flex", base: "", sheet: ".sample{justify-content:space-evenly}" },
    Probe { feature: "minmaxwh", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{max-width:100px}" },
    Probe { feature: "minmaxwh", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{min-height:100px}" },
    Probe { feature: "viewport-unit-variants", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10svw}" },
    Probe { feature: "viewport-unit-variants", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{height:10dvh}" },
    Probe { feature: "viewport-unit-variants", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10lvw}" },
    Probe { feature: "viewport-units", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10vw}" },
    Probe { feature: "viewport-units", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{height:10vh}" },
    Probe { feature: "viewport-units", works: true, root: b"", lead: b"", setup: b"", base: "", sheet: ".sample{width:10vmin}" },
  ]
  if at < table.length {
    return Option<Probe>.some(table[at])
  }
  return Option<Probe>.None
}
