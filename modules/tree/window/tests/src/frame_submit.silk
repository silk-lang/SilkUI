//! Frames that change nothing on screen are not drawn again: the host does not hand the
//! renderer a frame that kept the tree's last scene (`host.submitsFrame`), and the render
//! thread draws a canvas frame on its own only while the UI thread makes no frame of its own
//! (`render_thread.redrawsAlone`), so a `requestAnimationFrame` callback that draws a canvas
//! has the window drawn once, not twice.
import ui_tree_window.host { FrameSubmit, submitsFrame }
import ui_tree_window.render_thread { redrawsAlone }
import silk.testing.testing { AssertionError, Testing }

fn kept() -> FrameSubmit {
  return FrameSubmit {
    check: false,
    inspector: false,
    layered: false,
    submitted: 3,
    kept: true,
    uploads: 0,
    width: 800,
    height: 600,
    lastWidth: 800,
    lastHeight: 600,
  }
}

test effect fn aFrameThatKeptItsSceneIsNotSubmitted() -> ()
  ! AssertionError<'static> {
  run Testing.expect(!submitsFrame(kept()), "a kept frame of the same size goes nowhere")
  let mut frame = kept()
  frame.kept = false
  run Testing.expect(submitsFrame(frame), "a frame that painted is submitted")
  frame = kept()
  frame.submitted = 0
  run Testing.expect(submitsFrame(frame), "the first frame is submitted")
  frame = kept()
  frame.uploads = 2
  run Testing.expect(submitsFrame(frame), "a frame with atlas pixels is submitted")
  frame = kept()
  frame.width = 801
  run Testing.expect(submitsFrame(frame), "a frame of another width is submitted")
  frame = kept()
  frame.lastHeight = 0
  run Testing.expect(submitsFrame(frame), "a frame of another height is submitted")
  frame = kept()
  frame.check = true
  run Testing.expect(submitsFrame(frame), "check mode submits every frame")
  frame = kept()
  frame.inspector = true
  run Testing.expect(submitsFrame(frame), "a window serving the inspector submits every frame")
  frame = kept()
  frame.layered = true
  run Testing.expect(submitsFrame(frame), "a frame under a dock or an overlay is submitted")
}

test effect fn aCanvasFrameWaitsForTheUiFrameBeingMade() -> ()
  ! AssertionError<'static> {
  run Testing.expect(redrawsAlone(false, true, false), "a canvas frame draws the window when no UI frame is being made")
  run Testing.expect(!redrawsAlone(false, true, true), "a canvas frame waits for the UI frame being made")
  run Testing.expect(redrawsAlone(true, false, true), "a compositor scroll draws at once")
  run Testing.expect(redrawsAlone(true, true, true), "and takes the canvas frame with it")
  run Testing.expect(!redrawsAlone(false, false, false), "nothing to draw")
}
