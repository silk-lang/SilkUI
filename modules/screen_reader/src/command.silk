//! What a screen reader user asks for, whatever keys their screen reader uses for it. Keys
//! become commands in [`flavor`]; panels and tools send commands directly.
import silk.core.ownership { Copy }

/// The kinds of element quick navigation, the elements list and the rotor move between.
pub enum Kind {
  Heading,
  Heading1,
  Heading2,
  Heading3,
  Heading4,
  Heading5,
  Heading6,
  Link,
  FormField,
  Button,
  Edit,
  CheckBox,
  Radio,
  ComboBox,
  Table,
  List,
  ListItem,
  Landmark,
  Graphic,
}

/// How many kinds the elements list and the rotor show.
pub const LIST_KINDS: usize = 5

/// The kind at `index` of the elements list and the rotor (wrapping).
pub fn listKind(index: usize) -> Kind {
  return match index % LIST_KINDS {
    0 => Kind.Heading
    1 => Kind.Link
    2 => Kind.FormField
    3 => Kind.Button
    _ => Kind.Landmark
  }
}

/// Where `kind` is in the elements list, or the first kind when it is not listed.
pub fn listIndex(kind: Kind) -> usize {
  return match kind {
    Kind.Link => 1
    Kind.FormField => 2
    Kind.Button => 3
    Kind.Landmark => 4
    _ => 0
  }
}

/// A screen reader command.
pub union Command {
  NextLine,
  PreviousLine,
  NextCharacter,
  PreviousCharacter,
  NextWord,
  PreviousWord,
  /// The next element: VoiceOver's VO+Right, object navigation elsewhere.
  NextItem,
  PreviousItem,
  LineStart,
  LineEnd,
  Top,
  Bottom,
  /// Quick navigation to the next (or previous) element of a kind.
  Jump { pub kind: Kind, pub forward: bool },
  /// Click the element under the cursor (Enter, Space, VO+Space).
  Activate,
  /// Browse mode to focus mode and back (NVDA+Space).
  ToggleMode,
  /// Leave focus mode (Escape in a text field).
  BrowseMode,
  SayAll,
  StopSpeech,
  CurrentLine,
  CurrentFocus,
  Title,
  /// Opens the elements list (NVDA+F7) or rotor (VO+U) at a kind.
  ElementsList { pub kind: Kind },
  /// Moves between table cells: rows down when positive, columns right when positive.
  TableMove { pub rows: i32, pub columns: i32 },
  /// Turns the screen reader off (NVDA+Q).
  Quit,
}

impl Copy for Command {}
