//! The wasm program behind every ui-js application on web-canvas. It is the same for every
//! application: the page (../browser/js-host.js) runs the application's bundle on the browser's
//! JavaScript engine, and this program hosts the tree that bundle builds. Built for wasm32 only.
import ui_js_web.lib { WebJs, WebJsClient, markdownJson }
import ui_tree.legacy { TreeError, Mutation }
import ui_tree_window.host { RunOptions, runWindow, StartedGpu }
import ui_tree_window.platform_thread { Launched }
import ui_tree_window.console { StderrWriter }
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { Inspector }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// Imported only for the WebGPU symbols it exports to the page. Exports must be in the
// program's own package: a dependency exports no wasm symbols.
import generated_webgpu_exports as _generated_webgpu_exports

// Imported only for the C math symbols it exports to the wasm32 runtime.
import libm as _libm

effect fn program() -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = WebJs.make()
  let mut client = WebJsClient {}
  let options = RunOptions {
    title: "Silk UI",
    width: 800.0,
    height: 600.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
    gpu: Option<StartedGpu>.None,
  }
  return run runWindow(&mut state, &fonts, List<Mutation>.make(), move options, Inspector.off(), &mut client)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("The web-canvas host failed\n", &())
  return 2
}

/// Runs the page's application until its window closes. The page calls it through JSPI.
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

/// `__ui.markdown` (see `markdownJson`).
export "C" fn silkuiMarkdown(source: ?[*]const u8, length: usize, flags: u32) -> ?*mut u8 as "silkui_markdown" {
  return unsafe markdownJson(source, length, flags)
}
