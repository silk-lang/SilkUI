{
  "name": "@silkui/react",
  "version": "0.1.0",
  "description": "A React renderer for the Silk UI tree, for applications that run on the embedded SilkJS engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silk-lang/lib-ui.git",
    "directory": "modules/js/packages/ui-react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    }
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@silkui/core": "0.1.0",
    "react-reconciler": "^0.34.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
