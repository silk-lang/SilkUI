/// A native function's id: a hash of its JavaScript name, so a feature adds a native without
/// renumbering the others. The ids start above the runtime callbacks' (`REJECTION`). Each
/// constant below spells its hash out (a constant cannot call a function); a test checks
/// them, and that no two names share an id.
/// How many present intervals a [`Bridge`] keeps for `__ui.frameStats` at most.
const MAX_PRESENTS: usize = 4096

pub fn nativeId(name: &[u8]) -> u32 {
  let mut hash: u32 = 0
  let mut i: usize = 0
  while i < name.length {
    hash = (hash * 31 + u8.toU32(name[i])) % 1048573
    i = i + 1
  }
  return 65536 + hash
}

/// `__ui.create(id, kind)`: kind 0 is a box, 1 text, 2 an input, 3 an image, 4 an icon,
/// 5 a canvas.
pub const CREATE: u32 = 442846 // nativeId(b"create")
/// `__ui.append(parent, child)`.
pub const APPEND: u32 = 388948 // nativeId(b"append")
/// `__ui.insertBefore(parent, child, before)`.
pub const INSERT_BEFORE: u32 = 446920 // nativeId(b"insertBefore")
/// `__ui.root(id)`.
pub const ROOT: u32 = 426219 // nativeId(b"root")
/// `__ui.setText(id, value)`.
pub const SET_TEXT: u32 = 395998 // nativeId(b"setText")
/// `__ui.listen(id, flags)`: the ui-protocol `LISTEN_*` flags.
pub const LISTEN: u32 = 668019 // nativeId(b"listen")
/// `__ui.style(id, css, state)`: sets the declarations of `css` (`"width: 10px; color: red"`)
/// in a look of the node. State 0 is the base look, 1 hover, 2 active, 3 focus, 4
/// focus-visible. Declarations that do not parse are dropped, as in CSS.
pub const COMPILE_STYLE_SHEET: u32 = 436067
pub const STYLE_SHEET: u32 = 203804
pub const STYLE: u32 = 794345 // nativeId(b"style")
/// `__ui.clearStyle(id, state)`: forgets every declaration of that look.
pub const CLEAR_STYLE: u32 = 724429 // nativeId(b"clearStyle")
/// `__ui.attribute(id, name, value)`. Throws a `TypeError` for a name the tree does not have.
