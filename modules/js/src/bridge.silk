pub const CAPTURE: u32 = 310643 // nativeId(b"capture")
/// `__ui.focus(id)`.
pub const FOCUS: u32 = 153071 // nativeId(b"focus")
/// `__ui.remove(id)`: detaches the node and its subtree; it can be inserted again.
pub const REMOVE: u32 = 794128 // nativeId(b"remove")
/// `__ui.destroy(id)`: detaches and frees the node and its subtree.
pub const DESTROY: u32 = 565601 // nativeId(b"destroy")
/// `__ui.scrollTo(id, x, y)`.
pub const SCROLL_TO: u32 = 429507 // nativeId(b"scrollTo")
/// `__ui.select(id, anchor, focus)`: UTF-8 byte offsets in an input's value.
pub const SELECT: u32 = 1071833 // nativeId(b"select")
/// `__ui.log(level, text)`: a console line. Level 0 is debug, 1 log, 2 warn, 3 error.
pub const LOG: u32 = 172868 // nativeId(b"log")
/// `__ui.memoryUsage()`: the process's memory in bytes as the system shows it to users, 0 when
/// it cannot say (see `process_memory`).
pub const MEMORY_USAGE: u32 = 838122 // nativeId(b"memoryUsage")
/// `__ui.native(id, ...args)`: calls the app's exported Silk function `id` (see
/// `ui_js_calls.natives`). A failure throws an `InternalError` the importing module rethrows.
pub const NATIVE: u32 = 226387 // nativeId(b"native")
/// `__ui.nativeStart(call, id, ...args)`: the same on a background thread; the host answers
/// with `__ui.nativeDone(call, kind, value)` once it ends (the prelude makes the promise).
pub const NATIVE_START: u32 = 665098 // nativeId(b"nativeStart")
/// `__ui.frameStats(field)`: the frames the window presented. Field 0 takes the frames since the
/// last take and returns how many; 1 is how many painted frames were replaced undrawn among
/// them, 2 to 5 the 50th, 95th and 99th percentile and the longest of their milliseconds
/// between presents (0 without frames).
pub const FRAME_STATS: u32 = 687480 // nativeId(b"frameStats")
/// `__ui.random()`: 32 secure random bits from the operating system, for `crypto`.
pub const RANDOM: u32 = 264774 // nativeId(b"random")
/// `__ui.cpus()`: how many threads can run at once, for `navigator.hardwareConcurrency`.
pub const CPUS: u32 = 1029073 // nativeId(b"cpus")
/// `__ui.computed(id, name)`: the computed value of longhand `name` of node `id`, as
/// `getComputedStyle` gives it, or undefined when there is none or the host attached no tree.
/// The pending batch reaches the tree first, and a pending layout runs.
pub const COMPUTED: u32 = 383089 // nativeId(b"computed")
/// `__ui.scale()`: device pixels per CSS pixel in the window's last frame, for
/// `devicePixelRatio`.
pub const SCALE: u32 = 264834 // nativeId(b"scale")
/// `__ui.matchMedia(query)`: whether the media query list matches the last frame's media.
pub const MATCH_MEDIA: u32 = 629931 // nativeId(b"matchMedia")
/// `__ui.supports(conditionText)` and `__ui.supports(property, value)`: `CSS.supports`, as the
/// tree's `@supports` evaluates it.
pub const SUPPORTS: u32 = 870406 // nativeId(b"supports")
/// Layout reads for CSSOM View. Each applies the pending batch to the attached tree, lays out
/// when something is pending, and leaves its numbers for `__ui.geometry(index)`:
/// `rect(id)` x, y, width, height and answers 4; `rects(id)` 4 a fragment and answers how many
/// rectangles; `metrics(id)` client left, top, width, height, scroll width, height, left, top,
/// offset parent (0 for none), offset left, top, width, height and answers 13; `hit(x, y)`
/// answers the topmost node there (0 for none); `hits(x, y)` leaves the ids, topmost first, and
/// answers how many; `caret(x, y)` leaves node, UTF-16 offset, x, y, width, height and answers 1,
/// or 0 when no text is there; `rangeRects(startId, startOffset, endId, endOffset)` as `rects`.
/// Without an attached tree each answers 0.
pub const RECT: u32 = 416237 // nativeId(b"rect")
pub const RECTS: u32 = 451652 // nativeId(b"rects")
pub const METRICS: u32 = 924528 // nativeId(b"metrics")
pub const HIT: u32 = 168851 // nativeId(b"hit")
pub const HITS: u32 = 122697 // nativeId(b"hits")
pub const CARET: u32 = 125073 // nativeId(b"caret")
pub const RANGE_RECTS: u32 = 444035 // nativeId(b"rangeRects")
/// The document's text selection. `selection()` applies the pending batch and leaves anchor
/// id, offset, focus id, offset, then each stretch's start id, offset, end id, offset (see
/// `text_selection.stretches`) for `__ui.geometry`, and answers how many stretches (0 for none).
/// Offsets are DOM offsets: UTF-16 units in text. `setSelection(anchorId, anchorOffset, focusId,
/// focusOffset)` selects (id 0 clears) and answers whether both nodes were found.
/// `selectionText()` is the selection's text as copying gives it.
pub const SELECTION: u32 = 1110422 // nativeId(b"selection")
pub const SET_SELECTION: u32 = 975202 // nativeId(b"setSelection")
pub const SELECTION_TEXT: u32 = 266335 // nativeId(b"selectionText")
/// `__ui.geometry(index)`: number `index` of the last layout read.
pub const GEOMETRY: u32 = 576810 // nativeId(b"geometry")
/// `__ui.scrollIntoView(id, block, inline, behavior, ifNeeded)`: scrolls every scroll container
/// around node `id` to show it, honoring `scroll-margin`, `scroll-padding` and snapping.
/// `block` and `inline` are 0 start, 1 center, 2 end, 3 nearest; `behavior` 0 auto, 1 instant,
/// 2 smooth. With `ifNeeded` a container that already shows the node stays.
pub const SCROLL_INTO_VIEW: u32 = 305994 // nativeId(b"scrollIntoView")
/// `__ui.scroll(id, left, top, behavior, flags)`: scrolls node `id` to (`left`, `top`), or by
/// them with flag 4. Flag 1 says `left` is given and 2 `top`; an axis not given stays.
/// `behavior` as for `scrollIntoView`; `auto` follows the node's `scroll-behavior`.
pub const SCROLL: u32 = 461991 // nativeId(b"scroll")
/// `__ui.observer(id, root, top, right, bottom, left, percent, scrollTop, scrollRight,
/// scrollBottom, scrollLeft... )`: sets IntersectionObserver `id`'s root (0 the viewport),
/// `rootMargin` and `scrollMargin`; percent bits 1-8 the root margin's, 16-128 the scroll
