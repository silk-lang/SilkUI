pub const OBSERVE: u32 = 540327 // nativeId(b"observe")
pub const UNOBSERVE: u32 = 571481 // nativeId(b"unobserve")
/// `__ui.webApis()`: the source of `web_apis.js`, which the prelude evaluates on first use.
pub const WEB_APIS: u32 = 588983 // nativeId(b"webApis")
/// `__ui.now()`: the host's clock in milliseconds, as `performance.now()`.
pub const NOW: u32 = 174806 // nativeId(b"now")
/// `__ui.timer(id, delay)`: asks for `__ui.fire(id)` once, `delay` milliseconds from now.
