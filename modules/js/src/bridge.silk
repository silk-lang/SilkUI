pub const OBSERVER: u32 = 104149 // nativeId(b"observer")
pub const THRESHOLD: u32 = 226919 // nativeId(b"threshold")
/// `__ui.observe(observer, target, kind)`: kind 0 intersection, 1 to 3 a resize of the
/// content, border or device pixel content box. `__ui.unobserve(observer, target)`, target 0
