//! The native half of the bridge: what the engine calls when JavaScript calls `__ui.*`.
//!
//! Every node call appends to one batch and returns; nothing reaches the tree until the host
//! flushes. The functions take plain numbers and strings, so a call costs tens of nanoseconds.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.f64
import silk.num.u8
import silk.num.usize
import ui_tree.legacy { Batch, Attribute, Mutation, Keyframe, Atom }
import silkjs.js_engine { Engine }
import silkjs.js_engine_host { EngineServices }
import silkjs.js_value { ValueBits }
import silkjs.js_realm { Realm, Arguments }
import silkjs.js_owned_value { Value, ValueRef }
import silkjs.js_proxy_core as core
import silkjs.js_exceptions { JsException }
import silkjs.js_strings { Strings }
import silkjs.js_core_types { NativeFunctionId, NativeErrorKind, ModuleDef }
import silkjs.js_heap { CellRef }
import silkjs.js_coercion_host { CoercionHooks }
import silkjs.js_eval as evaluation
import silkjs.js_eval_compile as flags
import silkjs.js_string_types { StringLengthError }
import ui_js_calls.stylesheets as stylesheets
import ui_js_calls.stylesheets { Compiler }
import ui_js_calls.markdown as markdown
import ui_js_calls.lib { Arg, Applied, setAttribute, nodeKind, styleState, declarationsOf, applyStyle, unpackMarks, unpackAtoms, same }

/// A native function's id: a hash of its JavaScript name, so a feature adds a native without
/// renumbering the others. The ids start above the runtime callbacks' (`REJECTION`). Each
/// constant below spells its hash out (a constant cannot call a function); a test checks
/// them, and that no two names share an id.
pub fn nativeId(name: &[u8]) -> u32 {
  let mut hash: u32 = 0
  let mut i: usize = 0
  while i < name.length {
    hash = (hash * 31 + u8.toU32(name[i])) % 1048573
    i = i + 1
  }
  return 65536 + hash
}

/// `__ui.create(id, kind)`: kind 0 is a box, 1 text, 2 an input, 3 an image, 4 an icon,
/// 5 a canvas.
pub const CREATE: u32 = 442846 // nativeId(b"create")
/// `__ui.append(parent, child)`.
pub const APPEND: u32 = 388948 // nativeId(b"append")
/// `__ui.insertBefore(parent, child, before)`.
pub const INSERT_BEFORE: u32 = 446920 // nativeId(b"insertBefore")
/// `__ui.root(id)`.
pub const ROOT: u32 = 426219 // nativeId(b"root")
/// `__ui.setText(id, value)`.
pub const SET_TEXT: u32 = 395998 // nativeId(b"setText")
/// `__ui.listen(id, flags)`: the ui-protocol `LISTEN_*` flags.
pub const LISTEN: u32 = 668019 // nativeId(b"listen")
/// `__ui.style(id, css, state)`: sets the declarations of `css` (`"width: 10px; color: red"`)
/// in a look of the node. State 0 is the base look, 1 hover, 2 active, 3 focus, 4
/// focus-visible. Declarations that do not parse are dropped, as in CSS.
pub const COMPILE_STYLE_SHEET: u32 = 436067
pub const STYLE_SHEET: u32 = 203804
pub const STYLE: u32 = 794345 // nativeId(b"style")
/// `__ui.clearStyle(id, state)`: forgets every declaration of that look.
pub const CLEAR_STYLE: u32 = 724429 // nativeId(b"clearStyle")
/// `__ui.attribute(id, name, value)`. Throws a `TypeError` for a name the tree does not have.
/// `role` takes ARIA role text and returns whether one of its words is a role the tree has
/// (the node has no role otherwise). `__ui.attribute(id, "valueRange", min, max, now)` sets
/// the value range, and without numbers clears it. An `aria-` name takes ARIA value text
/// (`"aria-level", "2"`) and returns whether the tree has that attribute.
pub const ATTRIBUTE: u32 = 281985 // nativeId(b"attribute")
/// `__ui.focus(id)`.
pub const FOCUS: u32 = 153071 // nativeId(b"focus")
/// `__ui.remove(id)`: detaches the node and its subtree; it can be inserted again.
pub const REMOVE: u32 = 794128 // nativeId(b"remove")
/// `__ui.destroy(id)`: detaches and frees the node and its subtree.
pub const DESTROY: u32 = 565601 // nativeId(b"destroy")
/// `__ui.scrollTo(id, x, y)`.
pub const SCROLL_TO: u32 = 429507 // nativeId(b"scrollTo")
/// `__ui.select(id, anchor, focus)`: UTF-8 byte offsets in an input's value.
pub const SELECT: u32 = 1071833 // nativeId(b"select")
/// `__ui.log(level, text)`: a console line. Level 0 is debug, 1 log, 2 warn, 3 error.
pub const LOG: u32 = 172868 // nativeId(b"log")
/// `__ui.now()`: the host's clock in milliseconds, as `performance.now()`.
pub const NOW: u32 = 174806 // nativeId(b"now")
/// `__ui.timer(id, delay)`: asks for `__ui.fire(id)` once, `delay` milliseconds from now.
/// Asking again for the same id moves it.
pub const TIMER: u32 = 329856 // nativeId(b"timer")
/// `__ui.clipboardRead(call)`: asks the host for the system clipboard's text, answered with
/// `__ui.clipboard(call, text)`.
pub const CLIPBOARD_READ: u32 = 868924 // nativeId(b"clipboardRead")
/// `__ui.clipboardWrite(call, text)`: asks the host to put `text` on the system clipboard,
/// answered with `__ui.clipboard(call)`.
pub const CLIPBOARD_WRITE: u32 = 623693 // nativeId(b"clipboardWrite")
/// `__ui.shell(call, op, text)`: asks the host for a desktop feature, answered with
/// `__ui.shellAnswer(call, value)`. The ops and how `text` packs their arguments are
/// [`ShellRequest`]'s.
pub const SHELL: u32 = 417640 // nativeId(b"shell")
/// `__ui.cancelTimer(id)`.
pub const CANCEL_TIMER: u32 = 88792 // nativeId(b"cancelTimer")
/// `__ui.requestFrame()`: asks for `__ui.frame(time)` before the next frame.
pub const REQUEST_FRAME: u32 = 1087605 // nativeId(b"requestFrame")
/// `__ui.devSend(line)`: a line for the development server the host is connected to.
pub const DEV_SEND: u32 = 243370 // nativeId(b"devSend")
/// `__ui.devReload()`: asks the host to start a new realm and run the application again.
pub const DEV_RELOAD: u32 = 731600 // nativeId(b"devReload")
/// `__ui.fontFamily(id, names)`: defines family list `id` from CSS `font-family` text, for
/// `font-family: <id>` in a style.
pub const FONT_FAMILY: u32 = 276542 // nativeId(b"fontFamily")
/// `__ui.open(url)`: asks the host to open an address outside the application.
pub const OPEN: u32 = 337491 // nativeId(b"open")
/// `__ui.defineIcon(resource, markup)`: parses SVG markup as icon resource `resource`.
pub const DEFINE_ICON: u32 = 917712 // nativeId(b"defineIcon")
/// `__ui.source(id, resource)`: points an image or icon node at a resource.
pub const SOURCE: u32 = 101910 // nativeId(b"source")
/// `__ui.load(resource, url, icon)`: asks the host to load `url` (`data:`, a file, `http(s):`)
/// as image resource `resource`, or as an icon when `icon` is true. An image of an SVG file
/// loads as one too.
pub const LOAD: u32 = 247023 // nativeId(b"load")
/// `__ui.release(resource)`: forgets a resource no node shows any more.
pub const RELEASE: u32 = 439351 // nativeId(b"release")
/// `__ui.markdown(text, flags)`: the mdast JSON of `text`, with the extensions of the
/// [`markdown`] option bits in `flags`.
pub const MARKDOWN: u32 = 1036232 // nativeId(b"markdown")
/// `__ui.keyframe(offset, css)`: adds a frame (offset 0 to 1, CSS declarations) to the
/// `@keyframes` rule that the next `__ui.keyframes` defines.
pub const KEYFRAME: u32 = 377906 // nativeId(b"keyframe")
/// `__ui.keyframes(name)`: defines `@keyframes name` from the frames added since the last
/// one; none removes it.
pub const KEYFRAMES: u32 = 311964 // nativeId(b"keyframes")
/// `__ui.richText(id, value, marks, atoms)`: sets a rich input's value. `marks` packs the
/// mark spans as `"start,end,bits;..."` and `atoms` packs each atom as `kind\0label\0data\0`,
/// with UTF-8 byte offsets.
pub const RICH_TEXT: u32 = 226028 // nativeId(b"richText")
/// `__ui.mark(id, mark, css)`: what mark `mark` (0 to 31) of a rich input looks like.
pub const MARK: u32 = 263894 // nativeId(b"mark")
/// `__ui.atomStyle(id, kind, css)`: what atoms of `kind` in a rich input look like.
pub const ATOM_STYLE: u32 = 978521 // nativeId(b"atomStyle")
/// `__ui.format(id, mark, on)`: turns a mark on or off over the selection.
pub const FORMAT: u32 = 72137 // nativeId(b"format")
/// `__ui.insertAtom(id, start, end, atom)`: replaces value bytes [start, end) with an atom
/// packed as for `richText`.
pub const INSERT_ATOM: u32 = 565842 // nativeId(b"insertAtom")

/// The runtime's promise rejection tracker callback: [`Bridge`] keeps the promises that
/// were rejected with no handler until one is added.
pub const REJECTION: u32 = 101

/// The runtime's module loader callback: [`Bridge`] answers it from the defined modules.
pub const MODULE_LOAD: u32 = 100

/// A module an application can import by `name`.
pub struct ModuleSource {
  pub name: List<u8>,
  pub source: List<u8>,
}

/// A timer JavaScript asked for: `__ui.fire(id)` is due at `due`, in the host clock's
/// milliseconds.
pub struct Timer {
  pub id: u32,
  pub due: f64,
}

impl Copy for Timer {}

/// A console line. `level` 0 is debug, 1 log, 2 warn, 3 error.
pub struct LogEntry {
  pub level: u32,
  pub text: String,
}

/// The engine's services for a UI host: the batch JavaScript appends to, the modules it can
/// import, and what its timers, frame requests and console calls left for the host.
pub struct Bridge {
  pub stylesheetCompiler: Compiler,
  pub batch: Batch,
  pub modules: List<ModuleSource>,
  /// The host clock in milliseconds, as of the host's last `advance`.
  pub now: f64,
  pub timers: List<Timer>,
  /// Whether JavaScript asked for an animation frame callback.
  pub frame: bool,
  pub logs: List<LogEntry>,
  /// Promises rejected with no handler so far, with what they were rejected with. The
  /// host reports the ones still here after the promise jobs ran, as a browser does.
  pub rejections: List<Rejected>,
  /// Lines JavaScript sent to the development server, oldest first.
  pub outbox: List<String>,
  /// Whether JavaScript asked for a new realm.
  pub reload: bool,
  /// Addresses JavaScript asked the host to open, oldest first.
  pub opened: List<String>,
  /// The frames `__ui.keyframe` added for the next `__ui.keyframes`.
  pub frames: List<Keyframe>,
  /// Clipboard reads and writes JavaScript asked for (`navigator.clipboard`), oldest first.
  pub clipboard: List<ClipboardRequest>,
  /// Desktop calls JavaScript asked for (notifications, the tray, global shortcuts).
  pub shell: List<ShellRequest>,
}

/// A `__ui.shell` call waiting for the host. `text` holds the op's fields, separated by U+001F:
/// - 0, notify: title, body; answered with the notification's id, 0 when none was shown.
/// - 1, set the tray: tooltip, width, height, template (0 or 1), RGBA pixels as hex, then the
///   menu, one entry per line: `B<title>` opens a submenu, `E` closes it, `S` is a separator
///   and `A<action>,<enabled>,<checked>,<title>` an item. Answered with 1 when it shows.
/// - 2, remove the tray.
/// - 3, register a global shortcut: id, UI Events `code`, modifier bits (shift 1, control 2,
///   alt 4, meta 8, 16 for Command on macOS and Control elsewhere); answered with 1 when
///   the system took it.
/// - 4, unregister a global shortcut: id.
pub struct ShellRequest {
  pub call: u32,
  pub op: u32,
  pub text: String,
}

/// A `navigator.clipboard` call waiting for the host: `call` names it in the answer.
pub union ClipboardRequest {
  Read { pub call: u32 },
  Write { pub call: u32, pub text: String },
}

/// A rejected promise nothing handles yet. Both values are owned.
pub struct Rejected {
  pub promise: Value,
  pub reason: Value,
}

impl Bridge {
  pub fn make() -> Bridge {
    return Bridge {
      stylesheetCompiler: Compiler.off(),      batch: Batch.make(),
      modules: List<ModuleSource>.make(),
      now: 0.0,
      timers: List<Timer>.make(),
      frame: false,
      logs: List<LogEntry>.make(),
      rejections: List<Rejected>.make(),
      outbox: List<String>.make(),
      reload: false,
      opened: List<String>.make(),
      frames: List<Keyframe>.make(),
      clipboard: List<ClipboardRequest>.make(),
      shell: List<ShellRequest>.make(),
    }
  }

  /// Takes timer `id` out. Says whether it was there.
  pub fn cancel(self: &mut Self, id: u32) -> bool {
    let items = self.timers.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if items[i].id == id {
        drop self.timers.remove(i)
        return true
      }
      i = i + 1
    }
    return false
  }

  fn find(self: &Self, name: &[u8]) -> Option<usize> {
    let items = self.modules.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if same(items[i].name.asSlice(), name) { return Option<usize>.some(i) }
      i = i + 1
    }
    return Option<usize>.none()
  }
}

/// A native function of `__ui`: its JavaScript name and declared argument count.
pub struct Native {
  pub name: &'static [u8],
  pub arity: i32,
}

impl Copy for Native {}

/// Native function `at` of `__ui`, none past the last. They are in alphabetical order, so
/// features that add natives touch different lines (the installer defines each one as
/// `nativeId(name)`).
pub fn native(at: usize) -> Option<Native> {
  let table = [
    Native { name: b"append", arity: 2 },
    Native { name: b"atomStyle", arity: 3 },
    Native { name: b"attribute", arity: 3 },
    Native { name: b"cancelTimer", arity: 1 },
    Native { name: b"clearStyle", arity: 2 },
    Native { name: b"clipboardRead", arity: 1 },
    Native { name: b"clipboardWrite", arity: 2 },
    Native { name: b"create", arity: 2 },
    Native { name: b"defineIcon", arity: 2 },
    Native { name: b"destroy", arity: 1 },
    Native { name: b"devReload", arity: 0 },
    Native { name: b"devSend", arity: 1 },
    Native { name: b"focus", arity: 1 },
    Native { name: b"fontFamily", arity: 2 },
    Native { name: b"format", arity: 3 },
    Native { name: b"insertAtom", arity: 4 },
    Native { name: b"insertBefore", arity: 3 },
    Native { name: b"keyframe", arity: 2 },
    Native { name: b"keyframes", arity: 1 },
    Native { name: b"listen", arity: 2 },
    Native { name: b"load", arity: 3 },
    Native { name: b"log", arity: 2 },
    Native { name: b"mark", arity: 3 },
    Native { name: b"markdown", arity: 2 },
    Native { name: b"now", arity: 0 },
    Native { name: b"open", arity: 1 },
    Native { name: b"release", arity: 1 },
    Native { name: b"remove", arity: 1 },
    Native { name: b"requestFrame", arity: 0 },
    Native { name: b"richText", arity: 4 },
    Native { name: b"root", arity: 1 },
    Native { name: b"scrollTo", arity: 3 },
    Native { name: b"select", arity: 3 },
    Native { name: b"setText", arity: 2 },
    Native { name: b"shell", arity: 3 },
    Native { name: b"source", arity: 2 },
    Native { name: b"style", arity: 3 },
    Native { name: b"styleSheet", arity: 3 },
    Native { name: b"compileStyleSheet", arity: 1 },
    Native { name: b"timer", arity: 2 },
  ]
  if at < table.length { return Option<Native>.some(table[at]) }
  return Option<Native>.none()
}

fn number(value: ValueBits) -> f64 {
  return match value {
    ValueBits.Int { value: integer } => i32.toF64(integer)
    ValueBits.Float64 { value: float } => float
    _ => 0.0
  }
}

fn id(value: ValueBits) -> u32 {
  return match value {
    ValueBits.Int { value: integer } => i32.toU32(integer)
    ValueBits.Float64 { value: float } => f64.toU32(float)
    _ => 0
  }
}

fn truthy(value: ValueBits) -> bool {
  return match value {
    ValueBits.Bool { value: flag } => flag
    ValueBits.Int { value: integer } => integer != 0
    ValueBits.Float64 { value: float } => float != 0.0
    ValueBits.Undefined => false
    ValueBits.Null => false
    _ => true
  }
}

effect fn text<'v>(value: ValueRef<'v>) -> String ! OutOfMemoryError ? &mut Allocator {
  if !value.view().isString() { return String.make() }
  let bytes = run Strings.toUtf8(value.view(), false)
  return run String.copy(unsafe String.fromUtf8Unchecked(bytes.asSlice()))
}

/// `value` as the calls in ui-js-calls take it.
effect fn argOf<'v>(value: ValueRef<'v>) -> Arg ! OutOfMemoryError ? &mut Allocator {
  let bits = value.view()
  if bits.isString() { return Arg.Text { value: run text(value) } }
  return match bits {
    ValueBits.Int { value: integer } => Arg.Number { value: i32.toF64(integer) }
    ValueBits.Float64 { value: float } => Arg.Number { value: float }
    ValueBits.Bool { value: flag } => Arg.Flag { value: flag }
    ValueBits.Undefined => Arg.Nothing
    ValueBits.Null => Arg.Nothing
    _ => Arg.Flag { value: true }
  }
}

/// What a `__ui` native function did: returned a value, or asked for a `TypeError`.
pub union Outcome {
  Returned { pub value: ValueBits },
  TypeError { pub message: List<u8> },
}

/// Runs `__ui` native function `function` on `state`. A host whose engine services are not a
/// `Bridge` (an embedded runtime's) calls it from its own native dispatch.
pub effect fn call<'w>(bridge: &mut Bridge, function: u32, argv: Arguments<'w>) -> Outcome ! OutOfMemoryError ? &mut Allocator {
  let first = id(argv.get(0).view())
  if function == CREATE {
    run bridge.batch.create(first, nodeKind(id(argv.get(1).view())))
  } else if function == APPEND {
    run bridge.batch.append(first, id(argv.get(1).view()))
  } else if function == INSERT_BEFORE {
    run bridge.batch.insertBefore(first, id(argv.get(1).view()), id(argv.get(2).view()))
  } else if function == ROOT {
    run bridge.batch.root(first)
  } else if function == SET_TEXT {
    let value = run text(argv.get(1))
    run bridge.batch.setText(first, String.view(&value))
  } else if function == LISTEN {
    run bridge.batch.listen(first, id(argv.get(1).view()))
  } else if function == COMPILE_STYLE_SHEET {
    let source = run text(argv.get(0))
    let compiled = bridge.stylesheetCompiler.call(String.utf8Bytes(String.view(&source)))
    if let Option<Bytes>.Some { value } = move compiled {
      let encoded = run stylesheets.encoded(value.asSlice())
      let made = run Effect.result(Strings.fromUtf8(String.utf8Bytes(String.view(&encoded))))
      return match move made {
        Result.Success { value: text } => Outcome.Returned { value: text }
        Result.Failure { .. } => { fail OutOfMemoryError {} }
      }
    }
    let mut message = List<u8>.make()
    run message.appendSlice(b"runtime CSS compilation is disabled or the stylesheet could not be compiled")
    return Outcome.TypeError { message: move message }
  } else if function == STYLE_SHEET {
    let encoded = run text(argv.get(2))
    if !(run stylesheets.apply(&mut bridge.batch, first, id(argv.get(1).view()), String.view(&encoded))) {
      let mut message = List<u8>.make()
      run message.appendSlice(b"invalid compiled stylesheet or stylesheet operation")
      return Outcome.TypeError { message: move message }
    }
  } else if function == STYLE {
    let css = run text(argv.get(1))
    run applyStyle(&mut bridge.batch, first, styleState(id(argv.get(2).view())), &css)
  } else if function == CLEAR_STYLE {
    run bridge.batch.push(Mutation.ClearStyle { id: first, state: styleState(id(argv.get(1).view())) })
  } else if function == ATTRIBUTE {
    let attribute = run text(argv.get(1))
    if String.view(&attribute) == "valueRange" {
      let range = if argv.get(2).view().isNumber() {
        Attribute.ValueRange { min: f64.toF32(number(argv.get(2).view())), max: f64.toF32(number(argv.get(3).view())), value: f64.toF32(number(argv.get(4).view())) }
      } else { Attribute.ClearValueRange }
      run bridge.batch.attribute(first, move range)
      return Outcome.Returned { value: ValueBits.Undefined }
    }
    let value = run argOf(argv.get(2))
    return match run setAttribute(&mut bridge.batch, first, String.view(&attribute), &value) {
      Applied.Set => Outcome.Returned { value: ValueBits.Undefined }
      Applied.Known { value: known } => Outcome.Returned { value: ValueBits.Bool { value: known } }
      Applied.Missing => {
        let mut message = List<u8>.make()
        run message.appendSlice(b"the tree has no attribute '")
        run message.appendSlice(String.utf8Bytes(String.view(&attribute)))
        run message.append(39)
        Outcome.TypeError { message: move message }
      }
    }
  } else if function == FOCUS {
    run bridge.batch.focus(first)
  } else if function == REMOVE {
    run bridge.batch.push(Mutation.Remove { id: first })
  } else if function == DESTROY {
    run bridge.batch.push(Mutation.Destroy { id: first })
  } else if function == SCROLL_TO {
    run bridge.batch.scrollTo(first, f64.toF32(number(argv.get(1).view())), f64.toF32(number(argv.get(2).view())))
  } else if function == LOG {
    let line = run text(argv.get(1))
    run bridge.logs.append(LogEntry { level: first, text: move line })
  } else if function == NOW {
    return Outcome.Returned { value: ValueBits.number(bridge.now) }
  } else if function == TIMER {
    drop bridge.cancel(first)
    let delay = number(argv.get(1).view())
    run bridge.timers.append(Timer { id: first, due: bridge.now + if delay > 0.0 { delay } else { 0.0 } })
  } else if function == CANCEL_TIMER {
    drop bridge.cancel(first)
  } else if function == REQUEST_FRAME {
    bridge.frame = true
  } else if function == DEV_SEND {
    let line = run text(argv.get(0))
    run bridge.outbox.append(move line)
  } else if function == OPEN {
    let address = run text(argv.get(0))
    run bridge.opened.append(move address)
  } else if function == CLIPBOARD_READ {
    run bridge.clipboard.append(ClipboardRequest.Read { call: first })
  } else if function == CLIPBOARD_WRITE {
    let value = run text(argv.get(1))
    run bridge.clipboard.append(ClipboardRequest.Write { call: first, text: move value })
  } else if function == SHELL {
    let packed = run text(argv.get(2))
    run bridge.shell.append(ShellRequest { call: first, op: id(argv.get(1).view()), text: move packed })
  } else if function == DEV_RELOAD {
    bridge.reload = true
  } else if function == FONT_FAMILY {
    let names = run text(argv.get(1))
    run bridge.batch.fontFamily(first, String.view(&names))
  } else if function == DEFINE_ICON {
    let markup = run text(argv.get(1))
    run bridge.batch.icon(first, String.utf8Bytes(String.view(&markup)))
  } else if function == SOURCE {
    run bridge.batch.source(first, id(argv.get(1).view()))
  } else if function == LOAD {
    let url = run text(argv.get(1))
    if truthy(argv.get(2).view()) {
      run bridge.batch.loadIcon(first, String.view(&url))
    } else {
      run bridge.batch.loadImage(first, String.view(&url))
    }
  } else if function == RELEASE {
    run bridge.batch.releaseResource(first)
  } else if function == MARKDOWN {
    let source = run text(argv.get(0))
    let json = run markdown.json(String.view(&source), id(argv.get(1).view()))
    let made = run Effect.result(Strings.fromUtf8(json.asSlice()))
    return match move made {
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Success { value } => Outcome.Returned { value: value }
      Result<ValueBits, OutOfMemoryError | StringLengthError>.Failure { error } => match move error {
        OutOfMemoryError allocation => { fail move allocation }
        StringLengthError _ => {
          let mut message = List<u8>.make()
          run message.appendSlice(b"the markdown tree is too long for a string")
          Outcome.TypeError { message: move message }
        }
      }
    }
  } else if function == KEYFRAME {
    let css = run text(argv.get(1))
    let declarations = run declarationsOf(&css)
    let offset = f64.toF32(number(argv.get(0).view()))
    run bridge.frames.append(Keyframe { offset: offset, declarations: move declarations })
  } else if function == KEYFRAMES {
    let name = run text(argv.get(0))
    let frames = Intrinsic.replace(bridge.frames, List<Keyframe>.make())
    run bridge.batch.keyframes(String.view(&name), move frames)
  } else if function == RICH_TEXT {
    let value = run text(argv.get(1))
    let packedMarks = run text(argv.get(2))
    let packedAtoms = run text(argv.get(3))
    let marks = run unpackMarks(String.view(&packedMarks))
    let atoms = run unpackAtoms(String.view(&packedAtoms))
    run bridge.batch.push(Mutation.SetRichText { id: first, value: move value, marks: move marks, atoms: move atoms })
  } else if function == MARK || function == ATOM_STYLE {
    let css = run text(argv.get(2))
    let declarations = run declarationsOf(&css)
    let key = id(argv.get(1).view())
    if function == MARK {
      run bridge.batch.push(Mutation.DefineMark { id: first, mark: key, declarations: move declarations })
    } else {
      run bridge.batch.push(Mutation.DefineAtom { id: first, kind: key, declarations: move declarations })
    }
  } else if function == FORMAT {
    run bridge.batch.format(first, id(argv.get(1).view()), truthy(argv.get(2).view()))
  } else if function == INSERT_ATOM {
    let packed = run text(argv.get(3))
    let mut atoms = run unpackAtoms(String.view(&packed))
    match atoms.pop() {
      Option<Atom>.Some { value: atom } => {
        run bridge.batch.insertAtom(first, f64.toUsize(number(argv.get(1).view())), f64.toUsize(number(argv.get(2).view())), move atom)
      }
      Option<Atom>.None => ()
    }
  } else if function == SELECT {
    run bridge.batch.select(first, f64.toUsize(number(argv.get(1).view())), f64.toUsize(number(argv.get(2).view())))
  }
  return Outcome.Returned { value: ValueBits.Undefined }
}

impl EngineServices for Bridge {
  /// A realm here has ECMAScript without ECMA-402 or Temporal (the prelude installs neither),
  /// so their code and CLDR tables stay out of the program.
  fn includesIntl<'m>(engine: &Engine<'m, Self>) -> bool { return false }
  fn includesTemporal<'m>(engine: &Engine<'m, Self>) -> bool { return false }
  /// No host globals: a shadow realm has its intrinsics alone.
  effect fn initializeShadowRealm<'r, 's, 'm>(engine: &mut Engine<'m, Self>, caller: Realm<'r>, created: Realm<'s>) -> () ! JsException ? &mut Allocator {}

  effect fn dynamicImportStarted<'r, 'v, 'w, 'x, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>, specifier: ValueRef<'v>, referrer: ValueRef<'w>, promise: ValueRef<'x>) -> ValueBits ! JsException ? &mut Allocator {
    return promise.dup().intoBits()
  }

  effect fn nativeGeneric<'r, 'v, 'm, 'w>(engine: &mut Engine<'m, Self>, function: u32, realm: Realm<'r>,
    receiver: ValueRef<'v>, argc: i32, argv: Arguments<'w>) -> ValueBits ! OutOfMemoryError | JsException ? &mut Allocator {
    let outcome = run call(&mut engine.services, function, argv)
    return match move outcome {
      Outcome.Returned { value } => value
      Outcome.TypeError { message } => run engine.throwError(realm, NativeErrorKind.Type, message.asSlice())
    }
  }

  /// Keeps a promise rejected with no handler, and lets go of it when a handler is added.
  unsafe effect fn promiseRejection<'r, 'v, 'w, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, promise: ValueRef<'v>, reason: ValueRef<'w>, event: u32, opaque: ?*mut u8) -> () ? &mut Allocator {
    // 0: rejected with no handler, 1: handler added later; later codes are double settles.
    if event > 1 { return () }
    let handled = event == 1
    let items = engine.services.rejections.asSlice()
    let mut i: usize = 0
    while i < items.length {
      if unsafe core.sameValue(items[i].promise.view(), promise.view()) {
        if handled {
          let Rejected { promise: kept, reason: why } = engine.services.rejections.remove(i)
          realm.release(&mut engine, move kept)
          realm.release(&mut engine, move why)
        }
        return
      }
      i = i + 1
    }
    if handled { return }
    // Without memory for the entry the rejection goes unreported.
    let entry = Rejected { promise: promise.dup(), reason: reason.dup() }
    drop run Effect.result(engine.services.rejections.append(move entry))
  }

  /// A module the application defined, compiled when something first imports it.
  unsafe effect fn loadModule<'r, 'v, 'm>(engine: &mut Engine<'m, Self>, realm: Realm<'r>,
    callback: NativeFunctionId, opaque: ?*mut u8, name: &[u8], attributes: ValueRef<'v>) -> CellRef<ModuleDef> ! OutOfMemoryError | JsException ? &mut Allocator {
    let source = match engine.services.find(name) {
      Option<usize>.Some { value: index } => {
        let mut copy = List<u8>.make()
        run copy.appendSlice(engine.services.modules.asSlice()[index].source.asSlice())
        move copy
      }
      Option<usize>.None => {
        let mut message = List<u8>.make()
        run message.appendSlice(b"could not load module '")
        run message.appendSlice(name)
        run message.append(39)
        return run engine.throwError(realm, NativeErrorKind.Reference, message.asSlice())
      }
    }
    let memory = engine.memory
    let compiled = run evaluation.evaluate(&mut engine, memory, realm, source.asSlice(), name, flags.TYPE_MODULE | flags.FLAG_COMPILE_ONLY)
    return match compiled.view() {
      ValueBits.Module { reference } => unsafe CellRef<ModuleDef>.of(reference)
      _ => Intrinsic.trap("the module compiler returned something else")
    }
  }
}
