//! The memory of this process as the system's own tools show it to users: macOS's
//! `phys_footprint` (Activity Monitor's "Memory"), Linux's proportional set size (`Pss`) and
//! Windows's private bytes (`PrivateUsage`). Each read makes one or three system calls and
//! allocates nothing, so a page can ask every second.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.mem.pointer { Pointer }
  import silk.num.u32
  import silk.num.u64

  // Declared as `silk.system.system_info_native` declares them: two declarations of one C
  // symbol must agree (SEM0192).
  unsafe extern "C" static taskPort: u32 as "mach_task_self_"
  unsafe extern "C" fn task_info(task: u32, flavor: u32, info: ?[*]mut u32, count: *mut u32) -> i32

  fn taskSelf() -> u32 { unsafe { return taskPort } }

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    // `TASK_VM_INFO` (22) fills as many revisions of `task_vm_info` as the buffer holds; the
    // 64-bit `phys_footprint` is in words 36 and 37 from revision 1 on.
    let mut info: [u32; 128] = [0; 128]
    let mut count: u32 = 128
    let status = unsafe task_info(taskSelf(), 22, Pointer.fromMutSlice<u32>(&mut info), Pointer.fromMutRef<u32>(&mut count))
    if status != 0 || count < 38 { return 0 }
    return u64.shiftLeft(u32.toU64(info[37]), 32) | u32.toU64(info[36])
  }
} else {
static if Intrinsic.targetOperatingSystem() == "linux" {
  import silk.mem.pointer { Pointer }
  import silk.num.isize
  import silk.num.u8
  import silk.num.u64
  import silk.num.usize

  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize

  // `O_RDONLY | O_CLOEXEC`.
  const READ_ONLY: i32 = 524288

  /// The start of the file at `path` (ending in a zero byte) in `buffer`, and its length; 0 when
  /// it cannot be read.
  fn readStart(path: &[u8], buffer: &mut [u8]) -> usize {
    let fd = unsafe open(Pointer.fromSlice<u8>(path), READ_ONLY)
    if fd < 0 { return 0 }
    let capacity = buffer.length
    let base = Pointer.fromMutSlice<u8>(move buffer)
    let mut total: usize = 0
    while total < capacity {
      let mut transferred: isize = 0
      unsafe {
        let start = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(base)
        transferred = read(fd, Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(start, total)), capacity - total)
      }
      if transferred <= 0 { break }
      total = total + isize.toUsize(transferred)
    }
    let _closed = unsafe close(fd)
    return total
  }

  /// The number after `key` on the line that starts with it, times `scale`; 0 when no line does.
  fn field(values: &[u8], length: usize, key: &[u8], scale: u64) -> u64 {
    let mut line: usize = 0
    while line < length {
      let mut matches = line + key.length <= length
      let mut at: usize = 0
      while matches && at < key.length {
        matches = values[line + at] == key[at]
        at = at + 1
      }
      let mut index = line + key.length
      if matches {
        while index < length && values[index] == 32 { index = index + 1 }
        let mut value: u64 = 0
        while index < length && values[index] >= 48 && values[index] <= 57 {
          value = value * 10 + u8.toU64(values[index] - 48)
          index = index + 1
        }
        return value * scale
      }
      index = line
      while index < length && values[index] != 10 { index = index + 1 }
      line = index + 1
    }
    return 0
  }

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    // `smaps_rollup` (Linux 4.14 on) is about 20 short lines, `Pss:` among the first.
    let mut table: [u8; 2048] = [0; 2048]
    let length = readStart(b"/proc/self/smaps_rollup\0", &mut table)
    return field(&table, length, b"Pss:", 1024)
  }
} else {
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.mem.pointer { Pointer }
  import silk.num.u64

  // `PROCESS_MEMORY_COUNTERS_EX` on 64-bit Windows: `cb`, `PageFaultCount`, then nine sizes,
  // `PrivateUsage` last.
  extern "C" struct Counters {
    size: u32,
    pageFaults: u32,
    peakWorkingSet: u64,
    workingSet: u64,
    peakPagedPool: u64,
    pagedPool: u64,
    peakNonPagedPool: u64,
    nonPagedPool: u64,
    pagefile: u64,
    peakPagefile: u64,
    privateUsage: u64,
  }

  unsafe extern "C" fn GetCurrentProcess() -> ?*mut u8
  // kernel32's export of psapi's `GetProcessMemoryInfo`, so nothing more is linked.
  unsafe extern "C" fn K32GetProcessMemoryInfo(process: ?*mut u8, counters: *mut Counters, size: u32) -> i32

  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    let mut counters = Counters { size: 80, pageFaults: 0, peakWorkingSet: 0, workingSet: 0, peakPagedPool: 0, pagedPool: 0, peakNonPagedPool: 0, nonPagedPool: 0, pagefile: 0, peakPagefile: 0, privateUsage: 0 }
    if unsafe K32GetProcessMemoryInfo(unsafe GetCurrentProcess(), Pointer.fromMutRef<Counters>(&mut counters), 80) == 0 { return 0 }
    return counters.privateUsage
  }
} else {
  /// The process's footprint in bytes, or 0 when the system cannot say.
  pub fn footprint() -> u64 {
    return 0
  }
}
}
}
