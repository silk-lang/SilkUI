//! Desktop calls of a ui-js application (notifications, the tray, global shortcuts), served
//! on the window's platform, and the platform's desktop events, handed to JavaScript.
import ui_js.lib { JsHost, JsError, ShellRequest }
import ui_tree.legacy { UiTree }
import ui_tree.cssom_view { elementFromPoint }
import ui_tree_window.keys { codeName }
import ui_tree_window.platform_thread { HostPlatform }
import window.event { Event, Modifiers, MouseButton }
import window.keys { KeyCode, keyCodeFromValue }
import window.menu { MenuBar, Shortcut }
import window.platform { Platform }
import window.shell { Notification, Tray, TrayIcon }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.text.string { String }

/// Whether shortcuts take Command where other systems take Control.
const COMMAND_KEY: bool = Intrinsic.targetOperatingSystem() == "darwin"

/// The host's answer to a `__ui.shell` call.
pub struct ShellAnswer {
  pub call: u32,
  pub value: f64,
}

/// Does JavaScript's desktop calls `requests` on `platform`, oldest first.
pub effect fn serveShell(requests: List<ShellRequest>, platform: &mut HostPlatform) -> List<
  ShellAnswer
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rest = move requests
  let mut answers = List<ShellAnswer>.make()
  while rest.length() > 0 {
    let request = rest.remove(0)
    let mut fields = List<string>.make()
    run split(String.view(&request.text), 31, &mut fields)
    let value = if request.op == 0 {
      let notification = Notification { title: field(&fields, 0), body: field(&fields, 1) }
      u32.toF64(run platform.notify(&notification))
    } else if request.op == 1 {
      run setTray(&fields, &mut platform)
    } else if request.op == 2 {
      Platform.removeTray(&mut platform.*)
      0.0
    } else if request.op == 3 {
      let code = codeOf(field(&fields, 1))
      let bits = number(field(&fields, 2))
      let modifiers = Modifiers {
        shift: (bits & 1) != 0,
        control: (bits & 2) != 0 || ((bits & 16) != 0 && !COMMAND_KEY),
        alt: (bits & 4) != 0,
        meta: (bits & 8) != 0 || ((bits & 16) != 0 && COMMAND_KEY),
        capsLock: false,
        function: false,
      }
      let held = code != KeyCode.Unidentified
        && run platform.registerShortcut(number(field(&fields, 0)), code, modifiers)
      if held {
        1.0
      } else {
        0.0
      }
    } else if request.op == 4 {
      Platform.unregisterShortcut(&mut platform.*, number(field(&fields, 0)))
      0.0
    } else {
      0.0
    }
    run answers.append(ShellAnswer { call: request.call, value: value })
  }
  return move answers
}

effect fn setTray(fields: &List<string>, platform: &mut HostPlatform) -> f64
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = number(field(fields, 1))
  let height = number(field(fields, 2))
  let mut pixels = List<u8>.make()
  let hex = String.utf8Bytes(field(fields, 4))
  let mut i: usize = 0
  while i + 1 < hex.length {
    run pixels.append(nibble(hex[i]) * 16 + nibble(hex[i + 1]))
    i = i + 2
  }
  if u32.toUsize(width) * u32.toUsize(height) * 4 != pixels.length() || width == 0 {
    return 0.0
  }
  let mut menu = MenuBar.make()
  let mut lines = List<string>.make()
  run split(field(fields, 5), 10, &mut lines)
  let mut depth: u32 = 0
  let mut l: usize = 0
  while l < lines.length() {
    let text = lines.get(l)
    let line = String.utf8Bytes(text)
    l = l + 1
    if line.length == 0 {
      continue
    }
    let rest = String.slice(text, 1, line.length - 1)
    if line[0] == 66 {
      run menu.begin(rest)
      depth = depth + 1
    } else if line[0] == 69 {
      if depth > 0 {
        run menu.end()
        depth = depth - 1
      }
    } else if line[0] == 83 {
      run menu.separator()
    } else if line[0] == 65 {
      let mut parts = List<string>.make()
      run split(rest, 44, &mut parts)
      if parts.length() < 4 {
        continue
      }

      // The title is everything after the third comma; it may hold commas of its own.
      let bytes = String.utf8Bytes(rest)
      let mut start: usize = 0
      let mut commas: u32 = 0
      while start < bytes.length && commas < 3 {
        if bytes[start] == 44 {
          commas = commas + 1
        }
        start = start + 1
      }
      let title = String.slice(rest, start, bytes.length - start)
      run menu.item(
        title,
        number(parts.get(0)),
        Option<Shortcut>.None,
        number(parts.get(1)) != 0,
        number(parts.get(2)) != 0,
      )
    }
  }
  while depth > 0 {
    run menu.end()
    depth = depth - 1
  }
  let tray = Tray {
    icon: TrayIcon {
      width: width,
      height: height,
      pixels: pixels.asSlice(),
      template: number(field(fields, 3)) != 0,
    },
    tooltip: field(fields, 0),
    menu: &menu,
  }
  return if run platform.setTray(&tray) {
    1.0
  } else {
    0.0
  }
}

/// A desktop event as `__ui.shellEvent(kind, a, x, y, text)` takes it (see
/// `JsHost.shellEvent`).
pub struct ShellEvent {
  pub kind: u32,
  pub a: f64,
  pub x: f64,
  pub y: f64,
  pub text: String,
}

/// `event` as JavaScript takes it, when it is a desktop event: a file drag (aimed at the node
/// under it in `tree`), a global shortcut, the tray or a notification click.
pub effect fn shellEventOf(tree: &UiTree<'_>, event: &Event) -> Option<ShellEvent>
  ! OutOfMemoryError
  ? &mut Allocator {
  let made = match &event.* {
    Event.FileDragEntered { position, paths, .. } => ShellEvent {
      kind: 0,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: run lines(paths.asSlice()),
    }
    Event.FileDragMoved { position, .. } => ShellEvent {
      kind: 1,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: String.make(),
    }
    Event.FileDragLeft { .. } => ShellEvent { kind: 2, a: 0.0, x: 0.0, y: 0.0, text: String.make() }
    Event.FileDropped { position, paths, .. } => ShellEvent {
      kind: 3,
      a: u32.toF64(elementFromPoint(tree, position.x, position.y)),
      x: position.x,
      y: position.y,
      text: run lines(paths.asSlice()),
    }
    Event.GlobalShortcut { id } => ShellEvent {
      kind: 4,
      a: u32.toF64(id),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.TrayClicked { button } => ShellEvent {
      kind: 5,
      a: match button {
        MouseButton.Middle => 1.0
        MouseButton.Right => 2.0
        _ => 0.0
      },
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.MenuAction { action } => ShellEvent {
      kind: 6,
      a: u32.toF64(action),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    Event.NotificationClicked { id } => ShellEvent {
      kind: 7,
      a: u32.toF64(id),
      x: 0.0,
      y: 0.0,
      text: String.make(),
    }
    _ => {
      return Option<ShellEvent>.None
    }
  }
  return Option<ShellEvent>.some(move made)
}

/// Hands a desktop event of the platform to JavaScript. Says whether `event` was one.
pub effect fn deliverShell(host: &mut JsHost<'_>, tree: &UiTree<'_>, event: &Event) -> bool
  ! OutOfMemoryError | JsError
  ? &mut Allocator {
  let made = run shellEventOf(tree, event)
  return match move made {
    Option<ShellEvent>.Some { value } => {
      run host.shellEvent(value.kind, value.a, value.x, value.y, String.view(&value.text))
      true
    }
    Option<ShellEvent>.None => false
  }
}

effect fn lines(paths: &[String]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut joined = String.make()
  let mut i: usize = 0
  while i < paths.length {
    if i > 0 {
      run joined.append("\n")
    }
    run joined.append(String.view(&paths[i]))
    i = i + 1
  }
  return move joined
}

/// The pieces of `bytes` between the `separator` bytes, in `out`.
effect fn split<'a>(text: string<'a>, separator: u8, out: &mut List<string<'a>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut i: usize = 0
  while i <= bytes.length {
    if i == bytes.length || bytes[i] == separator {
      run out.append(String.slice(text, start, i - start))
      start = i + 1
    }
    i = i + 1
  }
}

fn field<'a>(fields: &List<string<'a>>, at: usize) -> string<'a> {
  return if at < fields.length() {
    fields.get(at)
  } else {
    ""
  }
}

fn number(text: string) -> u32 {
  let bytes = String.utf8Bytes(text)
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
    value = value * 10 + u8.toU32(bytes[i] - 48)
    i = i + 1
  }
  return value
}

fn nibble(digit: u8) -> u8 {
  if digit >= 48 && digit <= 57 {
    return digit - 48
  }
  if digit >= 97 && digit <= 102 {
    return digit - 87
  }
  if digit >= 65 && digit <= 70 {
    return digit - 55
  }
  return 0
}

/// The key whose UI Events `code` is `name`.
fn codeOf(name: string) -> KeyCode {
  let mut value: u32 = 1
  while value < 129 {
    let code = keyCodeFromValue(value)
    if codeName(code) == name {
      return code
    }
    value = value + 1
  }
  return KeyCode.Unidentified
}
