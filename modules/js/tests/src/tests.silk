import caniuse as _caniuse
import window_sheets as _window_sheets
import window_frames as _window_frames
//! ui-js tests: a JavaScript counter builds its nodes through the bridge, handles events
//! between the tree's begin and finish, and reports what it throws.
//! Run from the repository root (the fixtures read fonts and scripts from there).
import ui_js.lib { JsHost, JsError, ClipboardRequest, runtimeStylesheets, Natives, Reply, Exports, serve }
import ui_js_calls.natives as natives
import ui_js_calls.lib { Arg }
import ui_js.bridge as bridge
import ui_tree.lib { Tree, TreeError, ProtocolError, Viewport, NodeId, Input, StyleState, Role, Live, TriState }
import ui_fixtures.fixtures as fixtures
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }
import silkjs.js_libc_platform as platform
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer }

fn viewport() -> Viewport {
  return Viewport { width: 400.0, height: 300.0, scale: 1.0 }
}

fn focusIs(tree: &Tree<'_>, id: u32) -> bool {
  return match tree.focused() {
    Option.Some { value } => value.raw() == id
    Option.None => false
  }
}

effect fn labelIs(tree: &Tree<'_>, expected: string) -> bool {
  return match tree.view(NodeId.of(4)) {
    Option.Some { value } => value.text() == expected
    Option.None => false
  }
}

/// The counter's ids: 1 the root, 2 the field, 3 the button, 4 the label. The button sits
/// below the 30 pixel field, so (10, 50) is inside it.
effect fn counter(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let source = run platform.readFile(b"modules/js/tests/fixtures/counter.js")
  run host.evaluate(source.asSlice(), b"counter.js")
  run Testing.expect(host.pending() != 0, "the script queued mutations and applied none")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(focusIs(&tree.*, 2), "the script focused the field")
  run Testing.expect(run labelIs(&tree.*, "Click me"), "the label holds its first text")

  // The pointerdown handler runs before the default and prevents it: focus stays.
  run host.input(&mut tree, Input.press(10.0, 50.0))
  run host.input(&mut tree, Input.release(10.0, 50.0))
  run Testing.expect(focusIs(&tree.*, 2), "a prevented press keeps focus on the field")
  run Testing.expect(run labelIs(&tree.*, "Clicked 1"), "and the click handler still ran")

  // The same press without preventDefault moves focus to the button.
  run host.evaluate(b"keepFocus = false", b"test")
  run host.input(&mut tree, Input.press(10.0, 50.0))
  run host.input(&mut tree, Input.release(10.0, 50.0))
  run Testing.expect(focusIs(&tree.*, 3), "an unprevented press focuses the button")
  run Testing.expect(run labelIs(&tree.*, "Clicked 2"), "the second click counted")

  // The handler saw the pointer position.
  run host.evaluate(b"if (lastPoint !== '10,50') throw new Error('point was ' + lastPoint)", b"test")
}

/// An uncaught exception comes back as its message, and the host keeps working after it.
effect fn errors(host: &mut JsHost<'_>) -> ()
  ! OutOfMemoryError | JsError | AssertionError<'static>
  ? &mut Allocator {
  let failed = run Effect.result(host.evaluate(b"throw new TypeError('nope')", b"test"))
  match move failed {
    Result<(), OutOfMemoryError | JsError>.Success { .. } => { run Testing.expect(false, "a throw must fail the evaluation") }
    Result<(), OutOfMemoryError | JsError>.Failure { error } => {
      match move error {
        JsError { message } => { run Testing.expect(String.view(&message) == "TypeError: nope", "the message names the error") }
        OutOfMemoryError allocation => { fail move allocation }
      }
    }
  }
  run host.evaluate(b"globalThis.after = 1 + 1", b"test")
  // The engine is built without Intl and Temporal: the methods ECMAScript has without them
  // still work, with their locale-independent results.
  run host.evaluate(b"if (typeof Intl !== 'undefined' || typeof Temporal !== 'undefined') throw new Error('Intl or Temporal installed'); const d = new Date(0).toString(); if (!/^\\w{3} \\w{3} \\d\\d \\d{4} \\d\\d:\\d\\d:\\d\\d GMT[+-]\\d{4}$/.test(d)) throw new Error('date was ' + d); if ('a'.localeCompare('b') !== -1 || 'b'.localeCompare('a') !== 1) throw new Error('localeCompare'); if ('i'.toLocaleUpperCase() !== 'I') throw new Error('toLocaleUpperCase'); if (['b', 'a', 'c'].sort((x, y) => x.localeCompare(y)).join() !== 'a,b,c') throw new Error('sort'); if ((1234.5).toLocaleString() !== '1234.5') throw new Error('toLocaleString was ' + (1234.5).toLocaleString())", b"test")
}

effect fn fails(host: &mut JsHost<'_>, source: &[u8], expected: string, what: string<'static>) -> ()
  ! OutOfMemoryError | JsError | AssertionError<'static>
  ? &mut Allocator {
  let failed = run Effect.result(host.evaluate(source, b"test"))
  match move failed {
    Result<(), OutOfMemoryError | JsError>.Success { .. } => { run Testing.expect(false, what) }
    Result<(), OutOfMemoryError | JsError>.Failure { error } => {
      match move error {
        JsError { message } => { run Testing.expect(String.view(&message) == expected, what) }
        OutOfMemoryError allocation => { fail move allocation }
      }
    }
  }
}

effect fn click(host: &mut JsHost<'_>, tree: &mut Tree<'_>, x: f32, y: f32) -> ()
  ! ProtocolError | OutOfMemoryError | JsError
  ? &mut Allocator {
  run host.input(&mut tree, Input.press(x, y))
  run host.input(&mut tree, Input.release(x, y))
}

/// The same counter as an ES module on @silkui/core: DOM style listeners with capture and
/// bubbling, promise jobs before the mutations apply, typing, removal, and a listener that
/// throws.
effect fn library(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  let source = run platform.readFile(b"modules/js/tests/fixtures/app.js")
  run host.module(source.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(focusIs(&tree.*, 2), "the module focused the field")
  run Testing.expect(run labelIs(&tree.*, "Click me"), "the label holds its first text")
  let named = match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.testId() == "counter"
    Option.None => false
  }
  run Testing.expect(named, "setAttribute reached the tree")
  // The hover look holds its two declarations; the base look lost the margin it set and
  // then took out, and keeps width, height and background.
  let looks = match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.style(StyleState.Hover).length == 2 && value.style(StyleState.Base).length == 3
    Option.None => false
  }
  run Testing.expect(looks, "the looks hold what the module set")

  // Capture runs from the root down, then the target, then the bubble back up; the promise
  // job the click queued ran before the mutations were applied.
  run click(&mut host, &mut tree, 10.0, 50.0)
  run Testing.expect(focusIs(&tree.*, 2), "a prevented press keeps focus on the field")
  run Testing.expect(run labelIs(&tree.*, "Clicked 1"), "the promise job set the label")
  run host.evaluate(b"if (log.join(';') !== 'root capture 1;button 10,50 true;root bubble 3') throw new Error('order was ' + log.join(';'))", b"test")

  run host.evaluate(b"keepFocus = false", b"test")
  run click(&mut host, &mut tree, 10.0, 50.0)
  run Testing.expect(focusIs(&tree.*, 3), "an unprevented press focuses the button")

  // stopPropagation at the button keeps the root's bubble listener out.
  run host.evaluate(b"log.length = 0; app.button.addEventListener('click', (event) => event.stopPropagation())", b"test")
  run click(&mut host, &mut tree, 10.0, 50.0)
  run host.evaluate(b"if (log.join(';') !== 'root capture 1;button 10,50 true') throw new Error('order was ' + log.join(';'))", b"test")

  // Typing reaches the input listener with the value, and the Input node follows it.
  run click(&mut host, &mut tree, 10.0, 10.0)
  run Testing.expect(focusIs(&tree.*, 2), "a press on the field focuses it")
  run host.input(&mut tree, run Input.text("hi"))
  run host.evaluate(b"if (typed !== 'hi|insertText|hi') throw new Error('typed was ' + typed)", b"test")
  run host.input(&mut tree, run Input.key("Escape"))
  run host.evaluate(b"if (lastKey !== 'Escape') throw new Error('key was ' + lastKey)", b"test")

  // Transforms from a style object: pointers find a turned box where it shows, and
  // transitions and linear() easings read from the same text.
  run host.evaluate(b"const turned = app.createBox({ position: 'absolute', left: 300, top: 200, width: 40, height: 20, transform: 'rotate(90deg)', transformOrigin: '50% 50%', transition: 'transform 1s linear(0, 0.5 25%, 1)' }); turned.addEventListener('click', () => { globalThis.turnedHit = true }); app.root.append(turned); globalThis.turned = turned", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.5)
  run click(&mut host, &mut tree, 320.0, 195.0)
  run host.evaluate(b"if (!turnedHit) throw new Error('the turned box missed its click'); turned.remove()", b"test")
  run host.flush(&mut tree)

  run host.evaluate(b"app.root.style.set({'--Native-Gap': '13px'}); app.button.style.set({width: 'calc(var(--Native-Gap) * 10)'})", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.6)
  run Testing.expect(match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.computed().layout.width.value == 130.0
    Option.None => false
  }, "JavaScript custom properties inherit into style-object calc values")
  run host.evaluate(b"app.root.style.set({'--Native-Gap': null}); app.button.style.set({width: 'var(--Native-Gap,120px)'})", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.7)
  run Testing.expect(match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.computed().layout.width.value == 120.0
    Option.None => false
  }, "removing a JavaScript custom property clears native tokens and restores the fallback")

  // A listener that throws does not stop the others, and the host reports it afterwards.
  run host.evaluate(b"log.length = 0; app.root.addEventListener('click', () => { throw new Error('boom') }, true)", b"test")
  let failed = run Effect.result(click(&mut host, &mut tree, 10.0, 50.0))
  match move failed {
    Result<(), ProtocolError | OutOfMemoryError | JsError>.Success { .. } => { run Testing.expect(false, "a listener that throws must be reported") }
    Result<(), ProtocolError | OutOfMemoryError | JsError>.Failure { error } => {
      match move error {
        JsError { message } => { run Testing.expect(String.view(&message) == "Error: boom", "the report carries the listener's error") }
        ProtocolError protocol => { fail move protocol }
        OutOfMemoryError allocation => { fail move allocation }
      }
    }
  }

  // An attribute the tree does not have is an error the application sees.
  run fails(&mut host, b"app.root.setAttribute('nope', 1)", "TypeError: the tree has no attribute 'nope'", "an unknown attribute throws")

  // role takes the first ARIA role the tree has, and aria-* reach the tree's attributes.
  run host.evaluate(b"globalThis.warnings = []; console.warn = (m) => warnings.push(m); app.button.setAttribute('role', 'fancy switch checkbox'); app.button.setAttribute('aria-label', 'Save'); app.button.setAttribute('aria-checked', 'true'); app.button.setAttribute('aria-valuenow', 3); app.button.setAttribute('aria-valuemax', 5); app.button.setAttribute('ariaLevel', 2); app.button.setAttribute('aria-live', 'assertive'); app.button.setAttribute('aria-pressed', 'mixed'); if (warnings.length !== 0) throw new Error('warned ' + warnings)", b"test")
  run host.flush(&mut tree)
  let semantics = match tree.view(NodeId.of(3)) {
    Option.Some { value } => {
      let ranged = match value.valueRange() {
        Option.Some { value: range } => range.min == 0.0 && range.max == 5.0 && range.value == 3.0
        Option.None => false
      }
      value.accessRole() == Role.Switch && value.label() == "Save" && value.checked() && ranged
        && value.level() == 2 && value.live() == Live.Assertive && value.pressed() == TriState.Mixed
    }
    Option.None => false
  }
  run Testing.expect(semantics, "role and aria-* reached the tree")
  run host.evaluate(b"app.button.setAttribute('role', 'fancy'); if (warnings.length !== 1) throw new Error('an unknown role must warn')", b"test")
  run host.flush(&mut tree)
  let cleared = match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.accessRole() == Role.None
    Option.None => false
  }
  run Testing.expect(cleared, "an unknown role leaves the node without a role")

  // A removed node leaves the tree and takes no more events.
  run host.evaluate(b"log.length = 0; app.button.remove()", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 1.0)
  let detached = match tree.view(NodeId.of(3)) {
    Option.Some { value } => value.parent().isNone()
    Option.None => false
  }
  run Testing.expect(detached, "remove detached the button")
  run host.evaluate(b"if (app.root.childNodes.length !== 1 || app.button.parentNode !== null) throw new Error('the JavaScript tree kept the button')", b"test")
}

/// Timers fire in order of their time when the host ticks, intervals repeat until cleared,
/// animation frame callbacks run on a tick with animation, and console lines reach the host.
effect fn globals(host: &mut JsHost<'_>) -> ()
  ! OutOfMemoryError | JsError | AssertionError<'static>
  ? &mut Allocator {
  run host.evaluate(b"globalThis.order = []; setTimeout(() => order.push('b'), 20); setTimeout((x) => order.push(x), 10, 'a'); const every = setInterval(() => { order.push('i'); if (order.filter((x) => x === 'i').length === 2) clearInterval(every) }, 15); clearTimeout(setTimeout(() => order.push('never'), 5)); requestAnimationFrame((time) => order.push('frame ' + time)); queueMicrotask(() => order.push('micro')); console.log('hello', { a: [1, 'x'] }, 2); console.error(new TypeError('bad').message)", b"test")
  let first = match host.nextDeadline() {
    Option.Some { value } => value == 0.01
    Option.None => false
  }
  run Testing.expect(first, "the earliest timer is 10 milliseconds away")
  run Testing.expect(host.wantsFrame(), "the script asked for a frame")
  run host.tick(0.012, false)
  run host.tick(0.03, true)
  run Testing.expect(!host.wantsFrame(), "the frame callback ran")
  run host.tick(0.05, true)
  run Testing.expect(host.nextDeadline().isNone(), "the cleared interval left no timer")
  run host.evaluate(b"if (order.join() !== 'micro,a,i,b,frame 30,i') throw new Error('order was ' + order.join()); if (performance.now() !== 50) throw new Error('now was ' + performance.now())", b"test")
  let logs = host.takeLogs()
  let lines = logs.asSlice()
  run Testing.expect(lines.length == 2, "two console lines reached the host")
  run Testing.expect(lines[0].level == 1 && String.view(&lines[0].text) == "hello { a: [1, \"x\"] } 2", "console.log formats its values")
  run Testing.expect(lines[1].level == 3 && String.view(&lines[1].text) == "bad", "console.error has the error level")

  // A rejection nothing handles by the end of the promise jobs is a console error; one
  // that gets a handler in the same turn is not.
  run host.evaluate(b"Promise.reject(new Error('lost')); const kept = Promise.reject(1); kept.catch(() => {}); (async () => { throw new TypeError('async') })()", b"test")
  let rejected = host.takeLogs()
  let reports = rejected.asSlice()
  run Testing.expect(reports.length == 2, "two rejections went unhandled")
  run Testing.expect(reports[0].level == 3 && String.view(&reports[0].text) == "Uncaught (in promise) Error: lost", "the report carries the reason")
  run Testing.expect(String.view(&reports[1].text) == "Uncaught (in promise) TypeError: async", "an async function that throws is reported")

  // The development server's lines reach JavaScript, and what it sends and asks comes back.
  run host.evaluate(b"__ui.devMessage = (line) => { __ui.devSend('echo ' + line); Promise.resolve().then(() => __ui.devReload()) }", b"test")
  run Testing.expect(!host.takeReload(), "nothing asked for a reload yet")
  run host.devMessage("hi")
  let sent = host.takeOutbox()
  run Testing.expect(sent.length() == 1 && String.view(&sent.asSlice()[0]) == "echo hi", "devSend queued one line for the server")
  run Testing.expect(host.takeReload() && !host.takeReload(), "devReload asked once, from a promise job")

  // navigator.clipboard asks the host, and its promises settle with the host's answers.
  run host.evaluate(b"globalThis.copied = []; navigator.clipboard.writeText('hi').then((value) => copied.push('wrote ' + value)); navigator.clipboard.readText().then((text) => { copied.push('read ' + text); return navigator.clipboard.readText() }).then((text) => copied.push('empty ' + JSON.stringify(text)))", b"test")
  let mut requests = host.takeClipboard()
  run Testing.expect(requests.length() == 2, "two clipboard calls reached the host")
  let write = match requests.remove(0) {
    ClipboardRequest.Write { call, text } => if String.view(&text) == "hi" { call } else { 0 }
    ClipboardRequest.Read { .. } => 0
  }
  let read = match requests.remove(0) {
    ClipboardRequest.Read { call } => call
    ClipboardRequest.Write { .. } => 0
  }
  run Testing.expect(write != 0 && read != 0, "a write of the text, then a read")
  run host.answerClipboard(write, Option<String>.none())
  let pasted = run String.copy("from the system")
  run host.answerClipboard(read, Option<String>.some(move pasted))
  let mut again = host.takeClipboard()
  let next = match again.remove(0) {
    ClipboardRequest.Read { call } => call
    ClipboardRequest.Write { .. } => 0
  }
  run Testing.expect(next != 0, "the read's promise job read again")
  run host.answerClipboard(next, Option<String>.none())
  run host.evaluate(b"if (copied.join() !== 'wrote undefined,read from the system,empty \"\"') throw new Error('clipboard calls settled as ' + copied.join())", b"test")
}

/// `memoryUsage` reads the process's memory from the system, so 64 MB the script fills shows;
/// `frameStats` reads the frames the window host reported.
effect fn footprint(host: &mut JsHost<'_>) -> () ! OutOfMemoryError | JsError | platform.PlatformError ? &mut Allocator {
  run host.module(b"import { memoryUsage } from '@silkui/core'; const before = memoryUsage(); if (!before || !(before.footprint > 0) || before.processes !== 1) throw new Error('memoryUsage gave ' + JSON.stringify(before)); globalThis.kept = new Uint8Array(64 * 1024 * 1024).fill(1); const after = memoryUsage(); globalThis.kept = null; if (!(after.footprint >= before.footprint + 32 * 1024 * 1024)) throw new Error('memoryUsage went from ' + before.footprint + ' to ' + after.footprint)", b"memory.js")
  // `frameStats` reports the presents the window host handed over, once.
  run host.presented(&[8.0, 30.0, 9.0, 8.5], 2)
  run host.module(b"import { frameStats } from '@silkui/core'; const s = frameStats(); if (s.frames !== 4 || s.dropped !== 2 || s.p50 !== 8.5 || s.p95 !== 30 || s.max !== 30 || !(s.fps >= 0)) throw new Error('frameStats gave ' + JSON.stringify(s)); const t = frameStats(); if (t.frames !== 0 || t.dropped !== 0 || t.max !== 0) throw new Error('frameStats gave again ' + JSON.stringify(t))", b"frames.js")
}

/// A dispatcher like the one silkui generates for an app's exported Silk functions.
struct TestExports {}

impl Exports for TestExports {
  effect fn dispatch(self: &Self, id: u32, args: &[Arg], reply: &mut Reply) -> () ! OutOfMemoryError ? &mut Allocator {
    if id == 299831157 {
      if !natives.accepts(args, "nn") {
        reply.* = run natives.wrongArguments("add(a: number, b: number)")
        return ()
      }
      reply.* = Reply.Number { value: natives.number(args, 0) + natives.number(args, 1) }
    } else if id == 380897999 {
      let mut text = run String.copy("hi ")
      run String.append(&mut text, natives.text(args, 0))
      reply.* = Reply.Text { value: move text }
    } else if id == 704977686 {
      reply.* = run natives.failed("fail", "FileError", ())
    } else if id == 393056494 {
      reply.* = run natives.fromSigned(natives.signed(args, 0) * 2)
    }
  }
}

export "C" fn testNatives(raw: ?*mut u8) -> () as "ui_js_tests_natives" {
  unsafe serve<TestExports>(&TestExports {}, raw)
}

/// `__ui.native` calls the app's dispatcher: numbers, text, a bigint as decimal text, a
/// `TypeError` for arguments that do not fit, and an `InternalError` for a failure.
effect fn exported(host: &mut JsHost<'_>) -> () ! OutOfMemoryError | JsError | platform.PlatformError ? &mut Allocator {
  host.setNatives(unsafe Natives.fromCallback(testNatives))
  run host.evaluate(b"const ui = globalThis.__ui; const fails = (f, kind) => { try { f() } catch (e) { return e.name === kind } return false }; if (ui.native(299831157, 2, 40) !== 42) throw new Error('add gave ' + ui.native(299831157, 2, 40)); if (ui.native(380897999, 'Silk') !== 'hi Silk') throw new Error('greet'); if (BigInt(ui.native(393056494, '-4611686018427387904')) !== -9223372036854775808n) throw new Error('twice gave ' + ui.native(393056494, '-4611686018427387904')); if (!fails(() => ui.native(299831157, 'x', 1), 'TypeError')) throw new Error('add took a string'); if (!fails(() => ui.native(704977686), 'InternalError')) throw new Error('fail did not throw'); if (ui.native(1) !== undefined) throw new Error('an unknown id answered')", b"natives.js")
}

/// `__ui.markdown` gives the tree remark gives for a sample with every construct of GFM.
effect fn markdown(host: &mut JsHost<'_>) -> ()
  ! OutOfMemoryError | JsError | platform.PlatformError
  ? &mut Allocator {
  let source = run platform.readFile(b"modules/js/tests/fixtures/markdown.js")
  run host.evaluate(source.asSlice(), b"markdown.js")
}

effect fn withHost(scenario: u32) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run Tree.make(&fonts)
  let domain = run WaiterDomain.make()
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut host = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let ran = if scenario == 6 {
    run Effect.result(computedStyles(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 5 {
    run Effect.result(svgMarkup(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 4 {
    run Effect.result(literalAria(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 3 {
    run Effect.result(stylesheets(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 0 {
    run Effect.result(counter(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    run Effect.result(library(&mut host, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  let checked = if scenario == 2 {
    run Effect.result(globals(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    run Effect.result(errors(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  let parsed = if scenario == 2 {
    run Effect.result(markdown(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 1 {
    run Effect.result(footprint(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else if scenario == 0 {
    run Effect.result(exported(&mut host)) |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    Result<(), OutOfMemoryError | JsError | platform.PlatformError>.Success { value: () }
  }
  run host.close() |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Result<(), OutOfMemoryError | JsError | platform.PlatformError>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsError | platform.PlatformError>.Failure { error } => {
      match &error { JsError { message } => {
        let mut writer = StderrWriter.make()
        drop run Effect.result(Writer.writeString(String.view(&message))) |> Effect.provideMut<Writer>(&mut writer)
      } _ => () }
      fail move error
    }
  }
  match move ran {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Success { .. } => ()
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Failure { error } => {
      match &error { JsError { message } => {
        let mut writer = StderrWriter.make()
        drop run Effect.result(Writer.writeString(String.view(&message))) |> Effect.provideMut<Writer>(&mut writer)
      } _ => () }
      fail move error
    }
  }
  match move checked {
    Result<(), OutOfMemoryError | JsError | AssertionError<'static>>.Success { .. } => ()
    Result<(), OutOfMemoryError | JsError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}

