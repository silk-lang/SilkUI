/// Runs the library fixture and shows its first frame.
effect fn load(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  let source = run platform.readFile(b"modules/js/tests/fixtures/app.js")
  run host.module(source.asSlice(), b"app.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(run labelIs(&tree.*, "Click me"), "the label holds its first text")
}

/// What a reload does to the first realm: unload destroys
/// every node the application made.
effect fn leave(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  run load(&mut host, &mut tree)
  run host.unload()
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 1.0)
  run Testing.expect(tree.view(NodeId.of(1)).isNone() && tree.view(NodeId.of(4)).isNone(), "unload destroyed the application's nodes")
}

test effect fn reloadStartsANewRealmOnAnEmptyTree() -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | SynchronizationError | platform.PlatformError | AssertionError<'static> {
  let mut own = Allocator.systemAllocatorProvider()
  let fonts = run fixtures.fonts() |> Effect.provideMut<Allocator>(&mut own)
  let mut tree = run Tree.make(&fonts) |> Effect.provideMut<Allocator>(&mut own)
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut own)
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut first = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let left = run Effect.result(leave(&mut first, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  run first.close() |> Effect.provideMut<Allocator>(&mut allocator)
  // The second realm numbers its nodes from 1 again, on the same tree.
  let mut second = run JsHost.open(&memory, domain.handle()) |> Effect.provideMut<Allocator>(&mut allocator)
  let again = run Effect.result(load(&mut second, &mut tree)) |> Effect.provideMut<Allocator>(&mut allocator)
  run second.close() |> Effect.provideMut<Allocator>(&mut allocator)
  match move left {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Success { .. } => ()
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
  match move again {
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Success { .. } => ()
    Result<(), TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>>.Failure { error } => { fail move error }
  }
}

/// Each `__ui` native's id is the hash of its name, as its constant spells it, and no two
/// natives share an id.
test effect fn nativeIdsAreTheirNamesHashes() -> () ! AssertionError<'static> {
  run Testing.expect(bridge.APPEND == bridge.nativeId(b"append"), "APPEND")
  run Testing.expect(bridge.ATOM_STYLE == bridge.nativeId(b"atomStyle"), "ATOM_STYLE")
  run Testing.expect(bridge.ATTRIBUTE == bridge.nativeId(b"attribute"), "ATTRIBUTE")
  run Testing.expect(bridge.CANCEL_TIMER == bridge.nativeId(b"cancelTimer"), "CANCEL_TIMER")
  run Testing.expect(bridge.CLEAR_STYLE == bridge.nativeId(b"clearStyle"), "CLEAR_STYLE")
  run Testing.expect(bridge.COMPUTED == bridge.nativeId(b"computed"), "COMPUTED")
  run Testing.expect(bridge.CLIPBOARD_READ == bridge.nativeId(b"clipboardRead"), "CLIPBOARD_READ")
  run Testing.expect(bridge.CLIPBOARD_WRITE == bridge.nativeId(b"clipboardWrite"), "CLIPBOARD_WRITE")
  run Testing.expect(bridge.CREATE == bridge.nativeId(b"create"), "CREATE")
  run Testing.expect(bridge.DEFINE_ICON == bridge.nativeId(b"defineIcon"), "DEFINE_ICON")
  run Testing.expect(bridge.DESTROY == bridge.nativeId(b"destroy"), "DESTROY")
  run Testing.expect(bridge.LOAD == bridge.nativeId(b"load"), "LOAD")
  run Testing.expect(bridge.DEV_RELOAD == bridge.nativeId(b"devReload"), "DEV_RELOAD")
  run Testing.expect(bridge.DEV_SEND == bridge.nativeId(b"devSend"), "DEV_SEND")
  run Testing.expect(bridge.FOCUS == bridge.nativeId(b"focus"), "FOCUS")
  run Testing.expect(bridge.FONT_FAMILY == bridge.nativeId(b"fontFamily"), "FONT_FAMILY")
  run Testing.expect(bridge.FORMAT == bridge.nativeId(b"format"), "FORMAT")
  run Testing.expect(bridge.FRAME_STATS == bridge.nativeId(b"frameStats"), "FRAME_STATS")
  run Testing.expect(bridge.INSERT_ATOM == bridge.nativeId(b"insertAtom"), "INSERT_ATOM")
  run Testing.expect(bridge.INSERT_BEFORE == bridge.nativeId(b"insertBefore"), "INSERT_BEFORE")
  run Testing.expect(bridge.KEYFRAME == bridge.nativeId(b"keyframe"), "KEYFRAME")
  run Testing.expect(bridge.KEYFRAMES == bridge.nativeId(b"keyframes"), "KEYFRAMES")
  run Testing.expect(bridge.LISTEN == bridge.nativeId(b"listen"), "LISTEN")
  run Testing.expect(bridge.LOG == bridge.nativeId(b"log"), "LOG")
  run Testing.expect(bridge.MARK == bridge.nativeId(b"mark"), "MARK")
  run Testing.expect(bridge.MARKDOWN == bridge.nativeId(b"markdown"), "MARKDOWN")
  run Testing.expect(bridge.MEMORY_USAGE == bridge.nativeId(b"memoryUsage"), "MEMORY_USAGE")
  run Testing.expect(bridge.NATIVE == bridge.nativeId(b"native"), "NATIVE")
  run Testing.expect(bridge.NOW == bridge.nativeId(b"now"), "NOW")
  run Testing.expect(bridge.OPEN == bridge.nativeId(b"open"), "OPEN")
  run Testing.expect(bridge.RELEASE == bridge.nativeId(b"release"), "RELEASE")
  run Testing.expect(bridge.REMOVE == bridge.nativeId(b"remove"), "REMOVE")
  run Testing.expect(bridge.REQUEST_FRAME == bridge.nativeId(b"requestFrame"), "REQUEST_FRAME")
  run Testing.expect(bridge.RICH_TEXT == bridge.nativeId(b"richText"), "RICH_TEXT")
  run Testing.expect(bridge.ROOT == bridge.nativeId(b"root"), "ROOT")
  run Testing.expect(bridge.SCROLL_TO == bridge.nativeId(b"scrollTo"), "SCROLL_TO")
  run Testing.expect(bridge.SELECT == bridge.nativeId(b"select"), "SELECT")
  run Testing.expect(bridge.SET_TEXT == bridge.nativeId(b"setText"), "SET_TEXT")
  run Testing.expect(bridge.SHELL == bridge.nativeId(b"shell"), "SHELL")
  run Testing.expect(bridge.SOURCE == bridge.nativeId(b"source"), "SOURCE")
  run Testing.expect(bridge.COMPILE_STYLE_SHEET == bridge.nativeId(b"compileStyleSheet"), "COMPILE_STYLE_SHEET")
  run Testing.expect(bridge.STYLE_SHEET == bridge.nativeId(b"styleSheet"), "STYLE_SHEET")
  run Testing.expect(bridge.STYLE == bridge.nativeId(b"style"), "STYLE")
  run Testing.expect(bridge.TIMER == bridge.nativeId(b"timer"), "TIMER")
  let mut at: usize = 0
  while true {
    let native = match bridge.native(at) {
      Option.Some { value } => value
      Option.None => { return }
    }
    let mut other: usize = 0
    while other < at {
      match bridge.native(other) {
        Option.Some { value } => {
          run Testing.expect(bridge.nativeId(value.name) != bridge.nativeId(native.name), "two natives share an id")
        }
        Option.None => {}
      }
      other = other + 1
    }
    at = at + 1
  }
}

fn sheetWidth(tree: &Tree<'_>) -> f32 {
  return match tree.view(NodeId.of(1)) {
    Option.Some { value } => value.computed().layout.width.value
    Option.None => 0.0
  }
}

effect fn stylesheets(host: &mut JsHost<'_>, tree: &mut Tree<'_>) -> ()
  ! TreeError | ProtocolError | OutOfMemoryError | JsError | platform.PlatformError | AssertionError<'static>
  ? &mut Allocator {
  run host.evaluate(b"let disabled = false; try { __ui.compileStyleSheet('.card{width:1px}') } catch { disabled = true } if (!disabled) throw new Error('release compiler was enabled')", b"test")
  host.setStylesheetCompiler(runtimeStylesheets())
  let package = run platform.readFile(b"modules/js/packages/core/src/index.js")
  run host.define(b"@silkui/core", package.asSlice())
  run host.module(b"import { CSSStyleSheet, createBox, mount } from '@silkui/core'; globalThis.sheet = new CSSStyleSheet(); sheet.replaceSync('.card{width:111px;height:20px}'); globalThis.rootView = createBox(); rootView.className = 'card'; rootView.adoptedStyleSheets.push(sheet); mount(rootView);", b"sheets.js")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.0)
  run Testing.expect(sheetWidth(&tree.*) == 111.0, "runtime CSS compiles and adopts before the first frame")
  run host.evaluate(b"sheet.replaceSync('.card{width:222px}');", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.1)
  run Testing.expect(sheetWidth(&tree.*) == 222.0, "replaceSync updates an adopted native sheet")
  run host.evaluate(b"let rejected = false; try { sheet.replaceCompiled('invalid') } catch { rejected = true } if (!rejected) throw new Error('bad bytes were accepted');", b"test")
  run Testing.expect(host.pending() == 0, "invalid bytes queue no mutations")
  run host.evaluate(b"sheet.replace('.card{width:333px}').then(value => { if(value !== sheet) throw new Error('wrong sheet'); globalThis.replaced = true; });", b"test")
  run host.drain()
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.2)
  run Testing.expect(sheetWidth(&tree.*) == 333.0, "asynchronous replace updates the native tree")
  run host.evaluate(b"if (!replaced) throw new Error('replace did not settle'); rootView.adoptedStyleSheets.length = 0;", b"test")
  run host.flush(&mut tree)
  drop run tree.frame(viewport(), 0.3)
  run Testing.expect(sheetWidth(&tree.*) != 333.0, "mutating adoptedStyleSheets removes rules")
}

