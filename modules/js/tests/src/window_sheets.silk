import ui_js.lib { JsError, uiPackage, runtimeStylesheets }
import ui_js_window.lib { JsApp, JsClient, NoTools }
import ui_tree.legacy { UiTree, TreeError, FrameInput }
import ui_tree.style_assets { StyleAssets }
import ui_tree_window.host { WindowClient }
import ui_fixtures.fixtures as fixtures
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silkjs.js_atomics_native { WaiterDomain, SynchronizationError }
import silkjs.runtime_memory { RuntimeAllocator }

effect fn firstFrame() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let domain = run WaiterDomain.make()
  let memoryAllocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run memoryAllocator.observe()
  let mut app = run JsApp.open(&memory, move memoryAllocator, domain.handle())
  run app.define(b"@silkui/core", uiPackage())
  run app.entry(b"app.js", b"import {createBox,mount} from '@silkui/core'; const box=createBox(); box.className='card'; mount(box);")
  let result = run Effect.result(checkFrame(&mut app, &mut tree))
  run app.close()
  match move result {
    Result.Success { .. } => {}
    Result.Failure { error } => { fail move error }
  }
}

effect fn checkFrame<'m>(app: &mut JsApp<'m>, tree: &mut UiTree<'_>) -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let bytes = runtimeStylesheets().call(b".card { width: 123px; padding: 16px; }").unwrapOr(Bytes.make())
  run Testing.expect(bytes.length() != 0, "test sheet compiles")
  let mut client = JsClient.make(NoTools {})
  client.stylesheets = run StyleAssets.from(&[bytes.asSlice()])
  run app.startEntry(&mut tree.*)
  run Testing.expect(tree.current == 0 && tree.rootId() == 1, "the logical root differs from its root node ID")
  run WindowClient<JsApp<'m>, never, never>.layout(&mut client, &mut app.*, &mut tree.*, FrameInput { width: 420.0, height: 200.0, scale: 1.0, time: 0.0 })
  let computed = &tree.node(tree.slotOf(1)).computed
  run Testing.expect(computed.layout.width.value == 123.0 && computed.layout.padding.top.value == 16.0,
    "the real window client adopts build sheets into the logical root before its first frame")
}

test effect fn windowClientAdoptsCompiledSheetsBeforeFirstFrame() -> ()
  ! TreeError | JsError | SynchronizationError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run firstFrame() |> Effect.provideMut<Allocator>(&mut allocator)
}
