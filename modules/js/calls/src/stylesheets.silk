//! The compiled stylesheet ABI shared by JavaScript hosts.
import css_style.sheet { Sheet }
import css_style.sheet_binary { DecodeError }
import css_style.tokens { Limits }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import ui_tree.legacy { Batch }

pub effect fn decoded(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let source = String.utf8Bytes(text)
  if source.length > 89478488 { return Option<Bytes>.None }
  let length = match Base64.decodedLength(source) {
    Result.Success { value } => value
    Result.Failure { .. } => { return Option<Bytes>.None }
  }
  if length > 67108864 { return Option<Bytes>.None }
  let mut bytes = run Bytes.zeroed(length)
  drop Base64.decodeInto(bytes.asMutSlice(), source)
  let checked = run Effect.result(Sheet.decode(bytes.asSlice(), &Limits.make()))
  match move checked {
    Result.Success { .. } => { return Option<Bytes>.some(move bytes) }
    Result.Failure { error } => match move error {
      OutOfMemoryError allocation => { fail move allocation }
      DecodeError invalid => { drop invalid return Option<Bytes>.None }
    }
  }
}

/// Operations: validate (0), adopt (1), replace (2), remove (3). Root 0 is the
/// JavaScript application's root; inspector roots have their own clients.
pub effect fn apply(batch: &mut Batch, operation: u32, id: u32, text: string) -> bool
  ! OutOfMemoryError ? &mut Allocator {
  if operation > 3 || (operation != 0 && (id == 0 || id >= 2147483648)) { return false }
  if operation == 3 {
    run batch.removeStyleSheet(0, id)
    return true
  }
  let bytes = match move run decoded(text) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return false }
  }
  if operation == 1 { run batch.adoptStyleSheet(0, id, bytes.asSlice()) }
  else if operation == 2 { run batch.replaceStyleSheet(0, id, bytes.asSlice()) }
  return true
}

import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }

/// A compiler callback is present only in hosts that opt into runtime CSS text.
/// It writes an owned Bytes into the initialized output and retains no pointers.
pub struct Compiler {
  callback: extern "C" fn(?[*]const u8, usize, ?*mut u8) -> u32,
}
impl Copy for Compiler {}

export "C" fn disabled(source: ?[*]const u8, length: usize, output: ?*mut u8) -> u32 {
  drop source
  drop length
  drop output
  return 0
}

impl Compiler {
  pub fn off() -> Compiler { return Compiler { callback: disabled } }
  pub unsafe fn fromCallback(callback: extern "C" fn(?[*]const u8, usize, ?*mut u8) -> u32) -> Compiler {
    return Compiler { callback: callback }
  }
  pub fn call(self: &Self, source: &[u8]) -> Option<Bytes> {
    let mut bytes = Bytes.make()
    let output = unsafe Intrinsic.pointerReinterpret<*mut Bytes, *mut u8>(Pointer.fromMutRef(&mut bytes))
    let status = unsafe self.callback(Pointer.fromSlice(source), source.length, output)
    return if status == 1 { Option<Bytes>.some(move bytes) } else { Option<Bytes>.None }
  }
}

pub effect fn encoded(bytes: &[u8]) -> String ! OutOfMemoryError ? &mut Allocator {
  let length = match Base64.encodedLength(bytes.length) {
    Result.Success { value } => value
    Result.Failure { .. } => { fail OutOfMemoryError {} }
  }
  let mut output = run Bytes.zeroed(length)
  drop Base64.encodeInto(output.asMutSlice(), bytes)
  return run String.copy(unsafe String.fromUtf8Unchecked(output.asSlice()))
}
