//! The CLI's commands as words (`commands.silk`), and a headless run of a counter
//! (ui-tree-window's `runHeadless`) driven by a script of those commands.
import ui_inspect_server.commands { Command, parseCommand, requestLine, splitWords }
import ui_inspect_server.lib { Inspector }
import ui_tree_window.host { WindowClient, RunOptions, StartedGpu, runHeadless }
import ui_tree_window.platform_thread { Launched }
import ui_fixtures.fixtures as fixtures
import ui_tree.css
import ui_tree.css { px }
import ui_tree.legacy { UiTree, TreeError, Batch, Mutation, NodeKind, Attribute }
import ui_tree.mutation { Role, LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String, InvalidUtf8 }

effect fn line(words: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<String>.make()
  drop run splitWords(words, &mut list)
  let mut problem = String.make()
  let mut out = String.make()
  match move run parseCommand(list.asSlice(), &mut problem) {
    Option<Command>.Some { value } => {
      let mut command = move value
      if !run requestLine(&mut command, &mut out, &mut problem) {
        return move problem
      }
    }
    Option<Command>.None => {
      return move problem
    }
  }
  return move out
}

effect fn wordsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut words = List<String>.make()
  run Testing.expect(
    run splitWords("click --name \"Save as\" 'it''s'  # the rest is a comment", &mut words),
    "a line splits",
  )
  run Testing.expect(words.length() == 4, "into four words")
  run Testing.expect(String.view(&words.asSlice()[2]) == "Save as", "a quoted word keeps its space")
  run Testing.expect(String.view(&words.asSlice()[3]) == "its", "quotes next to each other join")
  words.clear()
  run Testing.expect(run splitWords("type \"say \\\"hi\\\"\"", &mut words), "escapes")
  run Testing.expect(String.view(&words.asSlice()[1]) == "say \"hi\"", "an escaped quote stays")
  run Testing.expect(!run splitWords("type \"open", &mut words), "an open quote is an error")

  let typed = run line("type \"hello world\" --test-id note")
  run Testing.expect(
    String.view(&typed) == "{\"id\":1,\"cmd\":\"type\",\"text\":\"hello world\",\"testId\":\"note\"}",
    "type becomes its request",
  )
  let clicked = run line("click --role button --name Save --count 2")
  run Testing.expect(
    String.view(&clicked) == "{\"id\":1,\"cmd\":\"click\",\"role\":\"button\",\"name\":\"Save\",\"count\":2}",
    "click becomes its request",
  )
  let pressed = run line("press")
  run Testing.expect(String.startsWith(String.view(&pressed), "press takes a key"), "why a command is wrong")
  let unknown = run line("click --colour red")
  run Testing.expect(String.view(&unknown) == "unknown option --colour", "an unknown option")
}

test effect fn cliCommandsAreWords() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wordsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A headless run.

struct Counter {
  clicks: u32,
}

struct Client {}

impl WindowClient<Counter, never, never> for Client {
  effect fn start(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    run batch.box(1, 2, &[css.width(px(120.0)), css.height(px(40.0))])
    run batch.attribute(2, Attribute.TestId { value: run String.copy("counter") })
    run batch.attribute(2, Attribute.Role { value: Role.Button })
    run batch.push(Mutation.SetListeners { id: 2, flags: LISTEN_CLICK })
    run batch.text(2, 3, "0")
    run tree.apply(run batch.take())
  }

  effect fn pump(self: &mut Self, state: &mut Counter, tree: &mut UiTree<'_>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let values = events.asSlice()
    let mut i: usize = 0
    while i < values.length {
      if values[i].kind == EventKind.Click && values[i].target == 2 {
        state.clicks = state.clicks + 1
        let mut batch = Batch.make()
        run batch.setText(3, if state.clicks == 1 { "1" } else { "more" })
        run tree.apply(run batch.take())
      }
      i = i + 1
    }
  }
}

const SCRIPT: string = "/tmp/ui-inspect-headless-test.txt"

const TREE: string = "/tmp/ui-inspect-headless-test-tree.txt"

const SHOT: string = "/tmp/ui-inspect-headless-test.png"

effect fn writeText(path: string, text: string) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let place = run Path.make(path)
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&place, String.utf8Bytes(text)) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn readText(path: string) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let place = run Path.make(path)
  let mut files = run MachineFileSystem.make()
  let bytes = run FileSystem.readFile(&place) |> Effect.provideMut<FileSystem>(&mut files)
  return String.fromBytes(move bytes) |> Result<String, InvalidUtf8>.unwrapOr(String.make())
}

/// How a headless run of the counter ended.
struct Ran {
  status: i32,
  clicks: u32,
}

/// Runs the counter headless with `script`.
effect fn runCounter(script: string) -> Ran
  ! FileError | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run writeText(SCRIPT, script)
  let fonts = run fixtures.fonts()
  let mut state = Counter { clicks: 0 }
  let mut client = Client {}
  let options = RunOptions {
    title: "Counter",
    width: 200.0,
    height: 100.0,
    check: false,
    checkClick: "",
    checkExpect: "",
    lowestLatency: false,
    platform: Option<Launched>.None,
    gpu: Option<StartedGpu>.None,
  }
  let status = run runHeadless(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    move options,
    Inspector.off(),
    &mut client,
    SCRIPT,
  )
  return Ran { status: status, clicks: state.clicks }
}

effect fn headlessBody() -> ()
  ! AssertionError<'static> | FileError | WindowError | GpuError | TreeError | AtlasError
    | GeometryError
    | OutOfMemoryError
  ? &mut Allocator {
  let mut script = run String.copy("# two clicks, then what shows\nclick --test-id counter\n")
  run script.append("wait --text 1\nclick --test-id counter\nwait 100ms\nsnapshot ")
  run script.append(TREE)
  run script.append("\nscreenshot ")
  run script.append(SHOT)
  run script.append("\nsize 300 120 2\n")
  let done = run runCounter(String.view(&script))
  run Testing.expect(done.status == 0 && done.clicks == 2, "the script ran to its end, clicking twice")
  let tree = run readText(TREE)
  run Testing.expect(String.contains(String.view(&tree), "\"more\""), "the snapshot shows the second click")
  let place = run Path.make(SHOT)
  let mut files = run MachineFileSystem.make()
  let shot = run FileSystem.readFile(&place) |> Effect.provideMut<FileSystem>(&mut files)
  run Testing.expect(shot.length() > 8 && shot.asSlice()[1] == 80, "the screenshot is a PNG")

  let failed = run runCounter("click --test-id counter\nclick --test-id nothing\nclick --test-id counter\n")
  run Testing.expect(failed.status == 1 && failed.clicks == 1, "a failing line ends the run")
  let waited = run runCounter("wait --text never\nclick --test-id counter\n")
  run Testing.expect(waited.status == 1 && waited.clicks == 0, "a wait that never holds gives up")
}

test effect fn aHeadlessRunFollowsItsScript() -> ()
  ! AssertionError<'static> | FileError | WindowError | GpuError | TreeError | AtlasError
    | GeometryError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run headlessBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
