[
 {
  "id": "border-radius",
  "support": "a",
  "note": "Lengths and percentages work on every corner. A percentage takes the shorter side of the box, so the corners stay circular: `50%` makes a square a circle, but a wide box gets round ends instead of an ellipse. A second, vertical radius (`8px / 4px`) is ignored.",
  "probes": [
   {
    "sheet": ".sample{border-radius:8px}",
    "setup": "background-color:red"
   },
   {
    "sheet": ".sample{border-top-left-radius:12px}",
    "setup": "background-color:red"
   },
   {
    "sheet": ".sample{border-top-left-radius:50%}",
    "setup": "background-color:red"
   }
  ],
  "missing": [
   {
    "sheet": ".sample{border-radius:8px / 4px}",
    "setup": "background-color:red"
   }
  ]
 },
