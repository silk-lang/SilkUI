 {
  "id": "pointer",
  "support": "a",
  "note": "JavaScript apps get `pointerdown`, `pointermove`, `pointerup`, `pointerenter`, `pointerleave` and `pointercancel`, with positions, buttons and modifier keys, and a press captures the pointer. Events have no `pointerId`, `pointerType` or pressure, and there is no `setPointerCapture()`.",
  "evidence": "modules/tree/tests/src/interaction.silk",
  "probes": []
 },
