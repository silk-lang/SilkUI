 {
  "id": "transforms3d",
  "support": "a",
  "note": "3D transform functions, `perspective`, `perspective-origin` and `backface-visibility` work, each box flattened into its parent's plane. `transform-style: preserve-3d` is ignored, so nested boxes do not share one 3D space.",
  "probes": [
   {
    "sheet": ".sample{transform:perspective(100px) rotateY(45deg)}"
   },
   {
    "sheet": ".root{perspective:100px}",
    "setup": "transform:rotateY(45deg);background-color:red"
   },
   {
    "sheet": ".sample{backface-visibility:hidden}",
    "setup": "transform:rotateY(180deg);background-color:red"
   }
  ],
  "missing": [
   {
    "sheet": ".sample{transform-style:preserve-3d}",
    "root": "perspective:200px",
    "base": ".sample{transform:rotateY(60deg)} .inner{transform:rotateY(60deg) translateZ(20px)}"
   }
  ]
 },
