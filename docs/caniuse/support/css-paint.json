 {
  "id": "css-masks",
  "support": "a",
  "note": "`mask-image` with linear, radial and conic gradients works, with `mask-size`, `mask-position`, `mask-repeat`, `mask-origin`, `mask-clip` and the `mask` shorthand. `url()` images do not mask yet, and `mask-mode: luminance`, `mask-composite` other than `add` and `mask-border` are ignored.",
  "probes": [
   {
    "sheet": ".sample{mask-image:linear-gradient(black, transparent)}",
    "setup": "background-color:red"
   },
   {
    "sheet": ".sample{mask:linear-gradient(black, transparent)}",
    "setup": "background-color:red"
   },
   {
    "sheet": ".sample{mask-size:10px 10px}",
    "setup": "background-color:red;mask-image:linear-gradient(black, transparent)"
   },
   {
    "sheet": ".sample{mask-image:radial-gradient(black, transparent)}",
    "setup": "background-color:red"
   }
  ],
  "missing": [
   {
    "sheet": ".sample{mask-mode:luminance}",
    "setup": "background-color:red;mask-image:linear-gradient(white, black)"
   },
   {
    "sheet": ".sample{mask-composite:intersect}",
    "setup": "background-color:red;mask-image:linear-gradient(black, transparent), linear-gradient(90deg, black, transparent)"
   }
  ]
 },
