 {
  "id": "will-change",
  "support": "a",
  "note": "Only a hint, so nothing else changes, but as in browsers it makes the box a stacking context when it names a property that would make one (`transform`, `opacity`, `filter`, ...).",
  "probes": [
   {
    "sheet": ".sample{will-change:transform}",
    "setup": "background-color:red",
    "base": ".inner{position:relative;z-index:-1}"
   }
  ]
 }
