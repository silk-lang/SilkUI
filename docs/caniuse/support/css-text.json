[
 {
  "id": "background-clip-text",
  "support": "a",
  "note": "`background-clip: text` fills the text with the background color and gradient layers, as Tailwind's `bg-clip-text text-transparent` expects. The prefixed `-webkit-background-clip` is ignored, so set the standard property too.",
  "missing": [
   {
    "sheet": ".sample{-webkit-background-clip:text}",
    "setup": "background-color:red"
   }
  ],
  "probes": [
   {
    "sheet": ".sample{background-clip:text}",
    "setup": "background-color:red"
   }
  ]
 },
