 {
  "id": "css-font-rendering-controls",
  "support": "a",
  "note": "Every `@font-face` behaves as `font-display: swap`: text draws with the fallback until the face loads, then reshapes. `block`, `fallback` and `optional` are ignored.",
  "evidence": "modules/tree/tests/src/stylesheet_fonts.silk (stylesheetFontFacesLoadSwapRetryRemoveAndReuse)"
 },
 {
  "id": "css-font-stretch",
  "support": "y",
  "note": "`font-stretch` and `font-width` pick the nearest width among a family's faces and set the `wdth` axis of a variable font.",
  "evidence": "lib-fonts: modules/faces/src/tests.silk (matchesStyles); modules/text/src/fonts.silk sets wdth"
 },
 {
  "id": "css-hanging-punctuation",
  "support": "n",
  "note": "`hanging-punctuation` is ignored; punctuation stays inside the line box."
 },
 {
  "id": "css-hyphens",
  "support": "a",
  "note": "`hyphens: manual` and `none` work. `auto` breaks only at soft hyphens (`&shy;`), like `manual`: there are no hyphenation dictionaries.",
