 {
  "id": "css-overflow-anchor",
  "support": "n",
  "note": "`overflow-anchor` is parsed but nothing anchors scrolling, so content inserted above the visible part of a scroll box pushes what is shown down. Virtual lists keep their own scroll anchor."
 },
