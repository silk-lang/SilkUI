 {
  "id": "css-containment",
  "support": "a",
  "note": "`size`, `inline-size`, `paint`, `strict` and `content` work (`layout` and `style` are accepted and change nothing). A paint-contained box clips its contents and makes a stacking context, but it is not the containing block of absolutely positioned descendants: give it `position: relative` so they are clipped too.",
  "missing": [
   {
    "sheet": ".sample{contain:layout style}"
   }
  ],
  "probes": [
   {
    "sheet": ".sample{contain:size}"
   },
   {
    "sheet": ".sample{contain:paint}",
    "setup": "height:10px"
   },
   {
    "sheet": ".sample{contain:strict}",
    "setup": "height:10px"
   }
  ],
  "evidence": "modules/tree/tests/src/containment.silk"
 },
 {
  "id": "css-content-visibility",
  "support": "a",
  "note": "`hidden` works: the box keeps its own size and paint, and its contents are skipped as with `display: none`. `auto` draws everything, as `visible` does, and skips no work off screen.",
  "missing": [
   {
    "sheet": ".sample{content-visibility:auto}"
   }
  ],
  "probes": [
   {
    "sheet": ".sample{content-visibility:hidden}"
   }
  ],
  "evidence": "modules/tree/tests/src/containment.silk"
 },
