[
 {
  "id": "css-anchor-positioning",
  "support": "a",
  "note": "`anchor-name`, `position-anchor`, `anchor()` in the insets (also in `calc(anchor(...) ± px)`), `position-area`, `anchor-size()` as `width` or `height`, and the `flip-block` and `flip-inline` fallbacks of `position-try-fallbacks` work. Missing: `@position-try` rules, `position-try-order`, `position-visibility`, `anchor-scope`, `anchor-center`, the `anchor()` fallback, `anchor-size()` inside `calc()` or in margins and min/max sizes, and the `position-try` shorthand. An element only uses its first anchor name. For popups, the Silk tree API also has `Tree.anchor`.",
  "evidence": "modules/tree/tests/src/css_anchor.silk",
  "probes": [
   {
    "sheet": ".lead{anchor-name:--a}.sample{position-anchor:--a;top:anchor(bottom);left:anchor(right)}",
    "setup": "position:absolute"
   },
   {
    "sheet": ".lead{anchor-name:--a}.sample{position-anchor:--a;position-area:bottom right}",
    "setup": "position:absolute"
   }
  ]
 },
