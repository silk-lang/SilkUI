 {
  "id": "css-snappoints",
  "support": "y",
  "note": "Snap containers settle on the nearest `scroll-snap-align` area (with `scroll-margin` and `scroll-padding`) once a user scroll stops, script scrolls land on one, and mandatory containers stay on one through layout. A fling is aimed at the snap position where it would come to rest, and a scroll never passes an area with `scroll-snap-stop: always`. Hosts send no gesture phases, so a fling is recognised from a slowing stream of wheel events.",
  "evidence": "modules/tree/tests/src/scroll_snap.silk",
  "probes": []
 },
