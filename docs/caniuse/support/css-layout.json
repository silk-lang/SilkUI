 {
  "id": "css-overflow-anchor",
  "support": "a",
  "note": "A scrolled container keeps its anchor box still when content above it changes size, as in Chromium: block axis only, nothing anchors at offset zero, `overflow-anchor: none` opts a container or a subtree out, and a layout change to the anchor or its ancestors suppresses the adjustment. Missing: anchoring in vertical writing modes, and the focused element as the preferred anchor. Virtual lists keep their own first visible item instead.",
  "evidence": "modules/tree/tests/src/scroll_anchor.silk"
 },
