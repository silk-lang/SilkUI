 {
  "id": "css-containment",
  "support": "y",
  "note": "Every value works: `size`, `inline-size`, `layout`, `paint`, `style`, `strict` and `content`. A layout- or paint-contained box is an independent formatting context, a stacking context, and the containing block of its absolutely and fixed positioned descendants; style containment keeps counter changes inside the box. A change inside a box with `contain: strict` (or layout containment and a fixed size) lays out that box again, not the page around it.",
  "probes": [
   {
    "sheet": ".sample{contain:size}"
   },
   {
    "sheet": ".sample{contain:paint}",
    "setup": "height:10px"
   },
   {
    "sheet": ".sample{contain:strict}",
    "setup": "height:10px"
   },
   {
    "sheet": ".sample{contain:layout}",
    "base": ".inner{position:absolute;right:0;bottom:0}",
    "setup": "margin-left:40px;height:40px"
   },
   {
    "sheet": ".sample{contain:style}",
    "base": ".root{counter-reset:n}.sample{counter-increment:n}.after::before{content:counter(n)}"
   }
  ],
  "evidence": "modules/tree/tests/src/containment.silk"
 },
 {
  "id": "css-content-visibility",
