 {
  "id": "css-exclusions",
  "support": "a",
  "note": "An absolutely or fixed positioned box with `wrap-flow` (`both`, `start`, `end`, `minimum`, `maximum`, `clear`) pushes the text of its containing block aside, on both sides with `both`. `wrap-through: none` keeps a block's text out of it. Not yet: in-flow, flex and grid items as exclusions, text inside nested formatting contexts (a flow root, a flex or grid item) wrapping around them, `shape-outside` on an exclusion, and vertical writing modes.",
  "probes": [
   {
    "sheet": ".inner{wrap-flow:both}",
    "base": ".sample{position:relative}.inner{position:absolute;top:0;left:30px}"
   },
   {
    "sheet": ".inner{wrap-flow:end}",
    "base": ".sample{position:relative}.inner{position:absolute;top:0;left:30px}"
   }
  ],
  "missing": [
   {
    "sheet": ".inner{wrap-flow:both}",
    "base": ".inner{margin-bottom:-20px}"
   }
  ]
 },
