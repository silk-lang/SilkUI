 {
  "id": "css-shapes",
  "support": "a",
  "note": "`shape-outside` with `circle()`, `ellipse()`, `inset()`, `polygon()`, a box, a raster `url()` image or a gradient, plus `shape-margin` and `shape-image-threshold`, wrap lines around a float's shape. SVG images are not read, image shapes work in horizontal writing modes only, and a gradient on a float without a definite width and height is sampled over a square.",
  "probes": [
   {
    "sheet": ".lead{shape-outside:circle(50%)}",
    "lead": "float:left;width:100px;height:60px"
   },
   {
    "sheet": ".lead{shape-outside:polygon(0 0, 50% 0, 50% 100%, 0 100%)}",
    "lead": "float:left;width:100px;height:60px"
   },
   {
    "sheet": ".lead{shape-margin:30px}",
    "base": ".lead{shape-outside:circle(20%)}",
    "lead": "float:left;width:100px;height:60px"
   },
   {
    "sheet": ".lead{shape-outside:linear-gradient(to right, black 50%, transparent 50%)}",
    "lead": "float:left;width:100px;height:60px"
   },
   {
    "sheet": ".lead{shape-image-threshold:0.9}",
    "base": ".lead{shape-outside:linear-gradient(to right, black, transparent)}",
    "lead": "float:left;width:100px;height:60px"
   }
  ],
  "missing": [
   {
    "sheet": ".lead{shape-outside:linear-gradient(to right, black 50%, transparent 50%)}",
    "root": "writing-mode:vertical-rl",
    "lead": "float:left;width:100px;height:60px"
   }
  ]
 },
 {
  "id": "css-snappoints",
  "support": "a",
  "note": "Snap containers settle on the nearest `scroll-snap-align` area (with `scroll-margin` and `scroll-padding`) after a user scroll stops, script scrolls land on one, and mandatory containers stay on one through layout. `scroll-snap-stop` is ignored, and a fling is not aimed at the snap position it would reach.",
  "evidence": "modules/tree/tests/src/scroll_snap.silk",
  "probes": []
 },
