 {
  "id": "css-scrollbar",
  "support": "a",
  "note": "`scrollbar-width` and the `::-webkit-scrollbar`, `-track` and `-thumb` pseudo-elements work. `scrollbar-color` is ignored; color the thumb and track with the pseudo-elements.",
  "probes": [
   {
    "sheet": ".sample{scrollbar-width:none}",
    "base": ".inner{min-height:200px}",
    "setup": "overflow:scroll;height:50px"
   },
   {
    "sheet": ".sample{scrollbar-width:thin}",
    "base": ".inner{min-height:200px}",
    "setup": "overflow:scroll;height:50px"
   },
   {
    "sheet": ".sample::-webkit-scrollbar{width:20px;background-color:blue}",
    "base": ".inner{min-height:200px}",
    "setup": "overflow:scroll;height:50px"
   },
   {
    "sheet": ".sample::-webkit-scrollbar-thumb{background-color:red}",
    "base": ".inner{min-height:200px}",
    "setup": "overflow:scroll;height:50px"
   }
  ],
  "missing": [
   {
    "sheet": ".sample{scrollbar-color:red blue}",
    "base": ".inner{min-height:200px}",
    "setup": "overflow:scroll;height:50px"
   }
  ]
 },
