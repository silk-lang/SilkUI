//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-paint.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "background-attachment" {
    return Answer { support: "n", note: "Ignored: backgrounds always scroll with their box, so `fixed` and `local` draw like `scroll`." }
  }
  if id == "background-img-opts" {
    return Answer { support: "y", note: "" }
  }
  if id == "background-position-x-y" {
    return Answer { support: "n", note: "The `background-position-x` and `background-position-y` longhands are ignored. Set both with `background-position`." }
  }
  if id == "background-repeat-round-space" {
    return Answer { support: "y", note: "" }
  }
  if id == "border-image" {
    return Answer { support: "n", note: "`border-image` and its longhands are ignored; the border draws with its `border-style` and `border-color`." }
  }
  if id == "border-radius" {
    return Answer { support: "a", note: "Lengths and percentages work on every corner. A percentage takes the shorter side of the box, so the corners stay circular: `50%` makes a square a circle, but a wide box gets round ends instead of an ellipse. A second, vertical radius (`8px / 4px`) is ignored." }
  }
  if id == "cross-document-view-transitions" {
    return Answer { support: "x", note: "About animating a navigation from one web page to another. An app does not navigate between documents." }
  }
  if id == "css-animation" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-appearance" {
    return Answer { support: "n", note: "`appearance` is ignored. Silk UI draws its controls itself, so there is no platform look for `appearance: none` to remove." }
  }
  if id == "css-backdrop-filter" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-background-offsets" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-backgroundblendmode" {
    return Answer { support: "n", note: "`background-blend-mode` is ignored: background layers are drawn over each other without blending." }
  }
  if id == "css-boxshadow" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-canvas" {
    return Answer { support: "n", note: "Not supported. `-webkit-canvas()` was a WebKit-only extension that never became a standard." }
  }
  if id == "css-caret-color" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-clip-path" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-color-adjust" {
    return Answer { support: "x", note: "About printing. An app window always draws the colors it is given." }
  }
  if id == "css-conic-gradients" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-crisp-edges" {
    return Answer { support: "n", note: "`image-rendering` is ignored: scaled images are always smoothed." }
  }
  if id == "css-cross-fade" {
    return Answer { support: "n", note: "`cross-fade()` draws nothing." }
  }
  if id == "css-element-function" {
    return Answer { support: "n", note: "`element()` is not supported." }
  }
  if id == "css-filter-function" {
    return Answer { support: "n", note: "The `filter()` image function draws nothing. The `filter` property works." }
  }
  if id == "css-filters" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-gradients" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-image-orientation" {
    return Answer { support: "n", note: "The `image-orientation` property is ignored." }
  }
  if id == "css-image-set" {
    return Answer { support: "n", note: "`image-set()` draws nothing." }
  }
  if id == "css-masks" {
    return Answer { support: "a", note: "`mask-image` with linear, radial and conic gradients works, with `mask-size`, `mask-position`, `mask-repeat`, `mask-origin`, `mask-clip` and the `mask` shorthand. `url()` images do not mask yet, and `mask-mode: luminance`, `mask-composite` other than `add` and `mask-border` are ignored." }
  }
  if id == "css-mixblendmode" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-motion-paths" {
    return Answer { support: "n", note: "`offset-path` and the other `offset-*` properties are ignored." }
  }
  if id == "css-opacity" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-paint-api" {
    return Answer { support: "n", note: "There are no paint worklets, so `paint()` draws nothing." }
  }
  if id == "css-reflections" {
    return Answer { support: "n", note: "`-webkit-box-reflect` is ignored." }
  }
  if id == "css-repeating-gradients" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-resize" {
    return Answer { support: "n", note: "`resize` is ignored: a box has no handle to drag it bigger." }
  }
  if id == "css-selection" {
    return Answer { support: "y", note: "Applies to the text of inputs, the only text a user can select." }
  }
  if id == "css-touch-action" {
    return Answer { support: "n", note: "`touch-action` is ignored." }
  }
  if id == "css-transitions" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-zoom" {
    return Answer { support: "n", note: "`zoom` is ignored. Use `transform: scale()`, which does not change layout, or scale the sizes themselves." }
  }
  if id == "css3-cursors" {
    return Answer { support: "a", note: "Every keyword has a cursor except `url()` images, which show the default arrow, and `cell`, `no-drop` and the one-sided resizes, which take the nearest shape. `none` hides the cursor. In windows, `wait`, `progress` and `help` still show the arrow until the window layer's update reaches Silk UI." }
  }
  if id == "css3-cursors-grab" {
    return Answer { support: "y", note: "" }
  }
  if id == "css3-cursors-newer" {
    return Answer { support: "a", note: "`zoom-in` and `zoom-out` reach the host as their own cursors, but windows show the arrow until the window layer's update reaches Silk UI (then macOS 15 and Wayland show zoom shapes; Windows and X11 have none)." }
  }
  if id == "devicepixelratio" {
    return Answer { support: "n", note: "A JavaScript app has no `window.devicePixelRatio`. The tree draws at the display's scale by itself, so CSS pixels stay the same size on every screen." }
  }
  if id == "multibackgrounds" {
    return Answer { support: "a", note: "Several layers work in `background-image` and the other background longhands. The `background` shorthand takes only one layer: a comma, or a size after `/`, drops the whole declaration." }
  }
  if id == "object-fit" {
    return Answer { support: "y", note: "" }
  }
  if id == "outline" {
    return Answer { support: "y", note: "" }
  }
  if id == "pointer" {
    return Answer { support: "a", note: "JavaScript apps get `pointerdown`, `pointermove`, `pointerup`, `pointerenter`, `pointerleave` and `pointercancel`, with positions, buttons and modifier keys, and a press captures the pointer. Events have no `pointerId`, `pointerType` or pressure, and there is no `setPointerCapture()`." }
  }
  if id == "pointer-events" {
    return Answer { support: "y", note: "" }
  }
  if id == "transforms2d" {
    return Answer { support: "y", note: "" }
  }
  if id == "transforms3d" {
    return Answer { support: "a", note: "3D transform functions, `perspective`, `perspective-origin` and `backface-visibility` work, each box flattened into its parent's plane. `transform-style: preserve-3d` is ignored, so nested boxes do not share one 3D space." }
  }
  if id == "user-select-none" {
    return Answer { support: "n", note: "`user-select` is ignored. Only the text of inputs can be selected, and it stays selectable." }
  }
  if id == "view-transitions" {
    return Answer { support: "n", note: "No `document.startViewTransition()` and no `::view-transition` pseudo-elements. CSS transitions and animations work." }
  }
  if id == "will-change" {
    return Answer { support: "a", note: "Only a hint, so nothing else changes, but as in browsers it makes the box a stacking context when it names a property that would make one (`transform`, `opacity`, `filter`, ...)." }
  }
  return Answer { support: "u", note: "" }
}
