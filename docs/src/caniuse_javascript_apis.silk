//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/javascript-apis.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "abortcontroller" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `AbortController`." }
  }
  if id == "accelerometer" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "ambient-light" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "async-clipboard" {
    return Answer { support: "a", note: "`navigator.clipboard.readText()` and `writeText()` work on the system clipboard. `read()`, `write()` and `ClipboardItem`, for images and other types, are missing." }
  }
  if id == "atob-btoa" {
    return Answer { support: "y", note: "" }
  }
  if id == "audio-api" {
    return Answer { support: "n", note: "No audio output or Web Audio API." }
  }
  if id == "auxclick" {
    return Answer { support: "n", note: "There is no `auxclick` event; `pointerdown` and `pointerup` carry `button` for every button." }
  }
  if id == "background-sync" {
    return Answer { support: "x", note: "A service worker feature for pages that sync while closed." }
  }
  if id == "battery-status" {
    return Answer { support: "n", note: "No `navigator.getBattery()`." }
  }
  if id == "beacon" {
    return Answer { support: "x", note: "`sendBeacon` sends data as a page unloads; an app can send it with `fetch` before it quits." }
  }
  if id == "beforeafterprint" {
    return Answer { support: "x", note: "Printing events are about printing documents." }
  }
  if id == "blobbuilder" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `Blob`." }
  }
  if id == "bloburls" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `URL.createObjectURL`." }
  }
  if id == "broadcastchannel" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `BroadcastChannel`." }
  }
  if id == "channel-messaging" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `MessageChannel`." }
  }
  if id == "clipboard" {
    return Answer { support: "n", note: "There are no `copy`, `cut` or `paste` events. Inputs copy and paste on their own, and `navigator.clipboard` reads and writes text." }
  }
  if id == "console-basic" {
    return Answer { support: "y", note: "Lines go to the host's standard error." }
  }
  if id == "console-time" {
    return Answer { support: "y", note: "`console.time`, `timeLog`, `timeEnd`, `count`, `countReset`, `group` and `groupEnd` work; `console.table` prints its argument as `console.log` does." }
  }
  if id == "constraint-validation" {
    return Answer { support: "n", note: "No form validation API: inputs have no `checkValidity()` or `setCustomValidity()`." }
  }
  if id == "cookie-store-api" {
    return Answer { support: "x", note: "Cookies belong to pages in a browser." }
  }
  if id == "cors" {
    return Answer { support: "x", note: "CORS restricts what pages may fetch from other origins; an app's requests are not under the same-origin policy." }
  }
  if id == "createimagebitmap" {
    return Answer { support: "n", note: "No `createImageBitmap`." }
  }
  if id == "credential-management" {
    return Answer { support: "n", note: "No `navigator.credentials`." }
  }
  if id == "cryptography" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `crypto.subtle`." }
  }
  if id == "css-supports-api" {
    return Answer { support: "n", note: "No `CSS.supports()`. The [Can I use](/can-i-use/) page lists what stylesheets support." }
  }
  if id == "customevent" {
    return Answer { support: "y", note: "`CustomEvent`, `Event` and `EventTarget` work, and nodes take listeners for event types of the app's own: `node.dispatchEvent(event)` sends one through the tree with a capture and a bubble phase." }
  }
  if id == "deviceorientation" {
    return Answer { support: "n", note: "No device orientation or motion events." }
  }
  if id == "do-not-track" {
    return Answer { support: "x", note: "A browser privacy setting for websites." }
  }
  if id == "document-currentscript" {
    return Answer { support: "x", note: "There is no document or `<script>` element." }
  }
  if id == "document-evaluate-xpath" {
    return Answer { support: "x", note: "XPath queries a document; a Silk UI app has a tree of nodes, not a document." }
  }
  if id == "document-execcommand" {
    return Answer { support: "x", note: "A deprecated API for editable documents. Rich inputs have `format()` and `toggleMark()` for the same job." }
  }
  if id == "dom-range" {
    return Answer { support: "n", note: "No `Range`. Inputs report their selection as `selectionStart` and `selectionEnd`." }
  }
  if id == "element-scroll-methods" {
    return Answer { support: "a", note: "`node.scrollTo(x, y)` and `node.scroll(x, y)` work. `scrollBy()` and the options form (`behavior: \"smooth\"`) are missing; `scroll-behavior: smooth` in a stylesheet makes the scroll smooth." }
  }
  if id == "eme" {
    return Answer { support: "n", note: "No media playback, so no encrypted media either." }
  }
  if id == "eventsource" {
    return Answer { support: "n", note: "No `EventSource` in either runtime; with `App.runtime(Runtime.node())`, read the stream with `fetch`." }
  }
  if id == "feature-policy" {
    return Answer { support: "x", note: "A header for pages and their frames." }
  }
  if id == "fetch" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `fetch`." }
  }
  if id == "fileapi" {
    return Answer { support: "a", note: "Files dropped on a window arrive as `File`-like objects with a `name` and a `path`, but the default runtime has no `File` or `Blob` to read them. `App.runtime(Runtime.node())` has `File`, `Blob` and `node:fs`." }
  }
  if id == "filereader" {
    return Answer { support: "n", note: "No `FileReader` in either runtime. With `App.runtime(Runtime.node())`, read a `Blob` with `text()` or `arrayBuffer()`." }
  }
  if id == "filereadersync" {
    return Answer { support: "n", note: "No workers, and no `FileReaderSync`." }
  }
  if id == "filesystem" {
    return Answer { support: "x", note: "A deprecated sandboxed file system for pages. With `App.runtime(Runtime.node())`, use `node:fs`." }
  }
  if id == "gamepad" {
    return Answer { support: "n", note: "No Gamepad API." }
  }
  if id == "geolocation" {
    return Answer { support: "n", note: "No `navigator.geolocation`." }
  }
  if id == "getboundingclientrect" {
    return Answer { support: "n", note: "Layout cannot be read synchronously. A node's `layout` event reports its box (`event.bounds`) after each layout that changes it." }
  }
  if id == "getrandomvalues" {
    return Answer { support: "y", note: "`crypto.getRandomValues` and `crypto.randomUUID` take their bits from the operating system. `crypto.subtle` is there only with `App.runtime(Runtime.node())`." }
  }
  if id == "gyroscope" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "hardwareconcurrency" {
    return Answer { support: "y", note: "" }
  }
  if id == "hashchange" {
    return Answer { support: "x", note: "About the address of a page. `@silkui/foldkit` keeps an address in memory for its router." }
  }
  if id == "high-resolution-time" {
    return Answer { support: "y", note: "`performance.now()` runs on the host's clock, and `performance.timeOrigin` is the wall-clock time it counts from." }
  }
  if id == "imagecapture" {
    return Answer { support: "n", note: "No camera access." }
  }
  if id == "ime" {
    return Answer { support: "n", note: "IME composition works in inputs, but there is no API to read or steer the IME from script." }
  }
  if id == "indexeddb" {
    return Answer { support: "n", note: "No IndexedDB in either runtime. With `App.runtime(Runtime.node())`, keep data in files with `node:fs`." }
  }
  if id == "indexeddb2" {
    return Answer { support: "n", note: "No IndexedDB in either runtime." }
  }
  if id == "input-file-directory" {
    return Answer { support: "n", note: "No file or directory picker yet; files can be dropped on a window." }
  }
  if id == "input-selection" {
    return Answer { support: "y", note: "" }
  }
  if id == "insertadjacenthtml" {
    return Answer { support: "x", note: "Silk UI has no HTML. Nodes are made with `createBox` and `createText`, or by a framework." }
  }
  if id == "intersectionobserver" {
    return Answer { support: "n", note: "No `IntersectionObserver`." }
  }
  if id == "intersectionobserver-v2" {
    return Answer { support: "n", note: "No `IntersectionObserver`." }
  }
  if id == "magnetometer" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "matchesselector" {
    return Answer { support: "n", note: "Nodes have no `matches()` or `closest()`. (`@silkui/foldkit`'s elements have `closest` and `querySelector`.)" }
  }
  if id == "matchmedia" {
    return Answer { support: "y", note: "`matchMedia` answers any media query for the window, including `resolution`, the viewport size and the host's appearance and motion preferences. Lists with a `change` listener or `onchange` hear when the answer flips, for example when the window moves to a display of another scale. Apps on `Runtime.node()` do not have it yet." }
  }
  if id == "maxlength" {
    return Answer { support: "n", note: "Inputs have no length limit attribute; cut the value in an `input` listener." }
  }
  if id == "mediacapture-fromelement" {
    return Answer { support: "n", note: "No media capture." }
  }
  if id == "mediarecorder" {
    return Answer { support: "n", note: "No media capture or recording." }
  }
  if id == "mediasource" {
    return Answer { support: "n", note: "No media playback." }
  }
  if id == "midi" {
    return Answer { support: "n", note: "No Web MIDI." }
  }
  if id == "mutationobserver" {
    return Answer { support: "n", note: "No `MutationObserver`. The app makes every change to its nodes itself." }
  }
  if id == "namevalue-storage" {
    return Answer { support: "n", note: "No `localStorage` or `sessionStorage` in either runtime. With `App.runtime(Runtime.node())`, keep data in a file with `node:fs`." }
  }
  if id == "native-filesystem-api" {
    return Answer { support: "n", note: "No file pickers. With `App.runtime(Runtime.node())`, `node:fs` reads and writes any file the app may." }
  }
  if id == "nav-timing" {
    return Answer { support: "x", note: "Times the loading of a page." }
  }
  if id == "netinfo" {
    return Answer { support: "n", note: "No `navigator.connection`." }
  }
  if id == "notifications" {
    return Answer { support: "a", note: "Importing `@silkui/core` gives `Notification`: `new Notification(title, { body })` shows a desktop notification, with `click` and `show` events. Permission is always granted; `close()`, icons and actions do nothing." }
  }
  if id == "objectrtc" {
    return Answer { support: "n", note: "No real-time communication APIs." }
  }
  if id == "online-status" {
    return Answer { support: "n", note: "No `navigator.onLine` or `online` and `offline` events." }
  }
  if id == "orientation-sensor" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "page-transition-events" {
    return Answer { support: "x", note: "About pages entering and leaving a browser's history." }
  }
  if id == "pagevisibility" {
    return Answer { support: "n", note: "Script cannot ask whether the window is visible or minimized." }
  }
  if id == "passkeys" {
    return Answer { support: "n", note: "No WebAuthn or passkeys." }
  }
  if id == "payment-request" {
    return Answer { support: "x", note: "Browser checkout for shopping pages." }
  }
  if id == "permissions-api" {
    return Answer { support: "n", note: "No `navigator.permissions`." }
  }
  if id == "permissions-policy" {
    return Answer { support: "x", note: "A header for pages and their frames." }
  }
  if id == "picture-in-picture" {
    return Answer { support: "n", note: "No picture-in-picture windows." }
  }
  if id == "pointerlock" {
    return Answer { support: "n", note: "No pointer lock." }
  }
  if id == "portals" {
    return Answer { support: "x", note: "Embeds and navigates between pages." }
  }
  if id == "proximity" {
    return Answer { support: "n", note: "No device sensor APIs." }
  }
  if id == "push-api" {
    return Answer { support: "x", note: "Server pushes to a page's service worker. An app can hold its own connection, with `WebSocket` under `App.runtime(Runtime.node())`." }
  }
  if id == "requestanimationframe" {
    return Answer { support: "y", note: "Callbacks run before the window's frames, with the frame time." }
  }
  if id == "requestidlecallback" {
    return Answer { support: "y", note: "`requestIdleCallback` runs the callback from a timer, with a 50 ms `timeRemaining()` budget; the `timeout` option changes nothing, since the callback never waits longer than a timer." }
  }
  if id == "resizeobserver" {
    return Answer { support: "n", note: "No `ResizeObserver`. A node's `layout` event reports its box (`event.bounds`) after each layout that changes it." }
  }
  if id == "resource-timing" {
    return Answer { support: "x", note: "Times the resources a page loads." }
  }
  if id == "rtcpeerconnection" {
    return Answer { support: "n", note: "No WebRTC." }
  }
  if id == "screen-orientation" {
    return Answer { support: "n", note: "No `screen.orientation`." }
  }
  if id == "scrollintoview" {
    return Answer { support: "n", note: "No `scrollIntoView()`; scroll the container with `scrollTo(x, y)`." }
  }
  if id == "scrollintoviewifneeded" {
    return Answer { support: "n", note: "No `scrollIntoViewIfNeeded()`." }
  }
  if id == "selection-api" {
    return Answer { support: "n", note: "No `getSelection()` over the app's text. Inputs have their own selection." }
  }
  if id == "server-timing" {
    return Answer { support: "x", note: "Reports server timings of a page's requests to its devtools." }
  }
  if id == "serviceworkers" {
    return Answer { support: "x", note: "Service workers make pages work offline; an app is offline already." }
  }
  if id == "setimmediate" {
    return Answer { support: "y", note: "" }
  }
  if id == "sharedworkers" {
    return Answer { support: "x", note: "Shared workers share one worker between pages." }
  }
  if id == "speech-recognition" {
    return Answer { support: "n", note: "No speech recognition." }
  }
  if id == "speech-synthesis" {
    return Answer { support: "n", note: "No speech synthesis. To have a screen reader speak, use `announce()` from `@silkui/core`." }
  }
  if id == "sql-storage" {
    return Answer { support: "x", note: "Web SQL is deprecated and gone from browsers." }
  }
  if id == "stream" {
    return Answer { support: "n", note: "No camera or microphone access." }
  }
  if id == "streams" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `ReadableStream`, `WritableStream` or `TransformStream`." }
  }
  if id == "textencoder" {
    return Answer { support: "y", note: "`TextDecoder` reads UTF-8, UTF-16 and windows-1252 (`latin1`); other labels throw a `RangeError`." }
  }
  if id == "touch" {
    return Answer { support: "n", note: "There are no touch events: fingers arrive as pointer events of type `touch`." }
  }
  if id == "trusted-types" {
    return Answer { support: "x", note: "Guards HTML injection into a document; Silk UI has no HTML." }
  }
  if id == "u2f" {
    return Answer { support: "x", note: "A deprecated API, replaced by WebAuthn." }
  }
  if id == "url" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `URL`." }
  }
  if id == "urlsearchparams" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `URLSearchParams`." }
  }
  if id == "user-timing" {
    return Answer { support: "y", note: "`performance.mark`, `measure`, `getEntries`, `getEntriesByName`, `getEntriesByType`, `clearMarks` and `clearMeasures` work. The default runtime has no `PerformanceObserver`." }
  }
  if id == "vibration" {
    return Answer { support: "n", note: "No `navigator.vibrate`." }
  }
  if id == "wake-lock" {
    return Answer { support: "n", note: "No screen wake lock." }
  }
  if id == "web-animation" {
    return Answer { support: "n", note: "No `element.animate()`. CSS transitions and `@keyframes` animations work through styles." }
  }
  if id == "web-bluetooth" {
    return Answer { support: "n", note: "No Bluetooth access." }
  }
  if id == "web-serial" {
    return Answer { support: "n", note: "No serial port access." }
  }
  if id == "web-share" {
    return Answer { support: "n", note: "No `navigator.share`." }
  }
  if id == "webcodecs" {
    return Answer { support: "n", note: "No WebCodecs." }
  }
  if id == "webgpu" {
    return Answer { support: "n", note: "No WebGPU." }
  }
  if id == "webhid" {
    return Answer { support: "n", note: "No HID device access." }
  }
  if id == "webnfc" {
    return Answer { support: "n", note: "No NFC access." }
  }
  if id == "websockets" {
    return Answer { support: "a", note: "Only with `App.runtime(Runtime.node())`, the full SilkJS runtime; the default engine runtime has no `WebSocket`." }
  }
  if id == "webtransport" {
    return Answer { support: "n", note: "No WebTransport." }
  }
  if id == "webusb" {
    return Answer { support: "n", note: "No USB access." }
  }
  if id == "webvr" {
    return Answer { support: "x", note: "Replaced by WebXR and gone from browsers." }
  }
  if id == "webworkers" {
    return Answer { support: "n", note: "No `Worker` in either runtime: an app's JavaScript runs on the UI thread." }
  }
  if id == "webxr" {
    return Answer { support: "n", note: "No WebXR." }
  }
  if id == "x-doc-messaging" {
    return Answer { support: "x", note: "`postMessage` between pages and frames; an app has one realm." }
  }
  if id == "xhr2" {
    return Answer { support: "n", note: "No `XMLHttpRequest` in either runtime; `fetch` works with `App.runtime(Runtime.node())`." }
  }
  if id == "xml-serializer" {
    return Answer { support: "x", note: "Parses and serializes HTML and XML documents; Silk UI has no document." }
  }
  if id == "silkui-memory-usage" {
    return Answer { support: "y", note: "`memoryUsage()` returns `{ footprint, processes }` in bytes: `phys_footprint` on macOS, `Pss` on Linux, `PrivateUsage` on Windows, the numbers Activity Monitor, `footprint` and Task Manager show. In a browser build it is only the wasm tree's memory." }
  }
  if id == "silkui-frame-stats" {
    return Answer { support: "y", note: "`frameStats()` returns the frames the window presented since the last call, with presents per second, painted frames the GPU never drew, and the 50th, 95th and 99th percentile and longest milliseconds between presents. `null` in a browser build." }
  }
  return Answer { support: "u", note: "" }
}
