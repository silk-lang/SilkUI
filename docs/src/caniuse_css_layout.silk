//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-layout.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "css-anchor-positioning" {
    return Answer { support: "a", note: "`anchor-name`, `position-anchor`, `anchor()` in the insets (also in `calc(anchor(...) ± px)`), `position-area`, `anchor-size()` as `width` or `height`, and the `flip-block` and `flip-inline` fallbacks of `position-try-fallbacks` work. Missing: `@position-try` rules, `position-try-order`, `position-visibility`, `anchor-scope`, `anchor-center`, the `anchor()` fallback, `anchor-size()` inside `calc()` or in margins and min/max sizes, and the `position-try` shorthand. An element only uses its first anchor name. For popups, the Silk tree API also has `Tree.anchor`." }
  }
  if id == "css-boxdecorationbreak" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries-style" {
    return Answer { support: "a", note: "`@container style(--x: value)` and `style(--x)` match against the nearest container's custom properties, with `not`/`and`/`or`, and a container name picks a named ancestor. Missing: one query that mixes `style()` with size features, and style queries on standard properties (custom properties only)." }
  }
  if id == "css-container-query-units" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-containment" {
    return Answer { support: "a", note: "`size`, `inline-size`, `paint`, `strict` and `content` work (`layout` and `style` are accepted and change nothing). A paint-contained box clips its contents and makes a stacking context, but it is not the containing block of absolutely positioned descendants: give it `position: relative` so they are clipped too." }
  }
  if id == "css-content-visibility" {
    return Answer { support: "a", note: "`hidden` works: the box keeps its own size and paint, and its contents are skipped as with `display: none`. `auto` draws everything, as `visible` does, and skips no work off screen." }
  }
  if id == "css-deviceadaptation" {
    return Answer { support: "x", note: "`@viewport` resized a web page's viewport on phones. An app's window is its viewport." }
  }
  if id == "css-display-contents" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-exclusions" {
    return Answer { support: "n", note: "`wrap-flow` and `wrap-through` are not read; only floats push text aside." }
  }
  if id == "css-fixed" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid-lanes" {
    return Answer { support: "n", note: "Neither `display: grid-lanes` nor `grid-template-rows: masonry` is read; the grid places items in plain rows." }
  }
  if id == "css-logical-props" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-overflow" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-overflow-anchor" {
    return Answer { support: "n", note: "`overflow-anchor` is parsed but nothing anchors scrolling, so content inserted above the visible part of a scroll box pushes what is shown down. Virtual lists keep their own scroll anchor." }
  }
  if id == "css-overflow-overlay" {
    return Answer { support: "y", note: "`overlay` computes to `auto`, as in browsers." }
  }
  if id == "css-overscroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-page-break" {
    return Answer { support: "x", note: "`page-break-*` breaks printed pages. An app is not paginated." }
  }
  if id == "css-regions" {
    return Answer { support: "n", note: "`flow-into` and `flow-from` are not read. No browser ships CSS Regions any more." }
  }
  if id == "css-scroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-scrollbar" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-shapes" {
    return Answer { support: "a", note: "`shape-outside` with `circle()`, `ellipse()`, `inset()`, `polygon()` or a box, and `shape-margin`, wrap lines around a float's shape. Images and gradients are not read, so `shape-image-threshold` does nothing." }
  }
  if id == "css-snappoints" {
    return Answer { support: "a", note: "Snap containers settle on the nearest `scroll-snap-align` area (with `scroll-margin` and `scroll-padding`) after a user scroll stops, script scrolls land on one, and mandatory containers stay on one through layout. `scroll-snap-stop` is ignored, and a fling is not aimed at the snap position it would reach." }
  }
  if id == "css-sticky" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-subgrid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-table" {
    return Answer { support: "a", note: "Rows, row and column groups, captions, `border-spacing`, `border-collapse`, `table-layout: fixed`, `vertical-align` in cells and `colspan`, `rowspan` and `span` attributes all work. Percentage widths on cells and columns count as `auto`, `empty-cells` and `visibility: collapse` are ignored, collapsed borders overlap instead of resolving conflicts, and tables do not split across pages." }
  }
  if id == "css3-boxsizing" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox-gap" {
    return Answer { support: "y", note: "" }
  }
  if id == "flow-root" {
    return Answer { support: "y", note: "" }
  }
  if id == "fullscreen" {
    return Answer { support: "n", note: "There is no `requestFullscreen()` and no `:fullscreen` selector." }
  }
  if id == "inline-block" {
    return Answer { support: "y", note: "" }
  }
  if id == "intrinsic-width" {
    return Answer { support: "y", note: "" }
  }
  if id == "justify-content-space-evenly" {
    return Answer { support: "y", note: "" }
  }
  if id == "minmaxwh" {
    return Answer { support: "y", note: "" }
  }
  if id == "multicolumn" {
    return Answer { support: "a", note: "`columns`, `column-count`, `column-width`, `column-gap`, `column-rule`, `column-fill` and `column-span: all` work, with balanced columns and `break-before`/`break-after: column`. A multicol container inside another one, or inside printed pages, keeps one column, `column-span` works only on a container's direct children, and vertical writing modes do not split into columns yet." }
  }
  if id == "run-in" {
    return Answer { support: "n", note: "`display: run-in` is ignored. No browser ships it." }
  }
  if id == "viewport-unit-variants" {
    return Answer { support: "y", note: "" }
  }
  if id == "viewport-units" {
    return Answer { support: "y", note: "" }
  }
  return Answer { support: "u", note: "" }
}
