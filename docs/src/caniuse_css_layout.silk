//! Written by docs/caniuse/sync.py from docs/caniuse; edit the files there, not this.
//! The answers of docs/caniuse/support/css-layout.json.
import caniuse_data { Answer }

pub fn answer(id: string) -> Answer {
  if id == "css-anchor-positioning" {
    return Answer { support: "n", note: "`anchor-name`, `position-anchor`, `anchor()` and `position-area` are not read. For popups, the Silk tree API has `Tree.anchor`, which places a popup next to a target node and follows scrolling." }
  }
  if id == "css-boxdecorationbreak" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-container-queries-style" {
    return Answer { support: "n", note: "Size queries work, `style()` queries never match." }
  }
  if id == "css-container-query-units" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-containment" {
    return Answer { support: "a", note: "`size`, `inline-size`, `paint`, `strict` and `content` work (`layout` and `style` are accepted and change nothing). A paint-contained box clips its contents and makes a stacking context, but it is not the containing block of absolutely positioned descendants: give it `position: relative` so they are clipped too." }
  }
  if id == "css-content-visibility" {
    return Answer { support: "a", note: "`hidden` works: the box keeps its own size and paint, and its contents are skipped as with `display: none`. `auto` draws everything, as `visible` does, and skips no work off screen." }
  }
  if id == "css-deviceadaptation" {
    return Answer { support: "x", note: "`@viewport` resized a web page's viewport on phones. An app's window is its viewport." }
  }
  if id == "css-display-contents" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-exclusions" {
    return Answer { support: "n", note: "`wrap-flow` and `wrap-through` are not read; only floats push text aside." }
  }
  if id == "css-fixed" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-grid-lanes" {
    return Answer { support: "n", note: "Neither `display: grid-lanes` nor `grid-template-rows: masonry` is read; the grid places items in plain rows." }
  }
  if id == "css-logical-props" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-overflow" {
    return Answer { support: "a", note: "`overflow`, `overflow-x` and `overflow-y` work with one keyword each, `clip` included. The two-value shorthand, such as `overflow: hidden auto`, is ignored; set `overflow-x` and `overflow-y` instead." }
  }
  if id == "css-overflow-anchor" {
    return Answer { support: "n", note: "`overflow-anchor` is parsed but nothing anchors scrolling, so content inserted above the visible part of a scroll box pushes what is shown down. Virtual lists keep their own scroll anchor." }
  }
  if id == "css-overflow-overlay" {
    return Answer { support: "n", note: "The `overlay` keyword is ignored, so the box stays `visible`. Use `overflow: auto`." }
  }
  if id == "css-overscroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-page-break" {
    return Answer { support: "x", note: "`page-break-*` breaks printed pages. An app is not paginated." }
  }
  if id == "css-regions" {
    return Answer { support: "n", note: "`flow-into` and `flow-from` are not read. No browser ships CSS Regions any more." }
  }
  if id == "css-scroll-behavior" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-scrollbar" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-shapes" {
    return Answer { support: "n", note: "`shape-outside` is parsed but text flows around a float's box, not its shape." }
  }
  if id == "css-snappoints" {
    return Answer { support: "n", note: "`scroll-snap-type` and `scroll-snap-align` are parsed but scrolling never snaps." }
  }
  if id == "css-sticky" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-subgrid" {
    return Answer { support: "y", note: "" }
  }
  if id == "css-table" {
    return Answer { support: "n", note: "`display: table` and the `table-*` values are ignored, so the box keeps its other `display`. Use grid for tables." }
  }
  if id == "css3-boxsizing" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox" {
    return Answer { support: "y", note: "" }
  }
  if id == "flexbox-gap" {
    return Answer { support: "y", note: "" }
  }
  if id == "flow-root" {
    return Answer { support: "y", note: "" }
  }
  if id == "fullscreen" {
    return Answer { support: "n", note: "There is no `requestFullscreen()` and no `:fullscreen` selector." }
  }
  if id == "inline-block" {
    return Answer { support: "y", note: "" }
  }
  if id == "intrinsic-width" {
    return Answer { support: "y", note: "" }
  }
  if id == "justify-content-space-evenly" {
    return Answer { support: "y", note: "" }
  }
  if id == "minmaxwh" {
    return Answer { support: "y", note: "" }
  }
  if id == "multicolumn" {
    return Answer { support: "n", note: "`columns`, `column-count`, `column-width` and `column-rule` are ignored; the text stays in one column." }
  }
  if id == "run-in" {
    return Answer { support: "n", note: "`display: run-in` is ignored. No browser ships it." }
  }
  if id == "viewport-unit-variants" {
    return Answer { support: "y", note: "" }
  }
  if id == "viewport-units" {
    return Answer { support: "y", note: "" }
  }
  return Answer { support: "u", note: "" }
}
