//! Where sound comes from. The native app provides the machine's microphone and files;
//! a test can provide samples from memory.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Every source delivers mono f32 samples in [-1, 1] at `SAMPLE_RATE`.
pub const SAMPLE_RATE: f32 = 44100.0

pub service Sound {
  /// Starts capturing the default microphone. Whether it started.
  effect fn startMic() -> bool ! OutOfMemoryError ? &mut Sound | &mut Allocator

  /// Stops capturing.
  effect fn stopMic() -> () ! OutOfMemoryError ? &mut Sound | &mut Allocator

  /// The samples captured since the last call (possibly none). Never blocks.
  effect fn readMic() -> List<f32> ! OutOfMemoryError ? &mut Sound | &mut Allocator

  /// The samples of the WAV file at `path`, resampled/mixed to mono at SAMPLE_RATE;
  /// empty when it cannot be read.
  effect fn loadWav(path: string) -> List<f32> ! OutOfMemoryError ? &mut Sound | &mut Allocator

  /// Writes `samples` (mono, SAMPLE_RATE) to `path` as a 16-bit PCM WAV file. Whether it was written.
  effect fn saveWav(path: string, samples: &[f32]) -> bool ! OutOfMemoryError ? &mut Sound | &mut Allocator
}
