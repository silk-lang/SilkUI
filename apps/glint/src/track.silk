//! A recording and its column-by-column analysis: spectrum bytes, level, peak, pitch and
//! formants. Column c covers samples [c*HOP, c*HOP+FFT_SIZE).
import dsp
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u8
import silk.num.usize

/// Samples between consecutive columns.
pub const HOP: usize = 512
/// Columns kept before `trimFront` starts dropping the oldest.
pub const MAX_COLUMNS: usize = 6000

const SAMPLE_RATE: f32 = 44100.0

/// One recording and its analysis, column c covers samples [c*HOP, c*HOP+FFT_SIZE).
pub struct Track {
  pub samples: List<f32>,
  pub spec: List<u8>,
  pub levels: List<f32>,
  pub peaks: List<f32>,
  pub pitches: List<f32>,
  pub f1s: List<f32>,
  pub f2s: List<f32>,
  pub f3s: List<f32>,
}

/// Analysis settings.
pub struct Settings {
  /// 0..1, as voice tools show it; the YIN threshold is (1 - clarity) * 0.3, so 50% is 0.15.
  pub clarity: f32,
  /// Voicing gate: no pitch below this level (dB).
  pub minDb: f32,
  pub fMin: f32,
  pub fMax: f32,
}

/// Reusable buffers for the analysis.
pub struct Scratch {
  pub frame: List<f32>,
  pub windowed: List<f32>,
  pub re: List<f32>,
  pub im: List<f32>,
  pub db: List<f32>,
  pub yin: List<f32>,
  pub formants: List<f32>,
}

fn minU(a: usize, b: usize) -> usize {
  if a < b {
    return a
  }
  return b
}

effect fn zeros(count: usize) -> List<f32> ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<f32>.make()
  let mut i: usize = 0
  while i < count {
    run list.append(0.0)
    i = i + 1
  }
  return move list
}

/// Appends `src[a..b)` to `dst`.
effect fn appendRangeF32(dst: &mut List<f32>, src: &List<f32>, a: usize, b: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut i = a
  while i < b {
    run dst.append(src.get(i))
    i = i + 1
  }
}

effect fn appendRangeU8(dst: &mut List<u8>, src: &List<u8>, a: usize, b: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut i = a
  while i < b {
    run dst.append(src.get(i))
    i = i + 1
  }
}

/// Removes the first `count` items.
fn dropFrontF32(list: &mut List<f32>, count: usize) -> () {
  let n = list.length()
  let k = minU(count, n)
  let mut i = k
  while i < n {
    let moved = list.get(i)
    list.set(i - k, moved)
    i = i + 1
  }
  list.truncate(n - k)
}

fn dropFrontU8(list: &mut List<u8>, count: usize) -> () {
  let n = list.length()
  let k = minU(count, n)
  let mut i = k
  while i < n {
    let moved = list.get(i)
    list.set(i - k, moved)
    i = i + 1
  }
  list.truncate(n - k)
}

impl Scratch {
  pub effect fn make() -> Scratch ! OutOfMemoryError ? &mut Allocator {
    return Scratch {
      frame: run zeros(dsp.FFT_SIZE),
      windowed: run zeros(dsp.FFT_SIZE),
      re: run zeros(dsp.FFT_SIZE),
      im: run zeros(dsp.FFT_SIZE),
      db: run zeros(dsp.BINS),
      yin: run zeros(dsp.FFT_SIZE / 2),
      formants: run zeros(4),
    }
  }
}

impl Track {
  pub effect fn make() -> Track ! OutOfMemoryError ? &mut Allocator {
    return Track {
      samples: List<f32>.make(),
      spec: List<u8>.make(),
      levels: List<f32>.make(),
      peaks: List<f32>.make(),
      pitches: List<f32>.make(),
      f1s: List<f32>.make(),
      f2s: List<f32>.make(),
      f3s: List<f32>.make(),
    }
  }

  pub fn columns(self: &Self) -> usize {
    return self.levels.length()
  }

  pub effect fn copy(self: &Self) -> Track ! OutOfMemoryError ? &mut Allocator {
    return run self.segment(0, self.columns())
  }

  /// Columns [a,b) and samples [a*HOP, min(b*HOP, len)).
  pub effect fn segment(self: &Self, a: usize, b: usize) -> Track ! OutOfMemoryError ? &mut Allocator {
    let cols = self.columns()
    let hi = minU(b, cols)
    let lo = minU(a, hi)
    let mut out = run Track.make()
    let sLen = self.samples.length()
    let sHi = if b >= cols { sLen } else { minU(hi * HOP, sLen) }
    let sLo = minU(lo * HOP, sHi)
    run appendRangeF32(&mut out.samples, &self.samples, sLo, sHi)
    run appendRangeU8(&mut out.spec, &self.spec, lo * dsp.BINS, hi * dsp.BINS)
    run appendRangeF32(&mut out.levels, &self.levels, lo, hi)
    run appendRangeF32(&mut out.peaks, &self.peaks, lo, hi)
    run appendRangeF32(&mut out.pitches, &self.pitches, lo, hi)
    run appendRangeF32(&mut out.f1s, &self.f1s, lo, hi)
    run appendRangeF32(&mut out.f2s, &self.f2s, lo, hi)
    run appendRangeF32(&mut out.f3s, &self.f3s, lo, hi)
    return move out
  }

  /// Replaces columns [a,b) and samples [a*HOP, min(b*HOP,len)) with `insert`'s, then drops
  /// trailing columns whose frame runs past the samples.
  pub effect fn splice(self: &Self, a: usize, b: usize, insert: &Track) -> Track
  ! OutOfMemoryError
  ? &mut Allocator {
    let cols = self.columns()
    let hi = minU(b, cols)
    let lo = minU(a, hi)
    let sLen = self.samples.length()
    let sHi = minU(hi * HOP, sLen)
    let sLo = minU(lo * HOP, sHi)
    let mut out = run Track.make()
    run appendRangeF32(&mut out.samples, &self.samples, 0, sLo)
    run out.samples.appendSlice(insert.samples.asSlice())
    run appendRangeF32(&mut out.samples, &self.samples, sHi, sLen)

    run appendRangeU8(&mut out.spec, &self.spec, 0, lo * dsp.BINS)
    run out.spec.appendSlice(insert.spec.asSlice())
    run appendRangeU8(&mut out.spec, &self.spec, hi * dsp.BINS, cols * dsp.BINS)

    run appendRangeF32(&mut out.levels, &self.levels, 0, lo)
    run out.levels.appendSlice(insert.levels.asSlice())
    run appendRangeF32(&mut out.levels, &self.levels, hi, cols)
    run appendRangeF32(&mut out.peaks, &self.peaks, 0, lo)
    run out.peaks.appendSlice(insert.peaks.asSlice())
    run appendRangeF32(&mut out.peaks, &self.peaks, hi, cols)
    run appendRangeF32(&mut out.pitches, &self.pitches, 0, lo)
    run out.pitches.appendSlice(insert.pitches.asSlice())
    run appendRangeF32(&mut out.pitches, &self.pitches, hi, cols)
    run appendRangeF32(&mut out.f1s, &self.f1s, 0, lo)
    run out.f1s.appendSlice(insert.f1s.asSlice())
    run appendRangeF32(&mut out.f1s, &self.f1s, hi, cols)
    run appendRangeF32(&mut out.f2s, &self.f2s, 0, lo)
    run out.f2s.appendSlice(insert.f2s.asSlice())
    run appendRangeF32(&mut out.f2s, &self.f2s, hi, cols)
    run appendRangeF32(&mut out.f3s, &self.f3s, 0, lo)
    run out.f3s.appendSlice(insert.f3s.asSlice())
    run appendRangeF32(&mut out.f3s, &self.f3s, hi, cols)

    let total = out.samples.length()
    let mut keep = out.levels.length()
    while keep > 0 && (keep - 1) * HOP + dsp.FFT_SIZE > total {
      keep = keep - 1
    }
    out.truncateColumns(keep)
    return move out
  }

  fn truncateColumns(self: &mut Self, keep: usize) -> () {
    self.spec.truncate(keep * dsp.BINS)
    self.levels.truncate(keep)
    self.peaks.truncate(keep)
    self.pitches.truncate(keep)
    self.f1s.truncate(keep)
    self.f2s.truncate(keep)
    self.f3s.truncate(keep)
  }

  pub effect fn appendSamples(self: &mut Self, samples: &[f32]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.samples.appendSlice(samples)
  }

  /// Analyses up to `budget` new columns (while columns()*HOP+FFT_SIZE <= samples.length());
  /// returns how many.
  pub effect fn analyseMore(self: &mut Self, scratch: &mut Scratch, settings: &Settings, budget: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut done: usize = 0
    while done < budget && self.columns() * HOP + dsp.FFT_SIZE <= self.samples.length() {
      let c = self.columns()
      let mut k: usize = 0
      while k < dsp.BINS {
        run self.spec.append(0)
        k = k + 1
      }
      run self.levels.append(0.0)
      run self.peaks.append(0.0)
      run self.pitches.append(0.0)
      run self.f1s.append(0.0)
      run self.f2s.append(0.0)
      run self.f3s.append(0.0)
      self.analyseColumn(&mut scratch, settings, c)
      done = done + 1
    }
    return done
  }

  /// Re-analyses existing columns [a,b) in place.
  pub effect fn reanalyse(self: &mut Self, scratch: &mut Scratch, settings: &Settings, a: usize, b: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let hi = minU(b, self.columns())
    let mut c = a
    while c < hi {
      if c * HOP + dsp.FFT_SIZE <= self.samples.length() {
        self.analyseColumn(&mut scratch, settings, c)
      }
      c = c + 1
    }
  }

  /// When columns() > MAX_COLUMNS, drops the oldest `count` columns and their samples; returns
  /// how many were dropped.
  pub effect fn trimFront(self: &mut Self, count: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let cols = self.columns()
    if cols <= MAX_COLUMNS {
      return 0
    }
    let k = minU(count, cols)
    if k == 0 {
      return 0
    }
    dropFrontF32(&mut self.samples, k * HOP)
    dropFrontU8(&mut self.spec, k * dsp.BINS)
    dropFrontF32(&mut self.levels, k)
    dropFrontF32(&mut self.peaks, k)
    dropFrontF32(&mut self.pitches, k)
    dropFrontF32(&mut self.f1s, k)
    dropFrontF32(&mut self.f2s, k)
    dropFrontF32(&mut self.f3s, k)
    return k
  }

  /// Analyses column `c` (whose slots already exist) from the samples.
  fn analyseColumn(self: &mut Self, scratch: &mut Scratch, settings: &Settings, c: usize) -> () {
    let start = c * HOP
    let mut i: usize = 0
    while i < dsp.FFT_SIZE {
      scratch.frame.set(i, self.samples.get(start + i))
      i = i + 1
    }
    let mut peak: f32 = 0.0
    let peakEnd = minU(start + HOP, self.samples.length())
    i = start
    while i < peakEnd {
      peak = f32.max(peak, f32.abs(self.samples.get(i)))
      i = i + 1
    }
    dsp.blackmanNuttall(scratch.frame.asSlice(), scratch.windowed.asMutSlice())
    dsp.spectrumDb(
      scratch.windowed.asSlice(),
      scratch.re.asMutSlice(),
      scratch.im.asMutSlice(),
      scratch.db.asMutSlice(),
    )
    let base = c * dsp.BINS
    let mut k: usize = 0
    while k < dsp.BINS {
      let q = f32.max(0.0, f32.min(240.0, f32.round((scratch.db.get(k) + 120.0) * 2.0)))
      self.spec.set(base + k, f32.toU8(q))
      k = k + 1
    }
    let level = dsp.rmsDb(scratch.frame.asSlice())
    let mut pitch: f32 = 0.0
    if level > settings.minDb {
      pitch = dsp.pitchYin(scratch.frame.asSlice(), SAMPLE_RATE, (1.0 - settings.clarity) * 0.3, scratch.yin.asMutSlice())
    }
    if pitch < settings.fMin || pitch > settings.fMax {
      pitch = 0.0
    }
    let mut f1: f32 = 0.0
    let mut f2: f32 = 0.0
    let mut f3: f32 = 0.0
    if pitch > 0.0 {
      let found = dsp.formants(scratch.frame.asSlice(), SAMPLE_RATE, scratch.formants.asMutSlice())
      if found > 0 {
        f1 = scratch.formants.get(0)
      }
      if found > 1 {
        f2 = scratch.formants.get(1)
      }
      if found > 2 {
        f3 = scratch.formants.get(2)
      }
    }
    self.levels.set(c, level)
    self.peaks.set(c, peak)
    self.pitches.set(c, pitch)
    self.f1s.set(c, f1)
    self.f2s.set(c, f2)
    self.f3s.set(c, f3)
  }
}
