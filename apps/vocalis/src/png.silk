import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.compress.checksum { CompressionChecksum }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.text.string { String }

//! A minimal PNG encoder: 8-bit RGB, no compression (stored deflate blocks), as a data URL.
//! Built for speed over size, since it may run every frame.

/// Largest payload of one stored deflate block.
const STORED_MAX: usize = 65535

fn minU(a: usize, b: usize) -> usize {
  if a < b {
    return a
  }
  return b
}

effect fn put8(out: &mut List<u8>, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(u32.toU8(value & 0xFF))
}

/// Appends `value` big-endian.
effect fn put32(out: &mut List<u8>, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run put8(&mut out, u32.shiftRight(value, 24))
  run put8(&mut out, u32.shiftRight(value, 16))
  run put8(&mut out, u32.shiftRight(value, 8))
  run put8(&mut out, value)
}

/// Appends the CRC-32 of everything from `typeStart` (the chunk type) to the end of `out`.
effect fn putCrc(out: &mut List<u8>, typeStart: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let all = out.asSlice()
  let crc = CompressionChecksum.crc32(Slice.view<u8>(all, typeStart, all.length - typeStart))
  run put32(&mut out, crc)
}

/// The PNG file bytes for `width` x `height` RGB pixels (`rgb` rows top to bottom).
effect fn encode(width: usize, height: usize, rgb: &[u8]) -> List<u8>
  ! OutOfMemoryError
  ? &mut Allocator {
  let stride = width * 3
  let rowLength = stride + 1
  let raw = height * rowLength
  let mut blocks = (raw + STORED_MAX - 1) / STORED_MAX
  if blocks == 0 {
    blocks = 1
  }
  let zlibLength = 2 + blocks * 5 + raw + 4
  let total = 8 + 25 + 12 + zlibLength + 12
  let mut out = run List<u8>.makeWithCapacity(total)

  // Signature.
  run out.appendBytes(b"\x89PNG\r\n\x1a\n")

  // IHDR: width, height, bit depth 8, colour type 2 (RGB), deflate, filter 0, no interlace.
  run put32(&mut out, 13)
  let ihdr = out.length()
  run out.appendBytes(b"IHDR")
  run put32(&mut out, usize.toU32(width))
  run put32(&mut out, usize.toU32(height))
  run put8(&mut out, 8)
  run put8(&mut out, 2)
  run put8(&mut out, 0)
  run put8(&mut out, 0)
  run put8(&mut out, 0)
  run putCrc(&mut out, ihdr)

  // IDAT: zlib header, stored blocks over the scanlines, Adler-32.
  run put32(&mut out, usize.toU32(zlibLength))
  let idat = out.length()
  run out.appendBytes(b"IDAT")
  run put8(&mut out, 0x78)
  run put8(&mut out, 0x01)
  let mut adler: u32 = 1
  let mut left = raw
  let mut row: usize = 0
  let mut column: usize = 0 // 0 = the filter byte, else 1 + offset into the row's pixels
  let mut block: usize = 0
  while block < blocks {
    let n = minU(left, STORED_MAX)
    left = left - n
    let last = block + 1 == blocks
    if last {
      run put8(&mut out, 1)
    } else {
      run put8(&mut out, 0)
    }
    let len = usize.toU32(n)
    run put8(&mut out, len)
    run put8(&mut out, u32.shiftRight(len, 8))
    run put8(&mut out, u32.bitNot(len))
    run put8(&mut out, u32.shiftRight(u32.bitNot(len), 8))
    let start = out.length()
    let mut remaining = n
    while remaining > 0 {
      if column == 0 {
        run put8(&mut out, 0)
        column = 1
        remaining = remaining - 1
      } else {
        let take = minU(remaining, rowLength - column)
        run out.appendBytes(Slice.view<u8>(rgb, row * stride + column - 1, take))
        column = column + take
        remaining = remaining - take
      }
      if column == rowLength {
        row = row + 1
        column = 0
      }
    }
    let all = out.asSlice()
    adler = CompressionChecksum.adler32Update(adler, Slice.view<u8>(all, start, n))
    block = block + 1
  }
  run put32(&mut out, adler)
  run putCrc(&mut out, idat)

  // IEND.
  run put32(&mut out, 0)
  let iend = out.length()
  run out.appendBytes(b"IEND")
  run putCrc(&mut out, iend)
  return move out
}

/// `rgb` holds width*height*3 bytes, rows top to bottom. Returns "data:image/png;base64,...".
pub effect fn dataUrl(width: usize, height: usize, rgb: &[u8]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let png = run encode(width, height, rgb)
  let prefix = b"data:image/png;base64,"
  let encoded = (png.length() + 2) / 3 * 4
  let mut text = run Bytes.zeroed(prefix.length + encoded)
  Slice.copyInto<u8>(text.asMutSlice(), 0, prefix)
  let written = Base64.encodeInto(
    Slice.viewMut<u8>(text.asMutSlice(), prefix.length, encoded),
    png.asSlice(),
  )
  match move written {
    Result<usize, Base64Error>.Success { .. } => {}
    Result<usize, Base64Error>.Failure { error } => {
      drop error
      return String.make()
    }
  }

  // Every byte is ASCII.
  return unsafe String.fromBytesUnchecked(move text)
}
