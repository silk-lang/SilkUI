import silk.num.f32
import silk.num.usize

//! Voice analysis on plain slices: windowing, spectrum, loudness, pitch and formants.
//! Every function is pure; the caller owns (and reuses) every buffer.

/// Samples per analysis frame (and FFT length). A power of two.
pub const FFT_SIZE: usize = 4096

/// Spectrum bins written by `spectrumDb` (half of `FFT_SIZE`).
pub const BINS: usize = 2048

const PI: f32 = 3.14159265358979
const LN2: f32 = 0.693147180559945
const LN10: f32 = 2.30258509299405

/// Order of the linear-prediction model used for formants.
const LPC_ORDER: usize = 14
/// Decimated samples analysed for formants (every 4th input sample).
const LPC_FRAME: usize = 512
/// Points at which the LPC envelope is evaluated.
const ENVELOPE_POINTS: usize = 256

fn minU(a: usize, b: usize) -> usize {
  if a < b {
    return a
  }
  return b
}

/// Natural logarithm; a very negative number for `x <= 0`.
fn ln(x: f32) -> f32 {
  if x <= 0.0 {
    return -1.0e30
  }
  let mut m = x
  let mut e: f32 = 0.0
  while m >= 2.0 {
    m = m * 0.5
    e = e + 1.0
  }
  while m < 1.0 {
    m = m * 2.0
    e = e - 1.0
  }
  // ln(m) = 2 atanh((m - 1) / (m + 1)), with m in [1, 2) so t is in [0, 1/3).
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let series = t * (1.0 + t2 * (1.0 / 3.0 + t2 * (1.0 / 5.0 + t2 * (1.0 / 7.0 + t2 * (1.0 / 9.0 + t2 * (1.0 / 11.0 + t2 / 13.0))))))
  return 2.0 * series + e * LN2
}

fn log10(x: f32) -> f32 {
  return ln(x) / LN10
}

/// Copies `input` into `out` under a Hann window spanning `out.length` samples.
pub fn hann(input: &[f32], out: &mut [f32]) -> () {
  let n = minU(input.length, out.length)
  if n < 2 {
    return ()
  }
  let denom = usize.toF32(n - 1)
  let mut i: usize = 0
  while i < n {
    let w = 0.5 - 0.5 * f32.cos(2.0 * PI * usize.toF32(i) / denom)
    out[i] = input[i] * w
    i = i + 1
  }
}

/// Copies `input` into `out` under a Blackman-Nuttall window (low side lobes: harmonics stand
/// out cleanly against the noise floor). The gain is normalised to the Hann window's, so the
/// dB scale does not move when the window changes.
pub fn blackmanNuttall(input: &[f32], out: &mut [f32]) -> () {
  let n = minU(input.length, out.length)
  if n < 2 {
    return ()
  }
  let denom = usize.toF32(n - 1)
  let mut i: usize = 0
  while i < n {
    let x = 2.0 * PI * usize.toF32(i) / denom
    let w = 0.3635819 - 0.4891775 * f32.cos(x) + 0.1365995 * f32.cos(2.0 * x)
      - 0.0106411 * f32.cos(3.0 * x)
    out[i] = input[i] * w * 1.3752
    i = i + 1
  }
}

/// The magnitude spectrum of `windowed` (FFT_SIZE samples) in dB, into `out[0..BINS]`:
/// 20 log10(|X_k| / (FFT_SIZE / 4) + 1e-9), clamped to [-120, 0]. `re` and `im` are
/// FFT_SIZE-long scratch buffers that hold the complex spectrum afterwards.
pub fn spectrumDb(windowed: &[f32], re: &mut [f32], im: &mut [f32], out: &mut [f32]) -> () {
  let n = FFT_SIZE
  if windowed.length < n || re.length < n || im.length < n {
    return ()
  }
  // Bit-reversed copy.
  let mut i: usize = 0
  while i < n {
    re[i] = windowed[i]
    im[i] = 0.0
    i = i + 1
  }
  let mut j: usize = 0
  i = 0
  while i < n - 1 {
    if i < j {
      let tr = re[i]
      re[i] = re[j]
      re[j] = tr
      let ti = im[i]
      im[i] = im[j]
      im[j] = ti
    }
    let mut m = n / 2
    while m > 0 && j >= m {
      j = j - m
      m = m / 2
    }
    j = j + m
    i = i + 1
  }
  // Butterflies.
  let mut len: usize = 2
  while len <= n {
    let half = len / 2
    let step = -2.0 * PI / usize.toF32(len)
    let mut k: usize = 0
    while k < half {
      let angle = step * usize.toF32(k)
      let wr = f32.cos(angle)
      let wi = f32.sin(angle)
      let mut start: usize = 0
      while start < n {
        let a = start + k
        let b = a + half
        let xr = re[b] * wr - im[b] * wi
        let xi = re[b] * wi + im[b] * wr
        re[b] = re[a] - xr
        im[b] = im[a] - xi
        re[a] = re[a] + xr
        im[a] = im[a] + xi
        start = start + len
      }
      k = k + 1
    }
    len = len * 2
  }
  let scale = usize.toF32(n) / 4.0
  let bins = minU(BINS, out.length)
  let mut b: usize = 0
  while b < bins {
    let magnitude = f32.sqrt(re[b] * re[b] + im[b] * im[b]) / scale
    let db = 20.0 * log10(magnitude + 1.0e-9)
    out[b] = f32.min(0.0, f32.max(-120.0, db))
    b = b + 1
  }
}

/// The RMS level of `frame` in dBFS, never below -100.
pub fn rmsDb(frame: &[f32]) -> f32 {
  if frame.length == 0 {
    return -100.0
  }
  let mut sum: f32 = 0.0
  let mut i: usize = 0
  while i < frame.length {
    sum = sum + frame[i] * frame[i]
    i = i + 1
  }
  let rms = f32.sqrt(sum / usize.toF32(frame.length))
  return f32.max(-100.0, 20.0 * log10(rms + 1.0e-9))
}

/// The fundamental frequency of `frame` in Hz by YIN (threshold 0.12, parabolic
/// interpolation), searched in 50..1400 Hz; 0.0 when unvoiced. `scratch` needs at least
/// sampleRate / 60 + 2 entries (737 at 44.1 kHz); shorter limits the lowest pitch found.
pub fn pitchYin(frame: &[f32], sampleRate: f32, threshold: f32, scratch: &mut [f32]) -> f32 {
  if sampleRate <= 0.0 || frame.length < 64 || scratch.length < 8 {
    return 0.0
  }
  let tauMin = f32.toUsize(f32.floor(sampleRate / 1400.0))
  let mut tauMax = f32.toUsize(f32.ceil(sampleRate / 50.0))
  tauMax = minU(tauMax, frame.length / 2)
  tauMax = minU(tauMax, scratch.length - 2)
  if tauMin < 2 || tauMax <= tauMin + 2 {
    return 0.0
  }
  let window = minU(1024, frame.length - tauMax - 1)
  // Difference function, then cumulative mean normalisation in place.
  scratch[0] = 1.0
  let mut running: f32 = 0.0
  let mut tau: usize = 1
  while tau <= tauMax + 1 {
    let mut d: f32 = 0.0
    let mut i: usize = 0
    while i < window {
      let delta = frame[i] - frame[i + tau]
      d = d + delta * delta
      i = i + 1
    }
    running = running + d
    if running > 0.0 {
      scratch[tau] = d * usize.toF32(tau) / running
    } else {
      scratch[tau] = 1.0
    }
    tau = tau + 1
  }
  // First dip under the threshold, followed down to its minimum.
  let mut found: usize = 0
  tau = tauMin
  while tau <= tauMax {
    if scratch[tau] < threshold {
      while tau + 1 <= tauMax && scratch[tau + 1] < scratch[tau] {
        tau = tau + 1
      }
      found = tau
      break
    }
    tau = tau + 1
  }
  if found == 0 {
    return 0.0
  }
  let s0 = scratch[found - 1]
  let s1 = scratch[found]
  let s2 = scratch[found + 1]
  let denom = s0 + s2 - 2.0 * s1
  let mut shift: f32 = 0.0
  if f32.abs(denom) > 1.0e-12 {
    shift = f32.max(-1.0, f32.min(1.0, (s0 - s2) / (2.0 * denom)))
  }
  let period = usize.toF32(found) + shift
  if period <= 0.0 {
    return 0.0
  }
  return sampleRate / period
}

/// Up to 4 formant frequencies (Hz, ascending) of `frame` into `out`; returns how many.
/// LPC order 14 (autocorrelation + Levinson-Durbin) on the frame decimated by 4,
/// pre-emphasised (0.97) and Hamming-windowed; peaks of 1/|A| between 200 and 5000 Hz.
pub fn formants(frame: &[f32], sampleRate: f32, out: &mut [f32]) -> usize {
  if sampleRate <= 0.0 || out.length == 0 {
    return 0
  }
  let n = minU(frame.length / 4, LPC_FRAME)
  if n < LPC_ORDER * 2 {
    return 0
  }
  let rate = sampleRate / 4.0
  // Decimate (averaging each group of 4 as a crude anti-alias filter).
  let mut x: [f32; 512] = [0.0; 512]
  let mut i: usize = 0
  while i < n {
    let at = i * 4
    x[i] = 0.25 * (frame[at] + frame[at + 1] + frame[at + 2] + frame[at + 3])
    i = i + 1
  }
  // Pre-emphasis (backwards so each step reads the original previous sample).
  i = n - 1
  while i > 0 {
    x[i] = x[i] - 0.97 * x[i - 1]
    i = i - 1
  }
  // Hamming window.
  let denom = usize.toF32(n - 1)
  i = 0
  while i < n {
    x[i] = x[i] * (0.54 - 0.46 * f32.cos(2.0 * PI * usize.toF32(i) / denom))
    i = i + 1
  }
  // Autocorrelation.
  let mut r: [f32; 15] = [0.0; 15]
  let mut lag: usize = 0
  while lag <= LPC_ORDER {
    let mut sum: f32 = 0.0
    i = 0
    while i + lag < n {
      sum = sum + x[i] * x[i + lag]
      i = i + 1
    }
    r[lag] = sum
    lag = lag + 1
  }
  if r[0] <= 1.0e-9 {
    return 0
  }
  r[0] = r[0] * 1.0001
  // Levinson-Durbin.
  let mut a: [f32; 15] = [0.0; 15]
  let mut previous: [f32; 15] = [0.0; 15]
  a[0] = 1.0
  let mut err = r[0]
  let mut order: usize = 1
  while order <= LPC_ORDER {
    let mut acc = r[order]
    let mut j: usize = 1
    while j < order {
      acc = acc + a[j] * r[order - j]
      j = j + 1
    }
    if err <= 1.0e-12 {
      break
    }
    let k = -acc / err
    j = 0
    while j <= LPC_ORDER {
      previous[j] = a[j]
      j = j + 1
    }
    j = 1
    while j < order {
      a[j] = previous[j] + k * previous[order - j]
      j = j + 1
    }
    a[order] = k
    err = err * (1.0 - k * k)
    order = order + 1
  }
  // Envelope 1/|A(e^jw)| from 0 to 5000 Hz.
  let top = f32.min(5000.0, rate * 0.5)
  let mut envelope: [f32; 256] = [0.0; 256]
  let mut p: usize = 0
  while p < ENVELOPE_POINTS {
    let hz = top * usize.toF32(p) / usize.toF32(ENVELOPE_POINTS - 1)
    let w = 2.0 * PI * hz / rate
    let mut re: f32 = 0.0
    let mut im: f32 = 0.0
    let mut k: usize = 0
    while k <= LPC_ORDER {
      let phase = w * usize.toF32(k)
      re = re + a[k] * f32.cos(phase)
      im = im - a[k] * f32.sin(phase)
      k = k + 1
    }
    envelope[p] = 1.0 / f32.sqrt(re * re + im * im + 1.0e-12)
    p = p + 1
  }
  // Local maxima above 200 Hz, refined by parabolic interpolation.
  let limit = minU(4, out.length)
  let spacing = top / usize.toF32(ENVELOPE_POINTS - 1)
  let mut count: usize = 0
  p = 1
  while p + 1 < ENVELOPE_POINTS && count < limit {
    let y0 = envelope[p - 1]
    let y1 = envelope[p]
    let y2 = envelope[p + 1]
    if y1 > y0 && y1 >= y2 {
      let curve = y0 + y2 - 2.0 * y1
      let mut offset: f32 = 0.0
      if f32.abs(curve) > 1.0e-12 {
        offset = f32.max(-0.5, f32.min(0.5, (y0 - y2) / (2.0 * curve)))
      }
      let hz = (usize.toF32(p) + offset) * spacing
      if hz > 200.0 {
        out[count] = hz
        count = count + 1
      }
    }
    p = p + 1
  }
  return count
}

/// The (fractional) MIDI note number of `hz`: 69 + 12 log2(hz / 440); 0.0 for hz <= 0.
pub fn midiOf(hz: f32) -> f32 {
  if hz <= 0.0 {
    return 0.0
  }
  return 69.0 + 12.0 * ln(hz / 440.0) / LN2
}
